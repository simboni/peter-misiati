{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billing-platform",
  "account_id": "dc39d55aacd54d46748d7802b4764948",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "billing-db",
      // Replace with your real D1 database id before deploying (see README).
      // `wrangler d1 create billing-db` prints it. For local dev any value works.
      "database_id": "local-placeholder-id",
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare Browser Rendering — powers the downloadable PDF (/d/<token>/pdf).
  // Optional: if omitted, the app simply hides the "Download PDF" button.
  "browser": {
    "binding": "BROWSER"
  }
}

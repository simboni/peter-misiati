{
  "name": "afya-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Afya Core \u2014 Kenya-compliant hospital management system (HMIS)",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "seed": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/seed.ts && node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/demo-day.ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.6"
  }
}

# The repo-root ignore file uses rooted patterns (/node_modules, /.next/, /out/)
# which do not reach into apps/. Kept local so nothing at the root has to change.
node_modules/
.next/
out/

# Written by apps/riziki-pos/deploy/update.sh on the server, per build, so the
# site can say which commit it is serving. Never committed: a stamp in git
# would describe whoever built it last rather than this deployment.
/public/build.txt

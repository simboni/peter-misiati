# Hostnames for a STANDALONE deployment — a server running nothing else.
#
# On the shared server this file is unused: the routes live in
# deploy/edge/rizikichemicals.caddy and are installed into /srv/edge/sites/.
# See DEPLOY.md.
#
# A domain is not required. Free wildcard DNS (sslip.io) maps any IP to a
# hostname — 203.0.113.7 answers as pos.203-0-113-7.sslip.io — and Caddy
# fetches a genuine Let's Encrypt certificate for it automatically. Put the
# server's real IP below, dots replaced by dashes.

pos.203-0-113-7.sslip.io {
	reverse_proxy pos:3100
	encode zstd gzip
}

203-0-113-7.sslip.io {
	reverse_proxy web:80
}

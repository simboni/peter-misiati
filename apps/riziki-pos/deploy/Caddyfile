# Riziki Industrial Chemicals — the whole public face on one server.
#
# Three sites, three certificates, all fetched and renewed by Caddy on its
# own. The only prerequisite is DNS: A records for rizikichemicals.co.ke,
# www.rizikichemicals.co.ke and pos.rizikichemicals.co.ke, all pointing at
# this server's IP.

# The marketing site. The pages themselves live in the `web` container, built
# from apps/riziki-web on every deploy; this block only terminates HTTPS for it.
rizikichemicals.co.ke {
	reverse_proxy web:80
}

# One canonical host: www redirects rather than serving a duplicate site.
www.rizikichemicals.co.ke {
	redir https://rizikichemicals.co.ke{uri} permanent
}

# The shop system.
pos.rizikichemicals.co.ke {
	reverse_proxy pos:3100
	encode zstd gzip
}

# Visitor measurement for the marketing site. Copy to ../.env and fill in.
#
#   cp deploy/analytics.env.example .env
#
# Compose reads `.env` from the project directory for the ${...} values in
# docker-compose.yml. That file is git-ignored; this example is not, so never
# put a real password or secret in THIS file.
#
# Generate the two secrets on the server, once:
#   openssl rand -hex 24      # for ANALYTICS_DB_PASSWORD
#   openssl rand -hex 32      # for ANALYTICS_APP_SECRET

# PIN THIS to a real published tag before going live. Check the current one at
#   https://github.com/umami-software/umami/releases
# and use the matching postgresql image, e.g. postgresql-v2.x.y. A floating
# tag means an unattended `docker compose pull` can change the software under
# a box that is also serving a live till.
ANALYTICS_IMAGE=ghcr.io/umami-software/umami:postgresql-latest

ANALYTICS_DB_PASSWORD=
ANALYTICS_APP_SECRET=

# Baked into the website at BUILD time, not read at runtime: the site is a
# static export. Leave both blank and the site ships with no tracking at all,
# which is the correct state until the analytics container is actually up and
# a site id has been created in its dashboard.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=

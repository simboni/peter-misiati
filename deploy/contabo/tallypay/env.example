# Copy to /srv/tallypay/.env and fill in. Never commit the real file.
#
# Generate the secret once:   openssl rand -base64 48

# ---- required ----------------------------------------------------------
# Signs session cookies AND derives the AES key that encrypts each vendor's
# stored M-Pesa credentials.
#
# MIGRATING: use the SAME value as the Cloudflare deployment, or every vendor's
# saved Kopo Kopo credentials becomes undecryptable and all sessions drop.
# Read it from the old deployment before you change anything.
BETTER_AUTH_SECRET=

# The canonical public URL. Share links, PDF links and the M-Pesa callback are
# all built from this, so it must be the real https host — not localhost.
BETTER_AUTH_URL=https://tallypay.smp.co.ke

# Comma-separated emails that bootstrap as platform super-admins on login.
OWNER_EMAILS=misiatipeter@gmail.com

# ---- optional: email delivery (Resend) ---------------------------------
# Without these, documents are shared by copy-link / WhatsApp instead.
# RESEND_API_KEY=re_xxx
# RESEND_FROM=TallyPay <billing@smp.co.ke>

# ---- optional: M-Pesa STK push (Kopo Kopo) -----------------------------
# Without these the "Pay with M-Pesa" button is hidden and payments are
# recorded manually. Use the sandbox base URL while testing.
#
# After migrating, re-register the webhook with Kopo Kopo to point at the new
# host:  https://tallypay.smp.co.ke/api/mpesa/kopokopo
# KOPOKOPO_BASE_URL=https://api.kopokopo.com
# KOPOKOPO_CLIENT_ID=
# KOPOKOPO_CLIENT_SECRET=
# KOPOKOPO_API_KEY=
# KOPOKOPO_TILL_NUMBER=

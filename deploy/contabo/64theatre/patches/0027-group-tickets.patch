--- /dev/null
+++ b/database/migrations/2026_10_16_100001_add_group_tickets.php
@@ -0,0 +1,74 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * Group tickets — one purchase that admits several people.
+ *
+ * A group is a TICKET TYPE with `admits > 1`, not a new kind of order. That
+ * choice is what makes this cheap: it inherits the atomic oversell guard, the
+ * sales window, max_per_order, the promo engine, the public stepper, the box
+ * office and every report, and it needs NO change to the payment path at all.
+ *
+ * The roster is one Ticket per member, carrying the existing holder_name.
+ * The alternative — a single ticket admitting N — would need a partial
+ * redemption state machine, would break the UNIQUE(checkins.ticket_id)
+ * constraint that makes admission exactly-once, and would turn "4 of 8 have
+ * arrived" into a bespoke query. N tickets gives all of that for free, and a
+ * blank name still scans.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::table('ticket_types', function (Blueprint $table) {
+            // People admitted per ticket sold. 1 is an ordinary ticket, so
+            // every existing row keeps behaving exactly as it does today.
+            $table->unsignedInteger('admits')->default(1)->after('max_per_order');
+            $table->boolean('collect_member_names')->default(false)->after('admits');
+            $table->string('group_label')->nullable()->after('collect_member_names');
+        });
+
+        Schema::create('ticket_groups', function (Blueprint $table) {
+            $table->id();
+            // Capability URL for the roster page — the same unguessable public
+            // reference pattern orders already use.
+            $table->uuid('uuid')->unique();
+            $table->foreignId('organiser_id')->constrained();
+            $table->foreignId('order_id')->constrained();
+            $table->foreignId('order_item_id')->constrained();
+            $table->foreignId('ticket_type_id')->constrained();
+            $table->foreignId('performance_id')->constrained();
+            $table->string('label')->nullable();            // "Kibabii School, Form 4"
+            // Frozen at issue, deliberately denormalised: changing the ticket
+            // type later must not retro-resize a group already sold.
+            $table->unsignedInteger('size');
+            $table->string('contact_name')->nullable();
+            $table->string('contact_phone')->nullable();
+            $table->timestamp('roster_filled_at')->nullable();
+            $table->timestamps();
+            $table->index(['performance_id']);
+        });
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->foreignId('group_id')->nullable()->after('performance_id')
+                ->constrained('ticket_groups')->nullOnDelete();
+            $table->index(['group_id']);
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropConstrainedForeignId('group_id');
+        });
+
+        Schema::dropIfExists('ticket_groups');
+
+        Schema::table('ticket_types', function (Blueprint $table) {
+            $table->dropColumn(['admits', 'collect_member_names', 'group_label']);
+        });
+    }
+};

+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\TicketGroup;
+use App\Services\GroupRoster;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\View\View;
+
+/**
+ * The page a group organiser fills in after buying.
+ *
+ * Reached by the group's uuid — a capability URL, the same unguessable public
+ * reference the order page uses. No login: the person who books a school trip
+ * is rarely the person with the account, and a password wall here would mean
+ * the names never get entered at all.
+ */
+class GroupRosterController extends Controller
+{
+    public function show(string $uuid): View
+    {
+        $group = $this->find($uuid);
+
+        return view('groups.roster', ['group' => $group]);
+    }
+
+    public function update(Request $request, string $uuid, GroupRoster $roster): RedirectResponse
+    {
+        $group = $this->find($uuid);
+
+        $validated = $request->validate([
+            'label' => ['nullable', 'string', 'max:120'],
+            'names' => ['array'],
+            'names.*' => ['nullable', 'string', 'max:80'],
+        ]);
+
+        if (array_key_exists('label', $validated)) {
+            $group->update(['label' => $validated['label'] ?: null]);
+        }
+
+        $written = $roster->fill($group, $validated['names'] ?? []);
+
+        return redirect()
+            ->route('groups.roster', $group->uuid)
+            ->with('saved', $written === 0
+                ? 'Nothing changed.'
+                : $written.' '.($written === 1 ? 'name' : 'names').' saved.');
+    }
+
+    private function find(string $uuid): TicketGroup
+    {
+        return TicketGroup::where('uuid', $uuid)
+            ->with(['tickets.ticketType', 'performance.event', 'performance.venue', 'order'])
+            ->firstOrFail();
+    }
+}

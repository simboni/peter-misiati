diff --git a/tests/Feature/GroupTicketTest.php b/tests/Feature/GroupTicketTest.php
new file mode 100644
index 0000000..15bed65
--- /dev/null
+++ b/tests/Feature/GroupTicketTest.php
@@ -0,0 +1,243 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Event;
+use App\Models\Order;
+use App\Models\Organiser;
+use App\Models\Payment;
+use App\Models\Performance;
+use App\Models\TicketGroup;
+use App\Models\TicketType;
+use App\Models\Venue;
+use App\Services\Checkout;
+use App\Exceptions\SoldOutException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class GroupTicketTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function performance(): Performance
+    {
+        $organiser = Organiser::create(['name' => 'Test', 'slug' => 'test']);
+        $venue = Venue::create(['organiser_id' => $organiser->id, 'name' => 'Hall', 'town' => 'Eldoret']);
+        // events has no venue_id — the venue hangs off the performance.
+        $event = Event::create([
+            'organiser_id' => $organiser->id,
+            'title' => 'Show', 'slug' => 'show-'.uniqid(),
+            'category' => 'theatre', 'status' => 'published',
+        ]);
+
+        return Performance::create([
+            'event_id' => $event->id, 'venue_id' => $venue->id,
+            'starts_at' => now()->addWeek(), 'status' => 'on_sale',
+        ]);
+    }
+
+    private function settle(Order $order): Order
+    {
+        $payment = Payment::create([
+            'order_id' => $order->id, 'gateway' => 'cash', 'gateway_ref' => 'T-'.uniqid(),
+            'amount_cents' => $order->total_cents, 'status' => 'initiated',
+        ]);
+
+        return app(Checkout::class)->confirm($order, $payment);
+    }
+
+    public function test_a_group_ticket_issues_one_ticket_per_member(): void
+    {
+        $performance = $this->performance();
+        $group = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 8',
+            'price_cents' => 1200000, 'quantity_total' => 5, 'admits' => 8,
+        ]);
+
+        $order = app(Checkout::class)->startOrder(
+            items: [$group->id => 1], phone: '0712345678', name: 'Kibabii School',
+        );
+        $order = $this->settle($order);
+
+        // One unit sold, eight people admitted.
+        $this->assertSame(8, $order->tickets()->count());
+        $this->assertSame(1, TicketGroup::count());
+        $this->assertSame(8, TicketGroup::first()->size);
+
+        // Every seat belongs to the group, so the door sees a party.
+        $this->assertSame(8, $order->tickets()->whereNotNull('group_id')->count());
+
+        // The buyer holds one named seat; the rest wait for the roster, and a
+        // blank name must never block admission.
+        $this->assertSame(1, $order->tickets()->whereNotNull('holder_name')->count());
+        $this->assertSame(7, TicketGroup::first()->unnamed());
+    }
+
+    public function test_an_ordinary_ticket_is_completely_unaffected(): void
+    {
+        $performance = $this->performance();
+        $regular = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Regular',
+            'price_cents' => 50000, 'quantity_total' => 20,
+        ]);
+
+        $order = $this->settle(app(Checkout::class)->startOrder(
+            items: [$regular->id => 3], phone: '0712345678', name: 'Jane',
+        ));
+
+        $this->assertSame(3, $order->tickets()->count());
+        $this->assertSame(0, TicketGroup::count());
+        $this->assertSame(0, $order->tickets()->whereNotNull('group_id')->count());
+        // The default must be 1, or every historic ticket type changes meaning.
+        $this->assertSame(1, (int) $regular->fresh()->admits);
+    }
+
+    public function test_the_oversell_guard_still_counts_units_not_people(): void
+    {
+        $performance = $this->performance();
+        $group = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 8',
+            'price_cents' => 1200000, 'quantity_total' => 2, 'admits' => 8,
+        ]);
+
+        app(Checkout::class)->startOrder(items: [$group->id => 2], phone: '0712345678');
+
+        // The pool is two units. A third must be refused even though only
+        // sixteen people have been seated.
+        $this->expectException(SoldOutException::class);
+        app(Checkout::class)->startOrder(items: [$group->id => 1], phone: '0722222222');
+    }
+
+    public function test_remaining_people_reports_seats_not_units(): void
+    {
+        $performance = $this->performance();
+        $group = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 8',
+            'price_cents' => 1200000, 'quantity_total' => 5, 'admits' => 8,
+        ]);
+
+        $this->assertSame(5, $group->remaining());
+        $this->assertSame(40, $group->remainingPeople());
+        $this->assertTrue($group->isGroup());
+    }
+
+    public function test_two_groups_in_one_order_do_not_merge(): void
+    {
+        $performance = $this->performance();
+        $group = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 4',
+            'price_cents' => 600000, 'quantity_total' => 9, 'admits' => 4,
+        ]);
+
+        $order = $this->settle(app(Checkout::class)->startOrder(
+            items: [$group->id => 2], phone: '0712345678', name: 'Two families',
+        ));
+
+        // Two separate parties, four seats each — not one group of eight.
+        $this->assertSame(2, TicketGroup::count());
+        $this->assertSame(8, $order->tickets()->count());
+        foreach (TicketGroup::all() as $g) {
+            $this->assertSame(4, $g->tickets()->count());
+        }
+    }
+
+    public function test_the_roster_page_opens_and_names_save(): void
+    {
+        $performance = $this->performance();
+        $type = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 4',
+            'price_cents' => 600000, 'quantity_total' => 5, 'admits' => 4,
+        ]);
+
+        $order = $this->settle(app(Checkout::class)->startOrder(
+            items: [$type->id => 1], phone: '0712345678', name: 'Kibabii School',
+        ));
+
+        $group = TicketGroup::first();
+        $this->get('/groups/'.$group->uuid)->assertOk();
+
+        $ids = $group->tickets()->orderBy('id')->pluck('id')->all();
+
+        $this->post('/groups/'.$group->uuid, [
+            'label' => 'Kibabii School, Form 4',
+            'names' => [
+                $ids[0] => 'Mercy Chebet',
+                $ids[1] => 'Brian Kiprop',
+                $ids[2] => '',          // blank is allowed and must still scan
+                $ids[3] => '   ',       // whitespace counts as blank
+            ],
+        ])->assertRedirect();
+
+        $this->assertSame('Kibabii School, Form 4', $group->fresh()->label);
+        $this->assertSame('Mercy Chebet', $group->tickets()->find($ids[0])->holder_name);
+        $this->assertNull($group->tickets()->find($ids[2])->holder_name);
+        $this->assertNull($group->tickets()->find($ids[3])->holder_name);
+        $this->assertNotNull($group->fresh()->roster_filled_at);
+    }
+
+    public function test_a_ticket_already_admitted_cannot_be_renamed(): void
+    {
+        $performance = $this->performance();
+        $type = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 2',
+            'price_cents' => 300000, 'quantity_total' => 5, 'admits' => 2,
+        ]);
+
+        $order = $this->settle(app(Checkout::class)->startOrder(
+            items: [$type->id => 1], phone: '0712345678', name: 'Family',
+        ));
+
+        $group = TicketGroup::first();
+        $used = $group->tickets()->first();
+        $used->update(['status' => 'redeemed', 'holder_name' => 'Already inside']);
+
+        $this->post('/groups/'.$group->uuid, ['names' => [$used->id => 'Someone else']]);
+
+        // Renaming a used ticket reassigns a seat that has been sat in.
+        $this->assertSame('Already inside', $used->fresh()->holder_name);
+    }
+
+    public function test_names_cannot_be_written_onto_another_groups_tickets(): void
+    {
+        $performance = $this->performance();
+        $type = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 2',
+            'price_cents' => 300000, 'quantity_total' => 5, 'admits' => 2,
+        ]);
+
+        $this->settle(app(Checkout::class)->startOrder(items: [$type->id => 1], phone: '0712345678'));
+        $this->settle(app(Checkout::class)->startOrder(items: [$type->id => 1], phone: '0722222222'));
+
+        [$mine, $theirs] = TicketGroup::orderBy('id')->get()->all();
+        $victim = $theirs->tickets()->first();
+
+        $this->post('/groups/'.$mine->uuid, ['names' => [$victim->id => 'Hijacked']]);
+
+        $this->assertNotSame('Hijacked', $victim->fresh()->holder_name);
+    }
+
+    public function test_an_unknown_group_is_a_404_not_a_leak(): void
+    {
+        $this->get('/groups/'.\Illuminate\Support\Str::uuid())->assertNotFound();
+    }
+
+    public function test_headcount_counts_people_across_mixed_items(): void
+    {
+        $performance = $this->performance();
+        $regular = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Regular',
+            'price_cents' => 50000, 'quantity_total' => 20,
+        ]);
+        $group = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 8',
+            'price_cents' => 1200000, 'quantity_total' => 5, 'admits' => 8,
+        ]);
+
+        $order = app(Checkout::class)->startOrder(
+            items: [$regular->id => 2, $group->id => 1], phone: '0712345678',
+        );
+
+        // Two singles plus one group of eight is ten bodies, not three tickets.
+        $this->assertSame(10, $order->fresh()->load('items.ticketType')->headcount());
+    }
+}

index 0000000..392bfce
--- /dev/null
+++ b/app/Services/GroupRoster.php
@@ -0,0 +1,74 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\AuditLog;
+use App\Models\TicketGroup;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Writing the names of a group's members onto their tickets.
+ *
+ * Names arrive AFTER payment, on the roster page, not during checkout. Eight
+ * name fields in a checkout that currently asks for two would cost more sales
+ * than the names are worth, and a school genuinely does not have the list on
+ * the day it books. So a group is sold first and named later, and every ticket
+ * must scan whether or not it has a name on it.
+ */
+class GroupRoster
+{
+    /**
+     * @param  array<int|string, string|null>  $names  ticket id => name
+     * @return int how many were written
+     */
+    public function fill(TicketGroup $group, array $names, ?int $byUserId = null): int
+    {
+        $written = 0;
+
+        DB::transaction(function () use ($group, $names, $byUserId, &$written) {
+            // Only this group's tickets, looked up fresh. A posted id from
+            // another group would otherwise rename somebody else's ticket.
+            $tickets = $group->tickets()->get()->keyBy('id');
+
+            foreach ($names as $ticketId => $name) {
+                $ticket = $tickets->get((int) $ticketId);
+
+                if (! $ticket) {
+                    continue;
+                }
+
+                // A ticket already used is a person already through the door.
+                // Renaming it would reassign a seat that has been sat in, and
+                // is the one edit that can turn a roster into a dispute.
+                if ($ticket->status !== 'issued') {
+                    continue;
+                }
+
+                $clean = trim((string) $name);
+                $clean = $clean === '' ? null : mb_substr($clean, 0, 80);
+
+                if ($ticket->holder_name === $clean) {
+                    continue;
+                }
+
+                $ticket->update(['holder_name' => $clean]);
+                $written++;
+            }
+
+            $group->update(['roster_filled_at' => now()]);
+
+            if ($written > 0) {
+                AuditLog::create([
+                    'user_id' => $byUserId,
+                    'organiser_id' => $group->organiser_id,
+                    'action' => 'group.roster_updated',
+                    'subject_type' => TicketGroup::class,
+                    'subject_id' => $group->id,
+                    'changes' => ['names_written' => $written, 'group_size' => $group->size],
+                ]);
+            }
+        });
+
+        return $written;
+    }
+}

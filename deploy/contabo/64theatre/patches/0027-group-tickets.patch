+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\HasMany;
+
+/**
+ * One group sold: a school party, a family, a company block.
+ *
+ * It owns no money. The price lives on the order and the order item, in one
+ * place, as it does for every other sale — this row exists to hold the roster
+ * and to answer "how many of this group have come in".
+ */
+class TicketGroup extends Model
+{
+    protected $guarded = [];
+
+    protected function casts(): array
+    {
+        return [
+            'roster_filled_at' => 'datetime',
+            'size' => 'integer',
+        ];
+    }
+
+    public function order(): BelongsTo
+    {
+        return $this->belongsTo(Order::class);
+    }
+
+    public function orderItem(): BelongsTo
+    {
+        return $this->belongsTo(OrderItem::class);
+    }
+
+    public function ticketType(): BelongsTo
+    {
+        return $this->belongsTo(TicketType::class);
+    }
+
+    public function performance(): BelongsTo
+    {
+        return $this->belongsTo(Performance::class);
+    }
+
+    public function tickets(): HasMany
+    {
+        return $this->hasMany(Ticket::class, 'group_id');
+    }
+
+    /** How many of the party are already inside. */
+    public function admitted(): int
+    {
+        return $this->tickets()->where('status', 'redeemed')->count();
+    }
+
+    public function remainingToAdmit(): int
+    {
+        return max($this->size - $this->admitted(), 0);
+    }
+
+    /** Names still blank. A blank name is allowed in and is not an error. */
+    public function unnamed(): int
+    {
+        return $this->tickets()->whereNull('holder_name')->count();
+    }
+
+    public function displayLabel(): string
+    {
+        return $this->label ?: ($this->order?->customer?->name ?: 'Group of '.$this->size);
+    }
+}

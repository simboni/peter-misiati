+    public function test_running_the_same_pattern_twice_adds_nothing(): void
+    {
+        [$event, $venue] = $this->bare();
+
+        $a = \App\Support\PerformanceRun::create($event, '2026-10-25', '2026-11-29', [0], '18:00', $venue->id);
+        $this->assertSame(6, $a);
+
+        $b = \App\Support\PerformanceRun::create($event->fresh(), '2026-10-25', '2026-11-29', [0], '18:00', $venue->id);
+        $this->assertSame(0, $b, 'Re-running the same season must not double it.');
+        $this->assertSame(6, $event->performances()->count());
+    }

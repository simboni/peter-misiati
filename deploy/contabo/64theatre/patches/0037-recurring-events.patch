+    public function test_prices_can_only_be_copied_onto_dates_still_to_come(): void
+    {
+        $event = $this->season();
+        $source = $event->performances()->where('starts_at', '>', now())->orderBy('starts_at')->first();
+
+        $options = \App\Support\PerformanceRun::copyTargetOptions($source);
+
+        $this->assertCount(2, $options, 'The other two future Sundays — not the three that have played.');
+        $this->assertArrayNotHasKey($source->id, $options, 'A date is not a target for its own prices.');
+        foreach ($event->performances()->where('starts_at', '<', now())->pluck('id') as $goneId) {
+            $this->assertArrayNotHasKey($goneId, $options);

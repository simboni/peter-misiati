diff --git a/tests/Feature/RecurringSeasonTest.php b/tests/Feature/RecurringSeasonTest.php
new file mode 100644
index 0000000..d3c6de7
--- /dev/null
+++ b/tests/Feature/RecurringSeasonTest.php
@@ -0,0 +1,304 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Event;
+use App\Models\Organiser;
+use App\Models\Performance;
+use App\Models\TicketType;
+use App\Models\Venue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+/**
+ * A season that runs every week — "Hadithi Sunday", Oct 25 to Nov 29.
+ *
+ * The platform already stores this correctly: one event, one performance per
+ * Sunday. What a long run exposes is everything that quietly assumed an event
+ * has ONE date and is over once it passes.
+ */
+class RecurringSeasonTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function season(): Event
+    {
+        $organiser = Organiser::firstOrCreate(['slug' => 'test'], ['name' => 'Test']);
+        $venue = Venue::firstOrCreate(['name' => 'Main Hall'], ['organiser_id' => $organiser->id, 'town' => 'Eldoret', 'capacity' => 200]);
+
+        $event = Event::create([
+            'organiser_id' => $organiser->id,
+            'title' => 'Hadithi Sunday',
+            'slug' => 'hadithi-sunday',
+            'description' => 'Storytelling, every Sunday.',
+            'status' => 'published',
+            'is_private' => false,
+        ]);
+
+        // Three Sundays gone, three still to come.
+        foreach ([-21, -14, -7, 7, 14, 21] as $offset) {
+            $p = Performance::create([
+                'event_id' => $event->id,
+                'venue_id' => $venue->id,
+                'starts_at' => now()->addDays($offset)->setTime(18, 0),
+                'status' => 'on_sale',
+            ]);
+            TicketType::create([
+                'performance_id' => $p->id,
+                'name' => 'Regular',
+                'price_cents' => 50000,
+                'quantity_total' => 100,
+            ]);
+        }
+
+        return $event;
+    }
+
+    public function test_a_finished_date_is_not_still_on_sale(): void
+    {
+        $event = $this->season();
+        $past = $event->performances()->where('starts_at', '<', now())->orderBy('starts_at')->first();
+        $future = $event->performances()->where('starts_at', '>', now())->orderBy('starts_at')->first();
+
+        $html = $this->get("/events/{$event->slug}")->assertOk()->getContent();
+
+        // The upcoming Sunday must be buyable.
+        $this->assertStringContainsString(
+            'phone-'.$future->id,
+            $html,
+            'The next Sunday should have a booking form.',
+        );
+
+        // The ones that have already happened must not be.
+        $this->assertStringNotContainsString(
+            'phone-'.$past->id,
+            $html,
+            'A Sunday that has already happened is still selling tickets.',
+        );
+    }
+
+    public function test_every_remaining_date_is_listed(): void
+    {
+        $event = $this->season();
+        $html = $this->get("/events/{$event->slug}")->assertOk()->getContent();
+
+        foreach ($event->performances()->where('starts_at', '>', now())->get() as $p) {
+            $this->assertStringContainsString('phone-'.$p->id, $html);
+        }
+    }
+
+    public function test_cancelling_one_sunday_takes_that_sunday_off_sale(): void
+    {
+        $event = $this->season();
+        $dates = $event->performances()->where('starts_at', '>', now())->orderBy('starts_at')->get();
+        $off = $dates->first();
+        $on = $dates->last();
+
+        $off->update(['status' => 'cancelled']);
+
+        $html = $this->get("/events/{$event->slug}")->assertOk()->getContent();
+
+        $this->assertStringNotContainsString(
+            'phone-'.$off->id,
+            $html,
+            'A cancelled date is still selling tickets.',
+        );
+        $this->assertStringContainsString('cancelled', $html, 'The cancelled date should be named, not just dropped.');
+        $this->assertStringContainsString(
+            'phone-'.$on->id,
+            $html,
+            'Cancelling one Sunday must not take the rest of the run off sale.',
+        );
+    }
+
+    public function test_a_scheduled_date_still_sells(): void
+    {
+        // 'scheduled' is the default every performance is created with, so it
+        // cannot mean "not on sale" — that would empty the whole site.
+        $event = $this->season();
+        $next = $event->performances()->where('starts_at', '>', now())->orderBy('starts_at')->first();
+        $next->update(['status' => 'scheduled']);
+
+        $this->get("/events/{$event->slug}")
+            ->assertOk()
+            ->assertSee('phone-'.$next->id, false);
+    }

+    /* ------------------- generating the run ------------------- */
+
+    private function bare(): array
+    {
+        $organiser = Organiser::firstOrCreate(['slug' => 'test'], ['name' => 'Test']);
+        $venue = Venue::firstOrCreate(['name' => 'Main Hall'], ['organiser_id' => $organiser->id, 'town' => 'Eldoret', 'capacity' => 200]);
+        $event = Event::create([
+            'organiser_id' => $organiser->id,
+            'title' => 'Hadithi Sunday',
+            'slug' => 'hadithi-sunday-run',
+            'status' => 'published',
+            'is_private' => false,
+        ]);
+
+        return [$event, $venue];
+    }

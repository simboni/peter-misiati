diff --git a/app/Support/PerformanceRun.php b/app/Support/PerformanceRun.php
new file mode 100644
index 0000000..5c925e9
--- /dev/null
+++ b/app/Support/PerformanceRun.php
@@ -0,0 +1,240 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Event;
+use App\Models\Performance;
+use App\Models\TicketType;
+use Carbon\CarbonImmutable;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * A run of dates — "every Sunday from 25 October to 29 November".
+ *
+ * WHY THIS GENERATES ROWS INSTEAD OF STORING A RULE. The obvious design is a
+ * recurrence rule on the event that the rest of the system expands when it
+ * reads. It is also the wrong one here. A performance is what tickets, the
+ * gate scanner, the box office, check-in, refunds, the hero slider and the
+ * share cards all hang off; teaching every one of those to expand a rule
+ * means touching all of them, and any that is missed quietly sells a ticket
+ * to a date that does not exist. Generating concrete performances leaves
+ * every one of those paths exactly as it is, and a date that needs to move or
+ * be cancelled is just a row — which is what an operator wants anyway, since
+ * one Sunday in six is always the one that changes.
+ *
+ * So "recurring" is a convenience for CREATING dates, not a new kind of
+ * thing. The season is an ordinary event with ordinary performances.
+ */
+class PerformanceRun
+{
+    /**
+     * The dates a pattern produces, in order.
+     *
+     * @param  array<int>  $weekdays  0 = Sunday … 6 = Saturday (Carbon's own numbering)
+     * @return Collection<int, CarbonImmutable>
+     */
+    public static function dates(
+        string $from,
+        string $until,
+        array $weekdays,
+        string $time,
+    ): Collection {
+        $out = collect();
+        if ($weekdays === []) {
+            return $out;
+        }
+
+        $start = CarbonImmutable::parse($from)->startOfDay();
+        $end = CarbonImmutable::parse($until)->endOfDay();
+        if ($end->lt($start)) {
+            return $out;
+        }
+
+        [$h, $m] = array_pad(array_map('intval', explode(':', $time)), 2, 0);
+        $wanted = array_flip(array_map('intval', $weekdays));
+
+        // A season is weeks, not years. The cap stops a mistyped "until" year
+        // from generating four hundred performances before anybody notices.
+        $cursor = $start;
+        $guard = 0;
+        while ($cursor->lte($end) && $guard++ < 400) {
+            if (isset($wanted[$cursor->dayOfWeek])) {
+                $out->push($cursor->setTime($h, $m));
+            }
+            $cursor = $cursor->addDay();
+        }
+
+        return $out;
+    }
+
+    /**
+     * What generating this run would do, without doing it.
+     *
+     * Dates the event already has are reported as `existing` rather than
+     * silently skipped: running the same pattern twice is a normal mistake
+     * and the operator should see that it was caught, not wonder why the
+     * count is lower than the dates they picked.
+     *
+     * @return array{dates: Collection<int, CarbonImmutable>, fresh: Collection<int, CarbonImmutable>, existing: Collection<int, CarbonImmutable>}
+     */
+    public static function preview(
+        Event $event,
+        string $from,
+        string $until,
+        array $weekdays,
+        string $time,
+    ): array {
+        $dates = self::dates($from, $until, $weekdays, $time);
+
+        $taken = $event->performances()
+            ->pluck('starts_at')
+            ->map(fn ($d) => CarbonImmutable::parse($d)->format('Y-m-d H:i'))
+            ->flip();
+
+        $existing = $dates->filter(fn (CarbonImmutable $d) => $taken->has($d->format('Y-m-d H:i')))->values();
+        $fresh = $dates->reject(fn (CarbonImmutable $d) => $taken->has($d->format('Y-m-d H:i')))->values();
+
+        return ['dates' => $dates, 'fresh' => $fresh, 'existing' => $existing];
+    }
+
+    /**
+     * Create the run. Returns how many performances were made.
+     *
+     * `$copyTicketsFrom` is a performance whose categories and prices are
+     * duplicated onto every new date — the reason this exists at all. Six
+     * Sundays with three categories each is eighteen prices typed by hand,
+     * and the eighteenth is where the typo is.
+     */
+    public static function create(
+        Event $event,
+        string $from,
+        string $until,
+        array $weekdays,
+        string $time,
+        int $venueId,
+        ?int $doorsMinutesBefore = null,
+        string $status = 'scheduled',
+        ?Performance $copyTicketsFrom = null,
+    ): int {
+        $fresh = self::preview($event, $from, $until, $weekdays, $time)['fresh'];
+        if ($fresh->isEmpty()) {
+            return 0;
+        }
+
+        return DB::transaction(function () use ($event, $fresh, $venueId, $doorsMinutesBefore, $status, $copyTicketsFrom): int {
+            $made = 0;
+            foreach ($fresh as $date) {
+                $performance = Performance::create([
+                    'event_id' => $event->id,
+                    'venue_id' => $venueId,
+                    'starts_at' => $date,
+                    'doors_open_at' => $doorsMinutesBefore === null ? null : $date->subMinutes($doorsMinutesBefore),
+                    'status' => $status,
+                ]);
+
+                if ($copyTicketsFrom) {
+                    self::copyTickets($copyTicketsFrom, $performance);
+                }
+                $made++;
+            }
+
+            return $made;
+        });
+    }
+
+    /**
+     * Duplicate one performance's categories onto another.
+     *
+     * Everything about the category carries over EXCEPT what has been sold:
+     * `quantity_sold` starts at zero, because a new date has sold nothing.
+     * Copying it would hand the new Sunday last Sunday's sales and quietly
+     * shrink what is left to sell.
+     *
+     * Skips any category whose name is already on the target, so running it
+     * twice does not double the price list.
+     */
+    public static function copyTickets(Performance $from, Performance $to): int
+    {
+        $already = $to->ticketTypes()->pluck('name')->map(fn ($n) => mb_strtolower($n))->flip();
+        $made = 0;
+
+        foreach ($from->ticketTypes as $type) {
+            if ($already->has(mb_strtolower($type->name))) {
+                continue;
+            }
+
+            $copy = $type->replicate([
+                'performance_id',
+                'quantity_sold',
+                'created_at',
+                'updated_at',
+            ]);
+            $copy->performance_id = $to->id;
+            $copy->quantity_sold = 0;
+            $copy->save();
+            $made++;
+        }
+
+        return $made;
+    }
+
+    /**
+     * Dates of this event that have prices set, to copy FROM.
+     *
+     * This lives here rather than inline in the Filament action because an
+     * option list built inside a closure is only reachable through Livewire,
+     * and the first version of it — a HAVING over the withCount alias, which
+     * is a subquery in the SELECT list and not an aggregate — blew the modal
+     * up with a 500 that no test could see.
+     *
+     * @return array<int, string>
+     */
+    public static function priceSourceOptions(Event $event): array
+    {
+        return $event->performances()
+            ->whereHas('ticketTypes')
+            ->withCount('ticketTypes')
+            ->orderBy('starts_at')
+            ->get()
+            ->mapWithKeys(fn (Performance $p): array => [
+                $p->id => $p->starts_at->format('D j M Y · g:i A').' ('.$p->ticket_types_count.' categories)',
+            ])
+            ->all();
+    }
+
+    /**
+     * The other dates of this run that prices can be copied TO.
+     *
+     * Future dates only. Rewriting the price list of a Sunday that has
+     * already been sold and played is never what anybody means.
+     *
+     * @return array<int, string>
+     */
+    public static function copyTargetOptions(Performance $record): array
+    {
+        return $record->event
+            ->performances()
+            ->whereKeyNot($record->getKey())
+            ->where('starts_at', '>', now())
+            // A date that is off is not a date to set prices for.
+            ->where('status', '!=', 'cancelled')
+            ->withCount('ticketTypes')
+            ->orderBy('starts_at')
+            ->get()
+            ->mapWithKeys(fn (Performance $p): array => [
+                $p->id => $p->starts_at->format('D j M Y · g:i A').
+                    ($p->ticket_types_count > 0 ? ' — already has '.$p->ticket_types_count : ''),
+            ])
+            ->all();
+    }
+
+    /** 0–6 as Carbon numbers them, with the names an operator reads. */
+    public static function weekdayOptions(): array
+    {
+        return [
+            1 => 'Monday', 2 => 'Tuesday', 3 => 'Wednesday', 4 => 'Thursday',
+            5 => 'Friday', 6 => 'Saturday', 0 => 'Sunday',
+        ];
+    }
+}

+    public function test_the_clients_season_produces_exactly_the_right_sundays(): void
+    {
+        // The client's own words: every Sunday, 25 Oct to 29 Nov 2026.
+        $dates = \App\Support\PerformanceRun::dates('2026-10-25', '2026-11-29', [0], '18:00');
+
+        $this->assertSame(
+            ['2026-10-25', '2026-11-01', '2026-11-08', '2026-11-15', '2026-11-22', '2026-11-29'],
+            $dates->map(fn ($d) => $d->format('Y-m-d'))->all(),
+        );
+        $this->assertSame('18:00', $dates->first()->format('H:i'));
+        $this->assertTrue($dates->every(fn ($d) => $d->dayOfWeek === 0), 'Every date must be a Sunday.');
+    }
+
+    public function test_a_run_can_fall_on_more_than_one_weekday(): void
+    {
+        // Friday and Saturday for a fortnight.
+        $dates = \App\Support\PerformanceRun::dates('2026-10-26', '2026-11-08', [5, 6], '19:30');
+        $this->assertSame(
+            ['2026-10-30', '2026-10-31', '2026-11-06', '2026-11-07'],
+            $dates->map(fn ($d) => $d->format('Y-m-d'))->all(),
+        );
+    }
+
+    public function test_an_impossible_range_produces_nothing_rather_than_guessing(): void
+    {
+        $this->assertCount(0, \App\Support\PerformanceRun::dates('2026-11-29', '2026-10-25', [0], '18:00'));
+        $this->assertCount(0, \App\Support\PerformanceRun::dates('2026-10-25', '2026-11-29', [], '18:00'));
+    }
+
+    public function test_generating_the_run_creates_the_performances_and_copies_the_prices(): void
+    {
+        [$event, $venue] = $this->bare();
+
+        // One date, priced by hand — the template for the rest.
+        $first = Performance::create([
+            'event_id' => $event->id,
+            'venue_id' => $venue->id,
+            'starts_at' => '2026-10-25 18:00:00',
+            'status' => 'on_sale',
+        ]);
+        TicketType::create(['performance_id' => $first->id, 'name' => 'Regular', 'price_cents' => 50000, 'quantity_total' => 100, 'quantity_sold' => 37]);
+        TicketType::create(['performance_id' => $first->id, 'name' => 'Student', 'price_cents' => 30000, 'quantity_total' => 40]);
+
+        $made = \App\Support\PerformanceRun::create(
+            $event, '2026-10-25', '2026-11-29', [0], '18:00',
+            $venue->id, doorsMinutesBefore: 30, status: 'on_sale', copyTicketsFrom: $first,
+        );
+
+        // Five, not six: the 25th already existed.
+        $this->assertSame(5, $made);
+        $this->assertSame(6, $event->performances()->count());
+
+        $second = $event->performances()->where('starts_at', '2026-11-01 18:00:00')->firstOrFail();
+        $this->assertSame('2026-11-01 17:30:00', $second->doors_open_at->format('Y-m-d H:i:s'));
+        $this->assertSame('on_sale', $second->status);
+
+        // Prices carried over, sales did NOT.
+        $this->assertSame(['Regular', 'Student'], $second->ticketTypes()->orderBy('name')->pluck('name')->all());
+        $regular = $second->ticketTypes()->where('name', 'Regular')->firstOrFail();
+        $this->assertSame(50000, $regular->price_cents);
+        $this->assertSame(100, $regular->quantity_total);
+        $this->assertSame(0, $regular->quantity_sold, "A new date must not inherit last week's sales.");
+    }

+    public function test_copying_prices_twice_does_not_double_the_list(): void
+    {
+        [$event, $venue] = $this->bare();
+        $from = Performance::create(['event_id' => $event->id, 'venue_id' => $venue->id, 'starts_at' => '2026-10-25 18:00:00', 'status' => 'on_sale']);
+        TicketType::create(['performance_id' => $from->id, 'name' => 'Regular', 'price_cents' => 50000, 'quantity_total' => 100]);
+        $to = Performance::create(['event_id' => $event->id, 'venue_id' => $venue->id, 'starts_at' => '2026-11-01 18:00:00', 'status' => 'on_sale']);

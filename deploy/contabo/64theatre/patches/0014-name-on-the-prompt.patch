+    /**
+     * The name the buyer will see on the M-Pesa prompt, when it is not ours.
+     *
+     * Returns null unless the live gateway is one that collects through
+     * somebody else's paybill AND a name has been configured — so the
+     * reassurance appears only where it is actually needed, and never says
+     * something we have not been told is true.
+     */
+    public static function promptName(): ?string
+    {
+        if (self::gateway() !== 'payhero') {
+            return null;
+        }
+
+        $name = trim((string) config('services.payhero.display_name'));
+
+        return $name === '' ? null : $name;
+    }
+

diff --git a/app/Support/Role.php b/app/Support/Role.php
new file mode 100644
index 0000000..3abcec7
--- /dev/null
+++ b/app/Support/Role.php
@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Support;
+
+/**
+ * Who someone is, and what that lets them do.
+ *
+ * One list, in one place. Before this, the role vocabulary existed in four
+ * places that disagreed: the database enum allowed six values, while three
+ * access checks tested for `admin` and `gate` — neither of which the column
+ * can store. Those checks could therefore never pass for anybody, and real
+ * `gate_staff` were excluded from the very Door pages built for them.
+ *
+ * The values here are exactly the enum's. Adding one means a migration, which
+ * is the point: the database and the code cannot drift apart again.
+ */
+class Role
+{
+    public const SUPER_ADMIN = 'super_admin';
+
+    public const FINANCE = 'finance';
+
+    public const EVENT_MANAGER = 'event_manager';
+
+    public const MARKETING = 'marketing';
+
+    public const GATE_STAFF = 'gate_staff';
+
+    public const ORGANISER_ADMIN = 'organiser_admin';
+
+    /** For a dropdown: value => what it means in plain words. */
+    public static function options(): array
+    {
+        return [
+            self::SUPER_ADMIN => 'Administrator — everything, including users and settings',
+            self::FINANCE => 'Finance — money, orders, refunds and reports',
+            self::EVENT_MANAGER => 'Event manager — events, performances, tickets and the door',
+            self::MARKETING => 'Marketing — promo codes and campaigns, no financials',
+            self::GATE_STAFF => 'Gate staff — the door only: scan, sell and check in',
+            self::ORGANISER_ADMIN => 'Visiting organiser — their own events only',
+        ];
+    }
+
+    /** Short label for a table cell or badge. */
+    public static function label(?string $role): string
+    {
+        return match ($role) {
+            self::SUPER_ADMIN => 'Administrator',
+            self::FINANCE => 'Finance',
+            self::EVENT_MANAGER => 'Event manager',
+            self::MARKETING => 'Marketing',
+            self::GATE_STAFF => 'Gate staff',
+            self::ORGANISER_ADMIN => 'Visiting organiser',
+            default => $role ?? '—',
+        };
+    }
+
+    /**
+     * May sign in to /admin at all.
+     *
+     * Gate staff are included so they can reach Verify a ticket and Door
+     * stats; everything else in the panel is closed to them below. Keeping
+     * them out entirely was the old behaviour and it meant the door team
+     * could not answer "has this ticket been used?" without an owner present.
+     */
+    public static function canAccessPanel(?string $role): bool
+    {
+        return in_array($role, [
+            self::SUPER_ADMIN, self::FINANCE, self::EVENT_MANAGER,
+            self::MARKETING, self::GATE_STAFF, self::ORGANISER_ADMIN,
+        ], true);
+    }
+
+    /** Door screens: verifying a ticket, admitting, and the live count. */
+    public static function canWorkTheDoor(?string $role): bool
+    {
+        return in_array($role, [
+            self::SUPER_ADMIN, self::EVENT_MANAGER, self::GATE_STAFF, self::FINANCE,
+        ], true);
+    }
+
+    /** Taking money: orders, payments, refunds. */
+    public static function canHandleMoney(?string $role): bool
+    {
+        return in_array($role, [
+            self::SUPER_ADMIN, self::FINANCE, self::EVENT_MANAGER, self::GATE_STAFF,
+        ], true);
+    }
+
+    /** Creating and editing what is on sale. */
+    public static function canManageProgramme(?string $role): bool
+    {
+        return in_array($role, [
+            self::SUPER_ADMIN, self::EVENT_MANAGER, self::ORGANISER_ADMIN,
+        ], true);
+    }
+
+    /** Promo codes and campaigns. */
+    public static function canMarket(?string $role): bool
+    {
+        return in_array($role, [
+            self::SUPER_ADMIN, self::MARKETING, self::EVENT_MANAGER,
+        ], true);
+    }
+
+    /** Creating staff and changing what they can reach. */
+    public static function canManagePeople(?string $role): bool
+    {
+        return $role === self::SUPER_ADMIN;
+    }
+}

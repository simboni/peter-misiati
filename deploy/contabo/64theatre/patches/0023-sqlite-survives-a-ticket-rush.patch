diff --git a/deploy/loadtest/run.sh b/deploy/loadtest/run.sh
new file mode 100755
index 0000000..084e2ca
--- /dev/null
+++ b/deploy/loadtest/run.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# ---------------------------------------------------------------------------
+# run.sh — sell N tickets at once and see what actually happens.
+#
+#   bash deploy/loadtest/run.sh                  100 buyers, 20 at a time
+#   bash deploy/loadtest/run.sh 200 150 40       buyers, seats, concurrency
+#
+# Real parallelism: each buyer is its own PHP process against a shared SQLite
+# file, so this reproduces genuine lock contention rather than simulating it.
+#
+# WHAT IT TOUCHES: a throwaway database under /tmp. It never reads or writes
+# the live one. Run it on any machine with the repo and composer installed.
+#
+# WHY IT EXISTS. With SQLite's stock settings this suite completed 26 of 100
+# sales and failed 74 with "database is locked" — no overselling, but three
+# quarters of buyers turned away during a rush. config/database.php now sets
+# busy_timeout, WAL and IMMEDIATE transactions, and the same run completes
+# 100 of 100. Re-run it after any change to that config, or to the checkout.
+# ---------------------------------------------------------------------------
+set -uo pipefail
+cd "$(dirname "$0")"
+
+BUYERS=${1:-100}
+STOCK=${2:-100}
+PAR=${3:-20}
+
+export SIM_DB="${TMPDIR:-/tmp}/64theatre-loadtest-$$.sqlite"
+export SIM_STOCK="$STOCK"
+trap 'rm -f "$SIM_DB" "$SIM_DB-wal" "$SIM_DB-shm" results.txt' EXIT
+
+: > "$SIM_DB"
+SIM_TYPE=$(php setup.php) || { echo "setup failed — is composer installed?"; exit 1; }
+export SIM_TYPE
+
+echo "$BUYERS buyers, $STOCK seats, $PAR at a time"
+START=$(date +%s)
+seq 1 "$BUYERS" | xargs -P "$PAR" -I{} php buyer.php {} > results.txt 2>&1
+echo "wall clock: $(( $(date +%s) - START ))s"
+
+OK=$(grep -c '^OK' results.txt || true)
+SOLD=$(grep -c '^SOLDOUT' results.txt || true)
+ERR=$(grep -c '^ERROR' results.txt || true)
+
+printf '  sold %s   sold-out %s   ERRORS %s\n' "$OK" "$SOLD" "$ERR"
+[ "$ERR" -gt 0 ] && { echo "  --- errors ---"; grep '^ERROR' results.txt | sed 's/ [0-9]*$//' | sort | uniq -c | head -5; }
+
+grep '^OK' results.txt | awk '{print $2}' | sort -n | awk 'NR>0{a[NR]=$1} END {if (NR) printf "  latency ms: median %d  p95 %d  max %d\n", a[int(NR*0.5)], a[int(NR*0.95)], a[NR]}'
+
+php -r '
+$db = new PDO("sqlite:".getenv("SIM_DB"));
+$r = $db->query("select quantity_total, quantity_sold from ticket_types")->fetch();
+$t = $db->query("select count(*) c from tickets")->fetch();
+$over = $r["quantity_sold"] > $r["quantity_total"];
+printf("  stock %d, sold %d, tickets issued %d\n", $r["quantity_total"], $r["quantity_sold"], $t["c"]);
+echo $over ? "  *** OVERSOLD — STOP AND INVESTIGATE ***\n" : "  no overselling\n";
+exit($over ? 1 : 0);
+' || exit 1
+
+[ "$ERR" -eq 0 ] || { echo "  errors occurred — buyers would have been turned away"; exit 1; }
+echo "  PASS"

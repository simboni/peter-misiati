+<?php
+
+namespace Tests\Feature;
+
+use App\Models\TicketType;
+use App\Services\Checkout;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Queue;
+use Tests\TestCase;
+
+class OrderShowRenderTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_the_page_a_buyer_lands_on_after_the_stk_push_renders(): void
+    {
+        Queue::fake();
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+
+        $order = app(Checkout::class)->startOrder(
+            items: [$type->id => 2], phone: '0712345678', name: 'Jane',
+        );
+
+        $this->get('/orders/'.$order->uuid)->assertOk();
+    }
+}

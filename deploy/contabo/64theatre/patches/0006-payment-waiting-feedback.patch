 <script>
+    // Pressing Pay twice would create two orders, hold two sets of seats and
+    // send two STK prompts, so the button locks on the first submit.
+    document.querySelectorAll('form.booking').forEach(function (form) {
+        form.addEventListener('submit', function () {
+            const btn = form.querySelector('.pay-btn');
+            if (!btn || btn.disabled) return;
+            btn.disabled = true;
+            const label = btn.querySelector('.pay-label');
+            const busy = btn.querySelector('.pay-busy');
+            if (label) label.hidden = true;
+            if (busy) busy.hidden = false;
+        });
+    });

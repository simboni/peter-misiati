diff --git a/app/Models/Setting.php b/app/Models/Setting.php
new file mode 100644
index 0000000..9624747
--- /dev/null
+++ b/app/Models/Setting.php
@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Facades\Cache;
+
+/**
+ * A key/value setting, cached so reading one on every checkout costs nothing.
+ *
+ * Reads are cached forever and the cache is dropped on write, rather than
+ * expiring on a timer: a payment switch must take effect the moment it is
+ * flipped, not up to five minutes later.
+ */
+class Setting extends Model
+{
+    protected $primaryKey = 'key';
+
+    protected $keyType = 'string';
+
+    public $incrementing = false;
+
+    protected $guarded = [];
+
+    private const CACHE_PREFIX = 'setting:';
+
+    public static function get(string $key, mixed $default = null): mixed
+    {
+        // A missing table (fresh checkout, migrations not yet run) must not
+        // take the site down — fall back to the default.
+        try {
+            $value = Cache::rememberForever(
+                self::CACHE_PREFIX.$key,
+                fn () => static::query()->find($key)?->value ?? '__null__',
+            );
+        } catch (\Throwable) {
+            return $default;
+        }
+
+        return $value === '__null__' ? $default : $value;
+    }
+
+    public static function put(string $key, mixed $value): void
+    {
+        static::query()->updateOrCreate(['key' => $key], ['value' => $value]);
+        Cache::forget(self::CACHE_PREFIX.$key);
+    }
+
+    public static function bool(string $key, bool $default): bool
+    {
+        $raw = static::get($key);
+
+        return $raw === null ? $default : in_array($raw, ['1', 'true', 'yes'], true);
+    }
+}

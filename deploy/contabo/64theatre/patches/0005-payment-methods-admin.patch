diff --git a/app/Support/PaymentSettings.php b/app/Support/PaymentSettings.php
new file mode 100644
index 0000000..54066ad
--- /dev/null
+++ b/app/Support/PaymentSettings.php
@@ -0,0 +1,106 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Setting;
+
+/**
+ * Which ways of paying are switched on, and which gateway serves them.
+ *
+ * Every value falls back to config, which falls back to the environment, so an
+ * install that has never opened the settings page behaves exactly as before.
+ * The office changes the switches; the credentials stay in `.env`.
+ *
+ * The gateway identifiers are the same ones config/payments.php has always
+ * used — this only moves *which* one is chosen out of a deploy and into the
+ * admin.
+ */
+class PaymentSettings
+{
+    public const KEY_GATEWAY = 'payments.gateway';
+
+    public const KEY_ONLINE_ENABLED = 'payments.online_enabled';
+
+    public const KEY_OFFLINE_ENABLED = 'payments.offline_enabled';
+
+    /**
+     * Gateways the admin may choose.
+     *
+     * `fake` is absent on purpose. It confirms orders and issues real tickets
+     * without taking a shilling, which is invaluable in testing and
+     * catastrophic in production — and a dropdown is exactly how it would get
+     * selected by accident. It remains available through PAYMENT_GATEWAY in
+     * `.env`, where choosing it takes deliberate effort.
+     *
+     * @return array<string, string>
+     */
+    public static function selectableGateways(): array
+    {
+        return [
+            'kopokopo' => 'Kopo Kopo — M-Pesa STK push',
+            'pesapal' => 'Pesapal — M-Pesa and cards',
+            'daraja' => 'Safaricom Daraja — direct M-Pesa',
+        ];
+    }
+
+    /** The gateway online checkout uses. */
+    public static function gateway(): string
+    {
+        $chosen = Setting::get(self::KEY_GATEWAY);
+
+        // An unknown or unselectable value (including a stale 'fake' left in
+        // the table) falls back to config rather than being honoured.
+        return array_key_exists((string) $chosen, self::selectableGateways())
+            ? (string) $chosen
+            : (string) config('payments.default');
+    }
+
+    /** Whether buyers can pay online at all. */
+    public static function onlineEnabled(): bool
+    {
+        return Setting::bool(self::KEY_ONLINE_ENABLED, true);
+    }
+
+    /** Whether the Pay Bill panel shows on an unpaid order. */
+    public static function offlineEnabled(): bool
+    {
+        return Setting::bool(
+            self::KEY_OFFLINE_ENABLED,
+            (bool) config('services.offline_payment.enabled'),
+        );
+    }
+
+    /**
+     * Has the chosen gateway got what it needs to work?
+     *
+     * Used to refuse switching to a gateway that would fail on the first
+     * checkout, and to say so on the settings page rather than leaving
+     * somebody to discover it through a customer.
+     */
+    public static function credentialsPresent(string $gateway): bool
+    {
+        return match ($gateway) {
+            'kopokopo' => filled(config('services.kopokopo.client_id'))
+                && filled(config('services.kopokopo.client_secret'))
+                && filled(config('services.kopokopo.api_key'))
+                && filled(config('services.kopokopo.till_number')),
+            'pesapal' => filled(config('services.pesapal.consumer_key'))
+                && filled(config('services.pesapal.consumer_secret')),
+            'daraja' => filled(config('services.daraja.consumer_key'))
+                && filled(config('services.daraja.consumer_secret'))
+                && filled(config('services.daraja.passkey')),
+            default => false,
+        };
+    }
+
+    /** True when the gateway is pointed at a test environment. */
+    public static function isSandbox(string $gateway): bool
+    {
+        return match ($gateway) {
+            'kopokopo' => str_contains((string) config('services.kopokopo.base_url'), 'sandbox'),
+            'pesapal' => str_contains((string) config('services.pesapal.base_url'), 'cybqa'),
+            'daraja' => str_contains((string) config('services.daraja.base_url'), 'sandbox'),
+            default => false,
+        };
+    }
+}

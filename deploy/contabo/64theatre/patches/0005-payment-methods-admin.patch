@@ -0,0 +1,31 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * Operational settings the office can change without a deploy.
+ *
+ * Deliberately a narrow key/value store rather than a column per setting:
+ * what belongs here is a handful of switches, and every one of them has a
+ * safe default in config, so a missing row is never a broken install.
+ *
+ * Secrets stay in the environment. Nothing in this table is a credential.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::create('settings', function (Blueprint $table) {
+            $table->string('key')->primary();
+            $table->text('value')->nullable();
+            $table->timestamps();
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::dropIfExists('settings');
+    }
+};

+<script>
+    // Swap the button wording with the method, so the operator reads what the
+    // press will actually do rather than remembering which radio is on.
+    document.querySelectorAll('input[name="method"]').forEach(function (r) {
+        r.addEventListener('change', function () {
+            const form = r.closest('form');
+            const mpesa = form.querySelector('input[name="method"][value="mpesa"]').checked;
+            form.querySelector('.m-label').hidden = !mpesa;
+            form.querySelector('.c-label').hidden = mpesa;
+        });
+    });
+
+    // Poll the order the prompt was sent for. The endpoint is the same one the
+    // buyer's own page uses, so there is one definition of "paid".
+    (function () {
+        const box = document.getElementById('waitbox');
+        if (!box) return;
+        let tries = 0;
+        (function poll() {
+            if (tries++ > 100) return;               // ~5 minutes, then stop
+            fetch(box.dataset.poll, { headers: { 'Accept': 'application/json' } })
+                .then(function (r) { return r.json(); })
+                .then(function (d) {
+                    if (d.status === 'paid') { location.reload(); return; }
+                    setTimeout(poll, 3000);
+                })
+                .catch(function () { setTimeout(poll, 5000); });
+        })();
+    })();
+</script>

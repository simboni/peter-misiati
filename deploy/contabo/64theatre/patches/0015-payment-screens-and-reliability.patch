+    /**
+     * The prepaid balance PayHero spends to send prompts.
+     *
+     * Distinct from the money being collected: this one pays the per-request
+     * fee, and when it runs out every STK request is refused while
+     * everything else looks healthy. Returned for logs and for the admin, so
+     * the first sign of trouble is not a customer who cannot pay.
+     *
+     * Never throws — it is called from error paths.
+     */
+    public function serviceWalletBalance(): ?float
+    {
+        try {
+            $response = Http::withBasicAuth(
+                (string) config('services.payhero.username'),
+                (string) config('services.payhero.password'),
+            )->acceptJson()->timeout(8)->get($this->base().'/api/v2/wallets');
+
+            if (! $response->successful()) {
+                return null;
+            }
+
+            $json = $response->json();
+
+            // Shape is not documented; accept the forms seen in the wild and
+            // in the callback body (ServiceWalletBalance).
+            $value = data_get($json, 'service_wallet_balance')
+                ?? data_get($json, 'ServiceWalletBalance')
+                ?? data_get($json, 'service_balance')
+                ?? data_get($json, 'data.service_wallet_balance');
+
+            return is_numeric($value) ? (float) $value : null;
+        } catch (\Throwable) {
+            return null;
+        }
+    }

+                ->maxLength(120)
+                ->visible(fn ($get): bool => (int) $get('admits') > 1)
+                ->placeholder('Group of 8 — save 20%')
+                ->helperText('Shown on the website beside the price.'),
+
+            Toggle::make('collect_member_names')
+                ->label('Ask for member names after payment')
+                ->default(true)
+                ->visible(fn ($get): bool => (int) $get('admits') > 1)

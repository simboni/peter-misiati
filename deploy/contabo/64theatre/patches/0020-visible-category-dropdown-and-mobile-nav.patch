 namespace App\Filament\Forms\Components;
 
+use Filament\Forms\Components\Select;
 use Filament\Forms\Components\TextInput;
 use Illuminate\Support\Facades\DB;
 
 /**
- * A field you can type a new value into, which also suggests the ones already
- * in use.
+ * A dropdown you can add to.
  *
- * The problem: category and language are plain string columns, but the form
- * offered a fixed list, so a show that was not theatre, a festival, a workshop
- * or a concert had to be filed as "Other". The column never needed a migration
- * to accept a new value — only the form stood in the way.
+ * Category and language are plain string columns, but the form offered a fixed
+ * list, so a show that was not theatre, a festival, a workshop or a concert had
+ * to be filed as "Other". The column never needed a migration to accept a new
+ * value — only the form stood in the way.
  *
- * WHY A TEXT INPUT AND NOT A SELECT. The obvious move is a Select with
- * createOptionForm, as VenuePicker uses. That works for a venue because the
- * option becomes a real row, so it is in the list the next time it is read.
- * A bare string has no row: Filament puts an implicit `in:` validation rule on
- * a single-value Select built from its own options, so a value typed into a
- * create-option modal is rejected on save for not being in the list it was
- * never added to. The "+" button becomes a dead end that fails at the last
- * step.
+ * THE PART THAT IS NOT OBVIOUS. A Select validates its own state with an
+ * implicit `in:` rule, and `Select::getInValidationRuleValues()` returns an
+ * empty allow-list — which rejects everything — when `getOptionLabel()` comes
+ * back blank. A value typed into the create-option modal is not in the options
+ * list, so its label is blank, so saving fails with "the selected category is
+ * invalid" on a field the user just created.
  *
- * A TextInput carries no such rule, and `datalist` is already how this
- * codebase does pick-or-type — see the ticket-type name field in CreateEvent
- * and PerformancesRelationManager.
+ * `getOptionLabelUsing()` is the way out: when it is set, getOptionLabel()
+ * defers to it, the label is non-blank for ANY value, and the method returns
+ * null — meaning no `in:` rule is attached at all. The dropdown then behaves
+ * like a dropdown and still accepts a new entry.
  *
- * The suggestions are the seeded list PLUS every distinct value already stored,
- * so a category somebody adds once is offered to everybody afterwards and the
- * vocabulary converges instead of sprawling.
+ * A TextInput with a datalist also accepts anything, and was the first thing
+ * tried here. It was wrong for a different reason: datalist suggestions stay
+ * hidden until the user types, so from the client's side the dropdown had
+ * simply vanished.
+ *
+ * Suggestions are the seeded list plus every distinct value already stored, so
+ * a category added once is offered to everybody afterwards and the vocabulary
+ * converges instead of sprawling.
  */
 class OpenSelect
 {
     /**
-     * @param  array<string, string>  $seeded  value => label (labels are for
-     *                                         readability at the call site;
-     *                                         the stored value is the key)
+     * @param  array<string, string>  $seeded  value => label
      */
-    public static function make(string $name, string $table, string $column, array $seeded = []): TextInput
+    public static function make(string $name, string $table, string $column, array $seeded = []): Select
     {
-        return TextInput::make($name)
-            ->datalist(fn (): array => self::suggestions($table, $column, $seeded))
-            ->maxLength(60)
-            ->helperText('Pick one of the suggestions, or type a new one.');
+        return Select::make($name)
+            ->native(false)
+            ->searchable()
+            ->options(fn (): array => self::options($table, $column, $seeded))
+            // Load-bearing: see the note above. Without this, anything added
+            // through the + button is rejected on save.
+            ->getOptionLabelUsing(fn (mixed $value): ?string => filled($value) ? (string) $value : null)
+            ->createOptionForm([
+                TextInput::make($column)
+                    ->label('Name')
+                    ->required()
+                    ->maxLength(60),
+            ])
+            // The "new option" is just the string itself — there is no row to
+            // create, which is exactly why the venue picker's approach does not
+            // transfer here.
+            ->createOptionUsing(fn (array $data): string => trim((string) ($data[$column] ?? '')))
+            ->createOptionModalHeading('Add a new '.$name);
     }
 
     /**
      * @param  array<string, string>  $seeded
-     * @return array<int, string>
+     * @return array<string, string>
      */
-    public static function suggestions(string $table, string $column, array $seeded): array
+    public static function options(string $table, string $column, array $seeded): array
     {
         $existing = [];
 
@@ -69,6 +85,16 @@ public static function suggestions(string $table, string $column, array $seeded)
             $existing = [];
         }
 
-        return array_values(array_unique(array_merge(array_keys($seeded), $existing)));
+        $options = $seeded;
+
+        foreach ($existing as $value) {
+            if (! array_key_exists($value, $options)) {
+                // Stored values are shown exactly as they were typed. Guessing
+                // a prettier label would make the list disagree with the data.
+                $options[$value] = $value;
+            }
+        }
+
+        return $options;
     }
 }

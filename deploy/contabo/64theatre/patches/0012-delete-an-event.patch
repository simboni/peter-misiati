diff --git a/app/Support/EventRemoval.php b/app/Support/EventRemoval.php
new file mode 100644
index 0000000..d1e5149
--- /dev/null
+++ b/app/Support/EventRemoval.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Event;
+use App\Models\Order;
+use App\Models\Ticket;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * What stands between an event and its deletion, and how to clear it.
+ *
+ * `performances.event_id` and `ticket_types.performance_id` cascade, so an
+ * event with nothing sold deletes cleanly. Orders, tickets and check-ins do
+ * NOT cascade — deliberately, because a show people have paid for should not
+ * vanish because somebody clicked the wrong row. The database refuses with a
+ * foreign-key violation, which Filament surfaces as "error while loading
+ * page": true, unhelpful, and indistinguishable from a bug.
+ *
+ * So: count what is in the way, say so plainly, and offer the two honest
+ * answers — cancel a real show, or erase a test one on purpose.
+ */
+class EventRemoval
+{
+    /** @return array{performances:int, orders:int, paid_orders:int, tickets:int, checkins:int} */
+    public static function census(Event $event): array
+    {
+        $performanceIds = $event->performances()->pluck('id');
+
+        return [
+            'performances' => $performanceIds->count(),
+            'orders' => Order::whereIn('performance_id', $performanceIds)->count(),
+            'paid_orders' => Order::whereIn('performance_id', $performanceIds)->where('status', 'paid')->count(),
+            'tickets' => Ticket::whereIn('performance_id', $performanceIds)->count(),
+            'checkins' => DB::table('checkins')->whereIn('performance_id', $performanceIds)->count(),
+        ];
+    }
+
+    /** Nothing sold, so the cascades can do their work. */
+    public static function isClean(Event $event): bool
+    {
+        $c = self::census($event);
+
+        return $c['orders'] === 0 && $c['tickets'] === 0 && $c['checkins'] === 0;
+    }
+
+    /** A sentence an operator can act on, rather than a constraint violation. */
+    public static function blockedReason(Event $event): ?string
+    {
+        $c = self::census($event);
+
+        if (self::isClean($event)) {
+            return null;
+        }
+
+        $parts = [];
+        if ($c['orders']) {
+            $parts[] = $c['orders'].' order'.($c['orders'] === 1 ? '' : 's')
+                .($c['paid_orders'] ? " ({$c['paid_orders']} paid)" : '');
+        }
+        if ($c['tickets']) {
+            $parts[] = $c['tickets'].' issued ticket'.($c['tickets'] === 1 ? '' : 's');
+        }
+        if ($c['checkins']) {
+            $parts[] = $c['checkins'].' check-in'.($c['checkins'] === 1 ? '' : 's');
+        }
+
+        return 'This event has '.implode(', ', $parts).'.';
+    }
+
+    /**
+     * Erase the event and everything hanging off it, in dependency order.
+     *
+     * For demo and test data. Not for a show that sold real tickets: the money
+     * stays in M-Pesa whatever this does to the records, and deleting the
+     * records is how a reconciliation becomes impossible. Cancel those.
+     *
+     * @return array<string, int> what was removed
+     */
+    public static function purge(Event $event): array
+    {
+        return DB::transaction(function () use ($event): array {
+            $performanceIds = $event->performances()->pluck('id');
+            $orderIds = Order::whereIn('performance_id', $performanceIds)->pluck('id');
+
+            // Children first, or each delete trips the next constraint.
+            $removed = [
+                'checkins' => DB::table('checkins')->whereIn('performance_id', $performanceIds)->delete(),
+                'tickets' => Ticket::whereIn('performance_id', $performanceIds)->delete(),
+            ];
+
+            if ($orderIds->isNotEmpty()) {
+                // The ledger references orders and payments, so it goes before
+                // either of them.
+                $removed['ledger_entries'] = DB::table('ledger_entries')->whereIn('order_id', $orderIds)->delete();
+                $removed['payments'] = DB::table('payments')->whereIn('order_id', $orderIds)->delete();
+                $removed['order_items'] = DB::table('order_items')->whereIn('order_id', $orderIds)->delete();
+                $removed['orders'] = Order::whereIn('id', $orderIds)->delete();
+            }
+
+            // Promo codes point at the event and do not cascade.
+            DB::table('promo_codes')->where('event_id', $event->id)->update(['event_id' => null]);
+
+            // performances and ticket_types cascade from here.
+            $event->delete();
+
+            return array_filter($removed);
+        });
+    }
+}

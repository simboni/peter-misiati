+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Event;
+use App\Models\Organiser;
+use App\Models\Performance;
+use App\Models\TicketType;
+use App\Models\Venue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Str;
+use Tests\TestCase;
+
+/**
+ * The hero on the homepage.
+ *
+ * These assert the markup a browser needs, because the slider's behaviour
+ * lives in CSS and a small script and neither is reachable from PHPUnit. What
+ * IS worth pinning here is that every show gets a slide, that the controls are
+ * only rendered when there is more than one, and that the whole thing is still
+ * a list of shows with the script removed — which is the property that keeps a
+ * JavaScript mistake from emptying the front page of a ticket shop.
+ */
+class HeroSliderTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function show(string $title, int $daysAhead): Event
+    {
+        $organiser = Organiser::firstOrCreate(['slug' => 'test'], ['name' => 'Test']);
+        $venue = Venue::firstOrCreate(
+            ['organiser_id' => $organiser->id, 'name' => 'Hall'],
+            ['town' => 'Eldoret'],
+        );
+
+        $event = Event::create([
+            'organiser_id' => $organiser->id,
+            'title' => $title,
+            'slug' => Str::slug($title).'-'.uniqid(),
+            'category' => 'theatre',
+            'status' => 'published',
+            'description' => 'A play about '.$title.'. It is very good.',
+        ]);
+
+        $performance = Performance::create([
+            'event_id' => $event->id,
+            'venue_id' => $venue->id,
+            'starts_at' => now()->addDays($daysAhead),
+            'status' => 'on_sale',
+        ]);
+
+        TicketType::create([
+            'performance_id' => $performance->id,
+            'name' => 'Regular',
+            'price_cents' => 50000,
+            'quantity_total' => 50,
+        ]);
+
+        return $event;
+    }
+
+    public function test_every_upcoming_show_gets_a_slide(): void
+    {
+        $this->show('Oret', 3);
+        $this->show('Mvua ya Kwanza', 10);
+        $this->show('Sigana', 20);
+
+        $html = $this->get('/')->assertOk()->getContent();
+
+        $this->assertSame(3, substr_count($html, 'class="hero-slide"'));
+        $this->assertStringContainsString('Oret', $html);
+        $this->assertStringContainsString('Mvua ya Kwanza', $html);
+        $this->assertStringContainsString('Sigana', $html);
+    }
+
+    public function test_the_soonest_show_leads(): void
+    {
+        $this->show('Later', 30);
+        $this->show('Sooner', 2);
+
+        $html = $this->get('/')->assertOk()->getContent();
+
+        // "Now Showing" is the first slide's eyebrow; the rest say "Also On".
+        $this->assertLessThan(
+            strpos($html, 'Later'),
+            strpos($html, 'Sooner'),
+            'The next show to happen has to be the one the hero opens on.',
+        );
+    }
+
+    public function test_a_single_show_gets_no_controls(): void
+    {
+        $this->show('The Only Show', 5);
+
+        $html = $this->get('/')->assertOk()->getContent();
+
+        // Dots and arrows for a carousel of one are furniture that does
+        // nothing, and a dot you can press that changes nothing reads as
+        // broken.
+        //
+        // Matched on the rendered markup, not on "data-hero-dot" anywhere in
+        // the page: that string is also a selector inside the script, so the
+        // obvious assertion passes for the wrong reason and fails for one.
+        $this->assertStringNotContainsString('class="hero-nav"', $html);
+        $this->assertStringNotContainsString('<button type="button" class="hero-arrow', $html);
+        $this->assertStringContainsString('class="hero-slide"', $html);
+    }
+
+    public function test_the_hero_is_capped_so_it_cannot_grow_without_limit(): void
+    {
+        for ($i = 0; $i < 9; $i++) {
+            $this->show('Show '.$i, $i + 1);
+        }
+
+        $html = $this->get('/')->assertOk()->getContent();
+
+        // Nine shows is a long season and a hero nobody swipes to the end of.
+        // The rest are on the playbill below.

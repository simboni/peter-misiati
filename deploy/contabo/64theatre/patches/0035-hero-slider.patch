+        $html = $this->get('/')->assertOk()->getContent();
+
+        // A title carrying quotes has twice taken this site down by being
+        // escaped into a <script> body — Blade turns ' into &#039;, which is
+        // a SyntaxError that kills the whole file. The slider reads every
+        // value it needs from a data attribute, so no script on the page may
+        // contain show data.
+        preg_match_all('/<script\b[^>]*>(.*?)<\/script>/s', $html, $m);

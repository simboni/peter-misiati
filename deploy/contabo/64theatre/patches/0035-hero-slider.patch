+
+    <script>
+        (function () {
+            var hero = document.querySelector('[data-hero]');
+            if (!hero) { return; }
+
+            var track = hero.querySelector('[data-hero-track]');
+            var slides = hero.querySelectorAll('.hero-slide');
+            var dots = hero.querySelectorAll('[data-hero-dot]');
+            var count = hero.querySelector('[data-hero-count]');
+            if (!track || slides.length < 2) { return; }
+
+            var dwell = parseInt(hero.getAttribute('data-dwell'), 10) || 7000;
+            var calm = window.matchMedia('(prefers-reduced-motion: reduce)');
+            var index = 0;
+            var timer = null;
+
+            hero.style.setProperty('--hero-dwell', dwell + 'ms');
+
+            function goTo(i, smooth) {
+                index = (i + slides.length) % slides.length;
+                track.scrollTo({
+                    left: slides[index].offsetLeft - track.offsetLeft,
+                    behavior: (smooth === false || calm.matches) ? 'auto' : 'smooth'
+                });
+            }
+
+            function paint() {
+                for (var d = 0; d < dots.length; d++) {
+                    dots[d].setAttribute('aria-current', d === index ? 'true' : 'false');
+                }
+                if (count) { count.innerHTML = '<b>' + (index + 1) + '</b> / ' + slides.length; }
+            }
+
+            function play() {
+                stop();
+                if (calm.matches) { return; }
+                hero.setAttribute('data-paused', 'false');
+                timer = setInterval(function () { goTo(index + 1); }, dwell);
+            }
+
+            function stop() {
+                if (timer) { clearInterval(timer); timer = null; }
+                hero.setAttribute('data-paused', 'true');
+            }
+
+            // The source of truth for which slide is showing is the scroll
+            // position, not a variable. Swiping, dots, arrows and autoplay all
+            // end up here, so they can never disagree about where we are.
+            var tick = null;
+            track.addEventListener('scroll', function () {
+                if (tick) { return; }
+                tick = requestAnimationFrame(function () {
+                    tick = null;
+                    var mid = track.scrollLeft + track.clientWidth / 2;
+                    var nearest = 0;
+                    var best = Infinity;
+                    for (var s = 0; s < slides.length; s++) {
+                        var c = slides[s].offsetLeft - track.offsetLeft + slides[s].clientWidth / 2;
+                        var gap = Math.abs(c - mid);
+                        if (gap < best) { best = gap; nearest = s; }
+                    }
+                    if (nearest !== index) { index = nearest; paint(); }
+                });
+            }, { passive: true });
+
+            for (var d = 0; d < dots.length; d++) {
+                (function (n) {
+                    dots[n].addEventListener('click', function () { goTo(n); play(); });
+                })(d);
+            }
+
+            var prev = hero.querySelector('[data-hero-prev]');
+            var next = hero.querySelector('[data-hero-next]');
+            if (prev) { prev.addEventListener('click', function () { goTo(index - 1); play(); }); }
+            if (next) { next.addEventListener('click', function () { goTo(index + 1); play(); }); }
+
+            track.addEventListener('keydown', function (e) {
+                if (e.key === 'ArrowRight') { e.preventDefault(); goTo(index + 1); play(); }
+                if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(index - 1); play(); }
+            });
+
+            // Stop moving while somebody is reading, pointing at it, tabbing
+            // through it, or has the tab in the background.
+            hero.addEventListener('pointerenter', stop);
+            hero.addEventListener('pointerleave', play);
+            hero.addEventListener('focusin', stop);
+            hero.addEventListener('focusout', function (e) {
+                if (!hero.contains(e.relatedTarget)) { play(); }
+            });
+            hero.addEventListener('touchstart', stop, { passive: true });
+            document.addEventListener('visibilitychange', function () {
+                document.hidden ? stop() : play();
+            });
+            if (calm.addEventListener) {
+                calm.addEventListener('change', function () { calm.matches ? stop() : play(); });
+            }
+
+            paint();
+            play();
+        })();
+    </script>

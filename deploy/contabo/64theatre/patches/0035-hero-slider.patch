+    /* ── hero slider ────────────────────────────────────────────────────
+       CSS scroll-snap is the transport, not JavaScript. With JS off, or
+       broken, or still loading, the hero is a swipeable row of shows with
+       native momentum scrolling. The script below only adds autoplay, the
+       dots and the arrows — it cannot break the ability to see the shows,
+       which is the one thing this section exists to do. */
+    .hero-track{
+        display:flex; width:100%;
+        overflow-x:auto; overscroll-behavior-x:contain;
+        scroll-snap-type:x mandatory; scroll-behavior:smooth;
+        -webkit-overflow-scrolling:touch;
+        scrollbar-width:none; -ms-overflow-style:none;
+    }
+    .hero-track::-webkit-scrollbar{display:none}
+    .hero-slide{
+        position:relative; flex:0 0 100%; min-width:100%;
+        scroll-snap-align:center; scroll-snap-stop:always;
+        /* Every slide is as tall as the tallest one — that is how a flex row
+           works, and it is what you want: the page must not jump as it
+           advances. Centring stops the shows with a one-line description from
+           sitting at the top of all that height looking abandoned. */
+        display:flex; align-items:center;
+    }
+    .hero-slide > .stage-inner{width:100%}
+    /* The poster, behind the words, on phones — where the tilted playbill
+       card has no room. Scrimmed hard: the type has to stay readable over
+       whatever the poster happens to be. */
+    /* Blurred and lifted, not laid down flat. These posters are dark,
+       low-contrast artwork: at full fidelity behind text they read as mud,
+       and scrimmed enough to be safe they read as nothing at all. Blurred and
+       brightened they become a colour wash that is DIFFERENT FOR EVERY SHOW,
+       which is the whole point of a slider — each slide has to feel like a
+       different production, not the same gradient with new words. */
+    .slide-bg{
+        position:absolute; inset:-12%; z-index:0;
+        background-size:cover; background-position:50% 30%;
+        filter:blur(26px) saturate(1.5) brightness(1.35);
+        opacity:.9; transform:scale(1.1);
+    }
+    .slide-bg::after{content:""; position:absolute; inset:0;
+        background:linear-gradient(180deg, rgba(19,13,16,.42) 0%, rgba(19,13,16,.62) 45%, rgba(19,13,16,.88) 100%)}
+    @media (min-width:901px){.slide-bg{display:none}}
+
+    /* The artwork itself, crisp, at a size that fits a phone. The wash above
+       sets the mood; this is the evidence there is a real poster. */
+    .slide-art{
+        display:none; position:relative; z-index:2;
+        width:104px; aspect-ratio:3/4; border-radius:10px; overflow:hidden; flex:0 0 auto;
+        border:1px solid rgba(246,238,227,.22); box-shadow:0 14px 34px rgba(0,0,0,.55);
+    }
+    .slide-art img{width:100%; height:100%; object-fit:cover; display:block}
+    /* Beside the body copy, not the title: the title is the loudest thing on
+       the slide and splitting its width to make room for a thumbnail cost it
+       three lines on a phone. Here the poster breaks up a paragraph instead,
+       which is work it can do without taking anything away. */
+    .slide-body{display:flex; gap:16px; align-items:flex-start}
+    @media (max-width:900px){
+        .slide-art{display:block}
+        /* Shorter on a phone: the dots have to be on screen with the CTA, or
+           nobody learns there is more than one show. */
+        .stage{min-height:auto}
+        .stage-inner{padding:34px 22px 58px}
+    }
+
+    /* ── controls ── */
+    .hero-nav{
+        position:absolute; z-index:5; left:0; right:0; bottom:20px;
+        display:flex; align-items:center; justify-content:center; gap:16px;
+        pointer-events:none;
+    }
+    .hero-nav > *{pointer-events:auto}
+    .hero-count{font-size:.72rem; letter-spacing:.18em; color:var(--dim); font-variant-numeric:tabular-nums}
+    .hero-count b{color:var(--lamp-bright); font-weight:800}
+    .hero-dots{display:flex; gap:8px; align-items:center}
+    .hero-dot{
+        width:9px; height:9px; padding:0; border:0; border-radius:50%; cursor:pointer;
+        background:rgba(246,238,227,.28); transition:width .3s, background .3s, border-radius .3s;
+        position:relative; overflow:hidden;
+    }
+    .hero-dot:hover{background:rgba(246,238,227,.55)}
+    .hero-dot:focus-visible{outline:2px solid var(--focus); outline-offset:3px}
+    .hero-dot[aria-current="true"]{width:34px; border-radius:20px; background:rgba(246,238,227,.22)}
+    /* The active dot fills over the dwell time, so the page tells you it is

@@ -0,0 +1,64 @@
+<?php
+
+namespace App\Filament\Resources\ReferralCommissions;
+
+use App\Filament\Resources\ReferralCommissions\Pages\ListReferralCommissions;
+use App\Filament\Resources\ReferralCommissions\Tables\ReferralCommissionsTable;
+use App\Models\ReferralCommission;
+use App\Support\Role;
+use BackedEnum;
+use Filament\Resources\Resource;
+use Filament\Tables\Table;
+
+/**
+ * What is owed, to whom, and whether it is safe to send yet.
+ *
+ * Read-only apart from two decisions — marking a commission paid, and voiding
+ * one. There is no create and no edit: a commission is a consequence of a
+ * sale, and anything that could type one in by hand would be a way to pay a
+ * friend for a ticket nobody bought.
+ *
+ * NO AUTOMATIC PAYOUT. Money goes out of here by somebody sending M-Pesa and
+ * then recording that they did. Paying commission to members of the public is
+ * taxable income to them and Kenya puts withholding obligations on the payer;
+ * until an accountant has set that rate, an automated disbursement would be
+ * this code guessing at tax law.
+ */
+class ReferralCommissionResource extends Resource
+{
+    protected static ?string $model = ReferralCommission::class;
+
+    protected static string|BackedEnum|null $navigationIcon = 'heroicon-o-banknotes';
+
+    protected static string|\UnitEnum|null $navigationGroup = 'Marketing';
+
+    protected static ?string $modelLabel = 'commission';
+
+    protected static ?string $navigationLabel = 'Commission owed';
+
+    protected static ?int $navigationSort = 21;
+
+    public static function canAccess(): bool
+    {
+        return in_array(auth()->user()?->role, [
+            Role::SUPER_ADMIN, Role::FINANCE, Role::MARKETING,
+        ], true);
+    }
+
+    public static function canCreate(): bool
+    {
+        return false;
+    }
+
+    public static function table(Table $table): Table
+    {
+        return ReferralCommissionsTable::configure($table);
+    }
+
+    public static function getPages(): array
+    {
+        return [
+            'index' => ListReferralCommissions::route('/'),
+        ];
+    }
+}
diff --git a/app/Filament/Resources/ReferralCommissions/Tables/ReferralCommissionsTable.php b/app/Filament/Resources/ReferralCommissions/Tables/ReferralCommissionsTable.php
new file mode 100644
index 0000000..e947e90
--- /dev/null

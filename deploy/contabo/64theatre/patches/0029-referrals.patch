--- /dev/null
+++ b/app/Support/ReferralSettings.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Setting;
+
+/**
+ * The referral programme's rules, in a place the office can read them.
+ *
+ * Everything defaults to OFF or ZERO. A commission scheme that switches itself
+ * on because somebody deployed a patch would be promising strangers money the
+ * theatre never agreed to pay.
+ */
+class ReferralSettings
+{
+    public const KEY_ENABLED = 'referrals.enabled';
+
+    public const KEY_PERCENT = 'referrals.percent';
+
+    public const KEY_HOLD_HOURS = 'referrals.hold_hours';
+
+    public const KEY_PER_ORDER_CAP = 'referrals.per_order_cap_cents';
+
+    public const KEY_ALLOW_WITH_PROMO = 'referrals.allow_with_promo';
+
+    public const KEY_ON_DONATIONS = 'referrals.on_donations';
+
+    public static function enabled(): bool
+    {
+        return (string) (Setting::get(self::KEY_ENABLED) ?? '0') === '1';
+    }
+
+    /** House rate. A referrer may carry their own, for a negotiated deal. */
+    public static function percent(): float
+    {
+        return (float) (Setting::get(self::KEY_PERCENT) ?? 0);
+    }
+
+    /**
+     * How long after the performance before commission may be paid.
+     *
+     * Anchored to the show, not the sale: a hold measured from the order would
+     * mature on a production cancelled weeks later, and the theatre would have
+     * paid commission on tickets it then refunded.
+     */
+    public static function holdHours(): int
+    {
+        return (int) (Setting::get(self::KEY_HOLD_HOURS) ?? 48);
+    }
+
+    /**
+     * Most any single order can earn. Without it, one group booking at
+     * KES 12,000 becomes an unexpectedly large payment to a stranger.
+     */
+    public static function perOrderCapCents(): int
+    {
+        return (int) (Setting::get(self::KEY_PER_ORDER_CAP) ?? 0); // 0 = no cap
+    }
+
+    /**
+     * Whether a discounted order still earns. Off by default: a promo code and
+     * a commission on the same sale can take the margin below zero, and the
+     * honest response is to drop the attribution rather than pay quietly.
+     */
+    public static function allowWithPromo(): bool
+    {
+        return (string) (Setting::get(self::KEY_ALLOW_WITH_PROMO) ?? '0') === '1';
+    }
+
+    /** Donations are gifts to the theatre. Paying a cut of one is a different
+        proposition entirely, so it is off unless somebody decides otherwise. */
+    public static function onDonations(): bool
+    {
+        return (string) (Setting::get(self::KEY_ON_DONATIONS) ?? '0') === '1';
+    }
+}

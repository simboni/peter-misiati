@@ -0,0 +1,34 @@
+<?php
+
+namespace App\Filament\Resources\ReferralCommissions\Pages;
+
+use App\Filament\Resources\ReferralCommissions\ReferralCommissionResource;
+use App\Models\ReferralCommission;
+use Filament\Resources\Pages\ListRecords;
+
+class ListReferralCommissions extends ListRecords
+{
+    protected static string $resource = ReferralCommissionResource::class;
+
+    /**
+     * The one number somebody comes to this page for: what the theatre owes
+     * right now. Shown as a sentence rather than a widget — it is a single
+     * figure, and a chart of it would say less.
+     */
+    public function getSubheading(): ?string
+    {
+        $ready = (int) ReferralCommission::where('status', 'payable')->sum('amount_cents');
+        $held = (int) ReferralCommission::where('status', 'earned')->sum('amount_cents');
+        $claw = (int) ReferralCommission::where('clawback_cents', '>', 0)->sum('clawback_cents');
+
+        $line = 'Ready to pay: KES '.number_format($ready / 100)
+            .' · held until after the shows: KES '.number_format($held / 100);
+
+        if ($claw > 0) {
+            $line .= ' · owed back to us: KES '.number_format($claw / 100)
+                .' (commission paid on sales that were later refunded — net it off the next payout)';
+        }
+
+        return $line.'. Money goes out by M-Pesa, by hand; this records it.';
+    }
+}
diff --git a/app/Filament/Resources/ReferralCommissions/ReferralCommissionResource.php b/app/Filament/Resources/ReferralCommissions/ReferralCommissionResource.php

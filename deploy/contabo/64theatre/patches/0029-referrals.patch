diff --git a/tests/Feature/ReferralAdminTest.php b/tests/Feature/ReferralAdminTest.php
new file mode 100644
index 0000000..cb910bb
--- /dev/null
+++ b/tests/Feature/ReferralAdminTest.php
@@ -0,0 +1,191 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Filament\Resources\ReferralCommissions\Pages\ListReferralCommissions;
+use App\Filament\Resources\Referrers\Pages\ListReferrers;
+use App\Models\Payment;
+use App\Models\ReferralCommission;
+use App\Models\Referrer;
+use App\Models\Setting;
+use App\Models\TicketType;
+use App\Models\User;
+use App\Services\Checkout;
+use App\Services\Referrals;
+use App\Support\ReferralSettings;
+use Filament\Actions\Testing\TestAction;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+use Tests\TestCase;
+
+/**
+ * The office side of referrals.
+ *
+ * Mostly these assert that the pages load. That sounds thin and is not: a
+ * Filament screen fails at render, not at compile, so a wrong column name or a
+ * mistyped icon is a 500 the first time somebody opens it — and these three
+ * screens are where commission gets approved and marked paid.
+ */
+class ReferralAdminTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        Setting::put(ReferralSettings::KEY_ENABLED, '1');
+        Setting::put(ReferralSettings::KEY_PERCENT, '10');
+    }
+
+    private function admin(string $role = 'super_admin'): User
+    {
+        return User::factory()->create(['role' => $role]);
+    }
+
+    public function test_the_three_referral_screens_load(): void
+    {
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        $this->actingAs($this->admin())->get('/admin/referrers')->assertOk();
+        $this->actingAs($this->admin())->get('/admin/referral-commissions')->assertOk();
+        $this->actingAs($this->admin())->get('/admin/referral-programme')->assertOk();
+    }
+
+    public function test_the_commission_list_loads_with_rows_on_it(): void
+    {
+        // An empty table hides every formatting mistake in it.
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        // Through the real sale path: a hand-built row could carry a shape
+        // accrual never produces, and then the screen would be tested against
+        // data it will never see.
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $order = app(Checkout::class)->startOrder(
+            items: [$type->id => 2], phone: '0799888777', name: 'Buyer', referrer: $referrer,
+        );
+        $payment = Payment::create([
+            'order_id' => $order->id, 'gateway' => 'cash', 'gateway_ref' => 'C-'.uniqid(),
+            'amount_cents' => $order->total_cents, 'status' => 'initiated',
+        ]);
+        app(Checkout::class)->confirm($order, $payment);
+
+        ReferralCommission::first()->update(['status' => 'payable']);
+
+        $this->actingAs($this->admin())
+            ->get('/admin/referral-commissions')
+            ->assertOk()
+            ->assertSee('Mercy');
+    }
+
+    public function test_gate_staff_and_door_roles_cannot_reach_any_of_it(): void
+    {
+        // Who may sell on commission is a commercial decision, and marking
+        // commission paid is a money one. Neither belongs at the door.
+        foreach (['gate_staff', 'event_manager'] as $role) {
+            $user = $this->admin($role);
+            $this->actingAs($user)->get('/admin/referrers')->assertForbidden();
+            $this->actingAs($user)->get('/admin/referral-commissions')->assertForbidden();
+            $this->actingAs($user)->get('/admin/referral-programme')->assertForbidden();
+        }
+    }
+
+    public function test_only_a_super_admin_may_change_the_terms(): void
+    {
+        // Finance can see what is owed and record a payout; changing the rate
+        // or switching the programme on is a promise to the public.
+        $this->actingAs($this->admin('finance'))->get('/admin/referral-commissions')->assertOk();
+        $this->actingAs($this->admin('finance'))->get('/admin/referral-programme')->assertForbidden();
+    }
+
+    public function test_approving_a_seller_activates_them_and_is_logged(): void
+    {
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $this->assertSame('pending', $referrer->status);
+
+        Livewire::actingAs($this->admin())
+            ->test(ListReferrers::class)
+            ->callAction(TestAction::make('approve')->table($referrer));
+
+        $referrer->refresh();
+        $this->assertSame('active', $referrer->status);
+        $this->assertNotNull($referrer->approved_at);
+        $this->assertNotNull($referrer->approved_by);
+
+        $this->assertDatabaseHas('audit_logs', [
+            'action' => 'referrer.approved',
+            'subject_id' => $referrer->id,
+        ]);
+    }
+
+    public function test_recording_a_payout_is_offered_only_once_it_is_due(): void
+    {
+        $commission = $this->aCommission();
+
+        // 'earned' means the show has not happened yet. Paying then is the
+        // mistake the two states exist to prevent, so the action is not there.
+        Livewire::actingAs($this->admin())
+            ->test(ListReferralCommissions::class)
+            ->assertActionHidden(TestAction::make('markPaid')->table($commission));
+
+        $commission->update(['status' => 'payable']);
+
+        Livewire::actingAs($this->admin())
+            ->test(ListReferralCommissions::class)
+            ->callAction(TestAction::make('markPaid')->table($commission));
+
+        $commission->refresh();
+        $this->assertSame('paid', $commission->status);
+        $this->assertNotNull($commission->paid_at);
+        $this->assertDatabaseHas('audit_logs', ['action' => 'referral_commission.paid']);
+    }
+
+    public function test_voiding_a_commission_needs_a_reason_and_keeps_it(): void
+    {
+        $commission = $this->aCommission();
+
+        Livewire::actingAs($this->admin())
+            ->test(ListReferralCommissions::class)
+            ->callAction(TestAction::make('void')->table($commission), ['reason' => 'Claimed a sale they did not bring']);
+
+        $commission->refresh();
+        $this->assertSame('void', $commission->status);
+        $this->assertSame('Claimed a sale they did not bring', $commission->void_reason);
+        $this->assertNotNull($commission->voided_at);
+    }
+
+    /** A commission produced by the real sale path, so it has a real shape. */
+    private function aCommission(): ReferralCommission
+    {
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $order = app(Checkout::class)->startOrder(
+            items: [$type->id => 2], phone: '0799888777', name: 'Buyer', referrer: $referrer,
+        );
+        $payment = Payment::create([
+            'order_id' => $order->id, 'gateway' => 'cash', 'gateway_ref' => 'C-'.uniqid(),
+            'amount_cents' => $order->total_cents, 'status' => 'initiated',
+        ]);
+        app(Checkout::class)->confirm($order, $payment);
+
+        return ReferralCommission::firstOrFail();
+    }
+
+    public function test_adding_a_seller_by_hand_mints_a_code(): void
+    {
+        Livewire::actingAs($this->admin())
+            ->test(ListReferrers::class)
+            ->callAction('add', ['name' => 'Otieno', 'phone' => '0722333444']);
+
+        $referrer = Referrer::where('phone', '254722333444')->first();
+        $this->assertNotNull($referrer);
+        $this->assertNotEmpty($referrer->code);
+        $this->assertNotEmpty($referrer->uuid);
+        // Added by the office, still pending: approving is a separate, logged
+        // decision even when the office typed the name in itself.
+        $this->assertSame('pending', $referrer->status);
+    }
+}
diff --git a/tests/Feature/ReferralPublicTest.php b/tests/Feature/ReferralPublicTest.php
new file mode 100644
index 0000000..8ded873
--- /dev/null
+++ b/tests/Feature/ReferralPublicTest.php
@@ -0,0 +1,211 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Http\Middleware\CaptureReferral;
+use App\Models\Order;
+use App\Models\Referrer;
+use App\Models\Setting;
+use App\Models\TicketType;
+use App\Services\Referrals;
+use App\Support\PaymentSettings;
+use App\Support\ReferralSettings;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Queue;
+use Illuminate\Support\Str;
+use Tests\TestCase;
+
+/**
+ * The public side: signing up, being attributed, and seeing the total.
+ *
+ * ReferralTest covers the money rules. This covers the surfaces a stranger
+ * actually touches, because every rule in there depends on an order having
+ * been stamped with a referrer in the first place.
+ */
+class ReferralPublicTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        Queue::fake();
+        Setting::put(ReferralSettings::KEY_ENABLED, '1');
+        Setting::put(ReferralSettings::KEY_PERCENT, '10');
+    }
+
+    public function test_the_signup_page_is_closed_while_the_programme_is_off(): void
+    {
+        Setting::put(ReferralSettings::KEY_ENABLED, '0');
+
+        // Not a polite empty page. While it is off nothing accrues, so a form
+        // that still worked would be collecting phone numbers against a
+        // promise of money nobody has agreed to pay.
+        $this->get('/sell-tickets')->assertNotFound();
+        $this->post('/sell-tickets', [])->assertNotFound();
+    }
+
+    public function test_somebody_can_sign_up_and_lands_on_their_own_page(): void
+    {
+        $response = $this->post('/sell-tickets', [
+            'name' => 'Mercy Wanjiru',
+            'phone' => '0712 345 678',
+            'terms' => '1',
+        ]);
+
+        $referrer = Referrer::first();
+        $this->assertNotNull($referrer);
+        $response->assertRedirect(route('referrals.dashboard', $referrer->uuid));
+
+        // Canonical, because the phone is the identity and is what catches a
+        // self-referral later.
+        $this->assertSame('254712345678', $referrer->phone);
+        // Pending: a programme that enrols itself is one anyone can point at
+        // a sale that was coming anyway.
+        $this->assertSame('pending', $referrer->status);
+        $this->assertNotNull($referrer->terms_accepted_at);
+        $this->assertNotNull($referrer->code);
+        $this->assertSame('254712345678', $referrer->payout_phone);
+    }
+
+    public function test_signing_up_without_accepting_the_terms_is_refused(): void
+    {
+        $this->post('/sell-tickets', ['name' => 'Mercy', 'phone' => '0712345678'])
+            ->assertSessionHasErrors('terms');
+
+        $this->assertSame(0, Referrer::count());
+    }
+
+    public function test_signing_up_twice_hands_back_the_same_code(): void
+    {
+        $this->post('/sell-tickets', ['name' => 'Mercy', 'phone' => '0712345678', 'terms' => '1']);
+        $first = Referrer::first();
+
+        // Typed differently, same human. A second code would be worse than an
+        // error: the first one is already circulating on WhatsApp.
+        $this->post('/sell-tickets', ['name' => 'Mercy W', 'phone' => '+254 712 345 678', 'terms' => '1'])
+            ->assertRedirect(route('referrals.dashboard', $first->uuid));
+
+        $this->assertSame(1, Referrer::count());
+        $this->assertSame($first->code, Referrer::first()->code);
+    }
+
+    public function test_two_sellers_get_different_codes(): void
+    {
+        $this->post('/sell-tickets', ['name' => 'Mercy', 'phone' => '0712345678', 'terms' => '1']);
+        $this->post('/sell-tickets', ['name' => 'Mercy', 'phone' => '0722333444', 'terms' => '1']);
+
+        $codes = Referrer::pluck('code');
+        $this->assertCount(2, $codes->unique());
+    }
+
+    public function test_their_page_shows_the_link_and_the_total(): void
+    {
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        $this->get(route('referrals.dashboard', $referrer->uuid))
+            ->assertOk()
+            ->assertSee($referrer->code)
+            ->assertSee('?ref='.$referrer->code, escape: false)
+            ->assertSee('Ready to be paid');
+    }
+
+    public function test_a_pending_seller_is_told_plainly_that_it_does_not_earn_yet(): void
+    {
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+
+        $this->get(route('referrals.dashboard', $referrer->uuid))
+            ->assertOk()
+            ->assertSee('Waiting for approval');
+    }
+
+    public function test_an_unknown_page_is_not_found(): void
+    {
+        $this->get('/r/'.Str::uuid())->assertNotFound();
+    }
+
+    public function test_following_a_link_sets_the_first_touch_cookie(): void
+    {
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        $this->get('/?ref='.$referrer->code)->assertCookie(CaptureReferral::COOKIE, $referrer->code);
+    }
+
+    public function test_a_junk_code_is_never_stored(): void
+    {
+        // A revoked or mistyped code must not sit in somebody's browser for a
+        // month pretending to be worth something.
+        $this->get('/?ref=NOTACODE')->assertCookieMissing(CaptureReferral::COOKIE);
+    }
+
+    public function test_a_pending_sellers_code_is_not_stored_either(): void
+    {
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+
+        $this->get('/?ref='.$referrer->code)->assertCookieMissing(CaptureReferral::COOKIE);
+    }
+
+    public function test_the_cookie_is_not_overwritten_by_a_second_link(): void
+    {
+        $first = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $first->update(['status' => 'active']);
+        $second = app(Referrals::class)->register(['name' => 'Otieno', 'phone' => '0722333444']);
+        $second->update(['status' => 'active']);
+
+        // FIRST TOUCH. A forwarded link must not let whoever reshared it last
+        // take the commission from whoever actually found the buyer.
+        $this->withCookie(CaptureReferral::COOKIE, $first->code)
+            ->get('/?ref='.$second->code)
+            ->assertCookieMissing(CaptureReferral::COOKIE);
+    }
+
+    public function test_an_order_placed_with_the_cookie_is_attributed(): void
+    {
+        Setting::put(PaymentSettings::KEY_GATEWAY, 'fake');
+        Setting::put(PaymentSettings::KEY_ONLINE_ENABLED, '1');
+
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        $type = TicketType::factory()->create(['quantity_total' => 10, 'price_cents' => 50000]);
+
+        $this->withCookie(CaptureReferral::COOKIE, $referrer->code)
+            ->post('/orders', [
+                'phone' => '0799888777',
+                'email' => 'buyer@example.com',
+                'quantities' => [$type->id => 2],
+            ]);
+
+        $order = Order::latest('id')->first();
+        $this->assertNotNull($order);
+        $this->assertSame($referrer->id, $order->referrer_id);
+        // Frozen as clicked, so the order still says which link brought the
+        // buyer even if the code is later changed.
+        $this->assertSame($referrer->code, $order->referral_code);
+    }
+
+    public function test_an_order_placed_with_a_revoked_code_is_not_attributed(): void
+    {
+        Setting::put(PaymentSettings::KEY_GATEWAY, 'fake');
+        Setting::put(PaymentSettings::KEY_ONLINE_ENABLED, '1');
+
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+        $type = TicketType::factory()->create(['quantity_total' => 10, 'price_cents' => 50000]);
+
+        // Blocked between the click and the purchase. The code is re-checked
+        // at checkout, not trusted from the cookie.
+        $referrer->update(['status' => 'blocked']);
+
+        $this->withCookie(CaptureReferral::COOKIE, $referrer->code)
+            ->post('/orders', [
+                'phone' => '0799888777',
+                'email' => 'buyer@example.com',
+                'quantities' => [$type->id => 1],
+            ]);
+
+        $this->assertNull(Order::latest('id')->first()?->referrer_id);
+    }
+}
diff --git a/tests/Feature/ReferralTest.php b/tests/Feature/ReferralTest.php
new file mode 100644
index 0000000..abb39d0
--- /dev/null
+++ b/tests/Feature/ReferralTest.php
@@ -0,0 +1,216 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Customer;
+use App\Models\Payment;
+use App\Models\PromoCode;
+use App\Models\ReferralCommission;
+use App\Models\Referrer;
+use App\Models\Setting;
+use App\Models\TicketType;
+use App\Services\Checkout;
+use App\Services\Referrals;
+use App\Services\Refunds;
+use App\Support\ReferralSettings;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Queue;
+use Illuminate\Support\Str;
+use Tests\TestCase;
+
+class ReferralTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        Queue::fake();
+        Setting::put(ReferralSettings::KEY_ENABLED, '1');
+        Setting::put(ReferralSettings::KEY_PERCENT, '10');
+    }
+
+    private function referrer(array $attrs = []): Referrer
+    {
+        return Referrer::create(array_merge([
+            'uuid' => (string) Str::uuid(),
+            'code' => 'SELL'.strtoupper(Str::random(4)),
+            'name' => 'Mercy',
+            'phone' => '254700111'.random_int(100, 999),
+            'status' => 'active',
+        ], $attrs));
+    }
+
+    private function buy(TicketType $type, ?Referrer $ref, string $phone = '0712345678', int $qty = 2)
+    {
+        $order = app(Checkout::class)->startOrder(
+            items: [$type->id => $qty], phone: $phone, name: 'Buyer', referrer: $ref,
+        );
+        $payment = Payment::create([
+            'order_id' => $order->id, 'gateway' => 'cash', 'gateway_ref' => 'C-'.uniqid(),
+            'amount_cents' => $order->total_cents, 'status' => 'initiated',
+        ]);
+
+        return app(Checkout::class)->confirm($order, $payment);
+    }
+
+    public function test_a_referred_sale_earns_commission_at_the_house_rate(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $order = $this->buy($type, $this->referrer());
+
+        $c = ReferralCommission::first();
+        $this->assertNotNull($c);
+        $this->assertSame(100000, (int) $c->base_cents);   // 2 x KES 500
+        $this->assertSame(10000, (int) $c->amount_cents);  // 10%
+        $this->assertSame('earned', $c->status);
+        // Frozen, so a later rate change cannot rewrite this sale.
+        $this->assertSame('10.00', (string) $c->rate_percent);
+    }
+
+    public function test_an_unreferred_sale_earns_nothing(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $this->buy($type, null);
+
+        $this->assertSame(0, ReferralCommission::count());
+    }
+
+    public function test_commission_is_not_earned_twice_on_one_order(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $order = $this->buy($type, $this->referrer());
+
+        // A second confirm — the shape of a callback and a status poll both
+        // landing — must not pay twice.
+        $payment = $order->payments()->first();
+        app(Checkout::class)->confirm($order->fresh(), $payment);
+
+        $this->assertSame(1, ReferralCommission::count());
+    }
+
+    public function test_buying_through_your_own_link_earns_nothing(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $ref = $this->referrer(['phone' => '254712345678']);
+
+        // Same human, same phone, different formatting.
+        $this->buy($type, $ref, phone: '0712345678');
+
+        $this->assertSame(0, ReferralCommission::count());
+    }
+
+    public function test_a_linked_customer_is_also_self_referral(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $customer = Customer::create(['phone' => '254733444555', 'name' => 'Mercy']);
+        $ref = $this->referrer(['customer_id' => $customer->id, 'phone' => '254799888777']);
+
+        $this->buy($type, $ref, phone: '0733444555');
+
+        $this->assertSame(0, ReferralCommission::count());
+    }
+
+    public function test_a_referrer_who_is_not_approved_earns_nothing(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $this->buy($type, $this->referrer(['status' => 'pending']));
+
+        $this->assertSame(0, ReferralCommission::count());
+    }
+
+    public function test_the_programme_being_off_earns_nothing(): void
+    {
+        Setting::put(ReferralSettings::KEY_ENABLED, '0');
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $this->buy($type, $this->referrer());
+
+        $this->assertSame(0, ReferralCommission::count());
+    }
+
+    public function test_a_per_order_cap_limits_a_large_booking(): void
+    {
+        Setting::put(ReferralSettings::KEY_PER_ORDER_CAP, '5000'); // KES 50
+        $type = TicketType::factory()->create(['price_cents' => 1200000]); // a group
+        $this->buy($type, $this->referrer(), qty: 1);
+
+        // 10% of KES 12,000 is 1,200 — capped to 50.
+        $this->assertSame(5000, (int) ReferralCommission::first()->amount_cents);
+    }
+
+    public function test_a_refund_voids_unpaid_commission(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $order = $this->buy($type, $this->referrer());
+
+        app(Refunds::class)->refund($order->fresh(), 'Show cancelled');
+
+        $c = ReferralCommission::first();
+        $this->assertSame('void', $c->status);
+        $this->assertNotNull($c->voided_at);
+    }
+
+    public function test_a_refund_after_payout_becomes_a_clawback_not_a_negative(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $order = $this->buy($type, $this->referrer());
+
+        ReferralCommission::first()->update(['status' => 'paid', 'paid_at' => now()]);
+        app(Refunds::class)->refund($order->fresh(), 'Duplicate payment');
+
+        $c = ReferralCommission::first();
+        // Already handed over, so it cannot simply vanish — it is owed back.
+        $this->assertSame('paid', $c->status);
+        $this->assertSame(10000, (int) $c->clawback_cents);
+    }
+
+    public function test_commission_matures_only_after_the_show_and_only_if_still_paid(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $type->performance->update(['starts_at' => now()->subDays(5)]);
+
+        $order = $this->buy($type, $this->referrer());
+        ReferralCommission::first()->update(['payable_at' => now()->subHour()]);
+
+        $this->assertSame(1, app(Referrals::class)->promote());
+        $this->assertSame('payable', ReferralCommission::first()->status);
+    }
+
+    public function test_a_refunded_order_never_matures(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        $type->performance->update(['starts_at' => now()->subDays(5)]);
+
+        $order = $this->buy($type, $this->referrer());
+        app(Refunds::class)->refund($order->fresh(), 'Refunded before the hold elapsed');
+        ReferralCommission::first()->update(['payable_at' => now()->subHour()]);
+
+        // The promotion pass re-checks the order rather than trusting the
+        // earlier decision. This is the rule the whole design exists for.
+        $this->assertSame(0, app(Referrals::class)->promote());
+        $this->assertNotSame('payable', ReferralCommission::first()->status);
+    }
+
+    public function test_a_promo_coded_order_earns_nothing_unless_allowed(): void
+    {
+        $type = TicketType::factory()->create(['price_cents' => 50000]);
+        PromoCode::factory()->create([
+            'organiser_id' => $type->performance->event->organiser_id,
+            'code' => 'HALF', 'type' => 'percent', 'value' => 50,
+        ]);
+
+        $order = app(Checkout::class)->startOrder(
+            items: [$type->id => 2], phone: '0712345678',
+            promoCode: 'HALF', referrer: $this->referrer(),
+        );
+        $payment = Payment::create([
+            'order_id' => $order->id, 'gateway' => 'cash', 'gateway_ref' => 'P-'.uniqid(),
+            'amount_cents' => $order->total_cents, 'status' => 'initiated',
+        ]);
+        app(Checkout::class)->confirm($order, $payment);
+
+        // A discount and a commission on the same sale can take the margin
+        // below zero, so attribution is dropped rather than paid quietly.
+        $this->assertSame(0, ReferralCommission::count());
+    }
+}

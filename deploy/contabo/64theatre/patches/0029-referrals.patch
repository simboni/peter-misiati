diff --git a/app/Services/Referrals.php b/app/Services/Referrals.php
new file mode 100644
index 0000000..375818d
--- /dev/null
+++ b/app/Services/Referrals.php
@@ -0,0 +1,273 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Customer;
+use App\Models\Order;
+use App\Models\Payment;
+use App\Models\ReferralCommission;
+use App\Models\Referrer;
+use App\Support\Phone;
+use App\Support\ReferralSettings;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Str;
+
+/**
+ * Who earned what, and when it is safe to hand it over.
+ *
+ * The whole policy lives here rather than being spread across a controller, a
+ * listener and a report. There is one hook into the money path —
+ * Checkout::confirm() — and one out of it, Refunds. Everything else reads.
+ *
+ * THE RULE THIS EXISTS TO ENFORCE: commission must never be payable on money
+ * that went back. Earning and being payable are separate states for exactly
+ * that reason, and the refund path voids or claws back rather than ignoring it.
+ */
+class Referrals
+{
+    /**
+     * Sign somebody up to sell.
+     *
+     * Returns the EXISTING referrer when the phone is already registered,
+     * rather than failing on the unique index. Somebody who forgot they signed
+     * up should be handed their link back, not an error page — and a second
+     * signup must never mint a second code, because the first one is already
+     * in circulation on WhatsApp.
+     *
+     * Status is 'pending'. The link works immediately for walking around with,
+     * but earns nothing until the theatre approves the person, because a
+     * commission scheme that enrols itself is a commission scheme anyone can
+     * point at a sale that was coming anyway.
+     */
+    public function register(array $data): Referrer
+    {
+        $phone = Phone::normalise($data['phone'] ?? null) ?? trim((string) ($data['phone'] ?? ''));
+
+        if ($existing = Referrer::where('phone', $phone)->first()) {
+            return $existing;
+        }
+
+        $payout = Phone::normalise($data['payout_phone'] ?? null);
+
+        return Referrer::create([
+            'uuid' => (string) Str::uuid(),
+            'code' => $this->mintCode($data['name'] ?? ''),
+            'name' => trim((string) ($data['name'] ?? '')),
+            'phone' => $phone,
+            'email' => filled($data['email'] ?? null) ? trim((string) $data['email']) : null,
+            'payout_phone' => $payout ?? $phone,
+            'mpesa_name' => filled($data['mpesa_name'] ?? null) ? trim((string) $data['mpesa_name']) : null,
+            'status' => 'pending',
+            'terms_accepted_at' => now(),
+            // Links the seller to their own buying history, so buying through
+            // your own link is caught even if you use a different number.
+            'customer_id' => Customer::where('phone', $phone)->value('id'),
+        ]);
+    }
+
+    /**
+     * A code somebody can say out loud.
+     *
+     * Built from their name so it means something to them, with four random
+     * characters so two Mercys do not collide. I, O, 0 and 1 are left out:
+     * these get read off a phone screen and typed by someone else.
+     */
+    private function mintCode(string $name): string
+    {
+        $stem = strtoupper(preg_replace('/[^A-Za-z]/', '', strtok(trim($name), ' ') ?: ''));
+        $stem = substr($stem, 0, 8) ?: 'SELL';
+        $alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
+
+        for ($attempt = 0; $attempt < 40; $attempt++) {
+            $suffix = '';
+
+            for ($i = 0; $i < 4; $i++) {
+                $suffix .= $alphabet[random_int(0, strlen($alphabet) - 1)];
+            }
+
+            $code = $stem.$suffix;
+
+            if (! Referrer::where('code', $code)->exists()) {
+                return $code;
+            }
+        }
+
+        // Forty collisions on a 32^4 space means something is wrong with the
+        // randomness, not with luck. A uuid is ugly but it is never taken.
+        return strtoupper(Str::random(12));
+    }
+
+    /** Resolve a ?ref= code to a referrer who is actually allowed to earn. */
+    public function byCode(?string $code): ?Referrer
+    {
+        if (! ReferralSettings::enabled() || blank($code)) {
+            return null;
+        }
+
+        $referrer = Referrer::where('code', strtoupper(trim($code)))->first();
+
+        return $referrer?->isActive() ? $referrer : null;
+    }
+
+    /**
+     * Record what this order earned, at the moment money actually landed.
+     *
+     * Called from inside Checkout::confirm()'s transaction, so a commission
+     * cannot exist for a sale that rolled back. The unique index on order_id
+     * is the backstop if a future path ever confirms the same order twice.
+     */
+    public function accrue(Order $order, Payment $payment): ?ReferralCommission
+    {
+        if (! ReferralSettings::enabled() || ! $order->referrer_id) {
+            return null;
+        }
+
+        if (ReferralCommission::where('order_id', $order->id)->exists()) {
+            return null;    // already earned; never twice
+        }
+
+        $referrer = $order->referrer;
+
+        if (! $referrer?->isActive() || $this->isSelfReferral($order, $referrer)) {
+            return null;
+        }
+
+        if ($order->type === 'donation' && ! ReferralSettings::onDonations()) {
+            return null;
+        }
+
+        if ($order->promo_code && ! ReferralSettings::allowWithPromo()) {
+            return null;
+        }
+
+        $rate = (float) ($referrer->commission_percent ?? ReferralSettings::percent());
+
+        if ($rate <= 0) {
+            return null;
+        }
+
+        // Based on what was COLLECTED, not what was invoiced. PayHero sends
+        // whole shillings, so an order whose total carries cents is paid
+        // slightly short, and commission on the invoice would exceed the cut
+        // of money that actually arrived.
+        $base = min((int) $payment->amount_cents, (int) $order->total_cents);
+        $amount = (int) round($base * $rate / 100);
+
+        if ($cap = ReferralSettings::perOrderCapCents()) {
+            $amount = min($amount, $cap);
+        }
+
+        if ($amount <= 0) {
+            return null;
+        }
+
+        return ReferralCommission::create([
+            'uuid' => (string) Str::uuid(),
+            'referrer_id' => $referrer->id,
+            'order_id' => $order->id,
+            'organiser_id' => $order->organiser_id,
+            'performance_id' => $order->performance_id,
+            'base_cents' => $base,
+            // Frozen: a rate change next month must not rewrite what was
+            // agreed on this sale.
+            'rate_percent' => $rate,
+            'amount_cents' => $amount,
+            'status' => 'earned',
+            'earned_at' => now(),
+            'payable_at' => $this->payableFrom($order),
+        ]);
+    }
+
+    /**
+     * Money went back, so the commission must not stand.
+     *
+     * Not yet paid → void it. Already paid → record a clawback, which the next
+     * payout nets off. The money columns are unsigned, so a clawback is its own
+     * field rather than a negative amount.
+     */
+    public function reverse(Order $order, string $reason): void
+    {
+        $commission = ReferralCommission::where('order_id', $order->id)->first();
+
+        if (! $commission || $commission->status === 'void') {
+            return;
+        }
+
+        if ($commission->status === 'paid') {
+            $commission->update([
+                'clawback_cents' => $commission->amount_cents,
+                'void_reason' => $reason,
+            ]);
+
+            return;
+        }
+
+        $commission->update([
+            'status' => 'void',
+            'voided_at' => now(),
+            'void_reason' => $reason,
+        ]);
+    }
+
+    /**
+     * Promote commissions that have matured. Run from the scheduler.
+     *
+     * Re-checks the order on every pass rather than trusting the earlier
+     * decision: an order refunded since accrual must not become payable
+     * because a timestamp elapsed.
+     */
+    public function promote(): int
+    {
+        $promoted = 0;
+
+        ReferralCommission::where('status', 'earned')
+            ->whereNotNull('payable_at')
+            ->where('payable_at', '<=', now())
+            ->with('order')
+            ->each(function (ReferralCommission $c) use (&$promoted) {
+                if ($c->order?->status !== 'paid') {
+                    return;
+                }
+
+                $c->update(['status' => 'payable']);
+                $promoted++;
+            });
+
+        return $promoted;
+    }
+
+    /**
+     * Somebody buying through their own link.
+     *
+     * Not an edge case — it is the first thing anyone tries. Matched on the
+     * canonical phone and the linked customer, because those are the two
+     * things a referrer cannot change about a purchase they made themselves.
+     */
+    public function isSelfReferral(Order $order, Referrer $referrer): bool
+    {
+        if ($referrer->customer_id && $referrer->customer_id === $order->customer_id) {
+            return true;
+        }
+
+        $customerPhone = $order->customer?->phone;
+
+        if ($customerPhone && Phone::normaliseOrKeep($customerPhone) === Phone::normaliseOrKeep($referrer->phone)) {
+            return true;
+        }
+
+        // A walk-up at the desk was not brought in by a link.
+        return $order->channel === 'box_office';
+    }
+
+    /** The earliest a commission on this order may be handed over. */
+    private function payableFrom(Order $order): ?Carbon
+    {
+        $starts = $order->performance?->starts_at;
+
+        if (! $starts) {
+            return now()->addHours(ReferralSettings::holdHours());
+        }
+
+        return $starts->copy()->addHours(ReferralSettings::holdHours());
+    }
+}

--- /dev/null
+++ b/app/Filament/Resources/Referrers/ReferrerResource.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Filament\Resources\Referrers;
+
+use App\Filament\Resources\Referrers\Pages\EditReferrer;
+use App\Filament\Resources\Referrers\Pages\ListReferrers;
+use App\Filament\Resources\Referrers\Schemas\ReferrerForm;
+use App\Filament\Resources\Referrers\Tables\ReferrersTable;
+use App\Models\Referrer;
+use App\Support\Role;
+use BackedEnum;
+use Filament\Resources\Resource;
+use Filament\Schemas\Schema;
+use Filament\Support\Icons\Heroicon;
+use Filament\Tables\Table;
+
+/**
+ * The people selling tickets on commission.
+ *
+ * Signing up is public, at /sell-tickets, and arrives as `pending`. Approval
+ * happens HERE and nowhere else: a pending referrer holds a working link that
+ * earns nothing, which is the only arrangement that lets the theatre hand out
+ * links at a show without promising money to whoever picks one up.
+ *
+ * There is no create page. Adding somebody by hand goes through the same
+ * Referrals::register() the public form uses, so a hand-added seller cannot
+ * end up without a code or with somebody else's.
+ */
+class ReferrerResource extends Resource
+{
+    protected static ?string $model = Referrer::class;
+
+    protected static string|BackedEnum|null $navigationIcon = Heroicon::OutlinedMegaphone;
+
+    protected static string|\UnitEnum|null $navigationGroup = 'Marketing';
+
+    protected static ?string $recordTitleAttribute = 'name';
+
+    protected static ?string $modelLabel = 'seller';
+
+    protected static ?string $pluralModelLabel = 'sellers';
+
+    protected static ?int $navigationSort = 20;
+
+    /** Who is allowed to sell is a commercial decision, not a door one. */
+    public static function canAccess(): bool
+    {
+        return in_array(auth()->user()?->role, [
+            Role::SUPER_ADMIN, Role::FINANCE, Role::MARKETING,
+        ], true);
+    }
+
+    public static function canCreate(): bool
+    {
+        return false;   // use the "Add a seller" action — it mints the code
+    }
+
+    public static function form(Schema $schema): Schema
+    {
+        return ReferrerForm::configure($schema);
+    }
+
+    public static function table(Table $table): Table
+    {
+        return ReferrersTable::configure($table);
+    }
+
+    public static function getPages(): array
+    {
+        return [
+            'index' => ListReferrers::route('/'),
+            'edit' => EditReferrer::route('/{record}/edit'),
+        ];
+    }
+}

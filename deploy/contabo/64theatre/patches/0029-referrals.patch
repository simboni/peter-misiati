@@ -0,0 +1,48 @@
+<?php
+
+namespace App\Filament\Resources\Referrers\Pages;
+
+use App\Filament\Resources\Referrers\ReferrerResource;
+use App\Support\Phone;
+use Filament\Resources\Pages\EditRecord;
+
+class EditReferrer extends EditRecord
+{
+    protected static string $resource = ReferrerResource::class;
+
+    /**
+     * Canonicalise before saving, not after.
+     *
+     * The phone is both the unique key and how a self-referral is spotted. A
+     * number saved as "0712 345 678" matches nothing, so the person could then
+     * earn commission on their own tickets — quietly, and only until somebody
+     * noticed the pattern.
+     */
+    protected function mutateFormDataBeforeSave(array $data): array
+    {
+        if (filled($data['phone'] ?? null)) {
+            $data['phone'] = Phone::normalise($data['phone']) ?? trim((string) $data['phone']);
+        }
+
+        if (filled($data['payout_phone'] ?? null)) {
+            $data['payout_phone'] = Phone::normalise($data['payout_phone']) ?? trim((string) $data['payout_phone']);
+        }
+
+        if (filled($data['code'] ?? null)) {
+            $data['code'] = strtoupper(trim((string) $data['code']));
+        }
+
+        // Blank means "use the house rate", which is null and not zero. Zero
+        // would be a negotiated rate of nothing.
+        if (($data['commission_percent'] ?? '') === '') {
+            $data['commission_percent'] = null;
+        }
+
+        return $data;
+    }
+
+    protected function getRedirectUrl(): ?string
+    {
+        return $this->getResource()::getUrl('index');
+    }
+}

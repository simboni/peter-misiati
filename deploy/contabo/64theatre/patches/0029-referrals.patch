+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+/**
+ * One order's commission, and the three facts that are not the same thing:
+ * earned (money landed), payable (the show happened and the order still
+ * stands), paid (somebody sent it).
+ */
+class ReferralCommission extends Model
+{
+    protected $guarded = [];
+
+    protected function casts(): array
+    {
+        return [
+            'rate_percent' => 'decimal:2',
+            'earned_at' => 'datetime',
+            'payable_at' => 'datetime',
+            'paid_at' => 'datetime',
+            'voided_at' => 'datetime',
+        ];
+    }
+
+    public function referrer(): BelongsTo
+    {
+        return $this->belongsTo(Referrer::class);
+    }
+
+    public function order(): BelongsTo
+    {
+        return $this->belongsTo(Order::class);
+    }
+
+    public function performance(): BelongsTo
+    {
+        return $this->belongsTo(Performance::class);
+    }
+}
diff --git a/app/Models/Referrer.php b/app/Models/Referrer.php
new file mode 100644
index 0000000..018d005
--- /dev/null
+++ b/app/Models/Referrer.php
@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\HasMany;
+
+/**
+ * A member of the public who sells tickets for a cut.
+ *
+ * Not a User: staff roles can reach /admin and `users` carries a password, and
+ * a hundred strangers do not belong in the staff table. The phone is the
+ * identity, as it is for customers.
+ */
+class Referrer extends Model
+{
+    protected $guarded = [];
+
+    protected function casts(): array
+    {
+        return [
+            'commission_percent' => 'decimal:2',
+            'terms_accepted_at' => 'datetime',
+            'approved_at' => 'datetime',
+        ];
+    }
+
+    public function commissions(): HasMany
+    {
+        return $this->hasMany(ReferralCommission::class);
+    }
+
+    public function customer(): BelongsTo
+    {
+        return $this->belongsTo(Customer::class);
+    }
+
+    /** Only an approved referrer earns. A pending one has a code that does nothing. */
+    public function isActive(): bool
+    {
+        return $this->status === 'active';
+    }
+
+    public function earnedCents(): int
+    {
+        return (int) $this->commissions()->whereIn('status', ['earned', 'payable', 'paid'])->sum('amount_cents');
+    }
+
+    public function payableCents(): int
+    {
+        return (int) $this->commissions()->where('status', 'payable')->sum('amount_cents')
+            - (int) $this->commissions()->sum('clawback_cents');
+    }
+
+    public function paidCents(): int
+    {
+        return (int) $this->commissions()->where('status', 'paid')->sum('amount_cents');
+    }
+}

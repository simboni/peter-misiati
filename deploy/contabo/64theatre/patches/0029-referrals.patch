+<?php
+
+namespace App\Filament\Resources\Referrers\Schemas;
+
+use App\Support\ReferralSettings;
+use Filament\Forms\Components\TextInput;
+use Filament\Schemas\Components\Section;
+use Filament\Schemas\Schema;
+
+class ReferrerForm
+{
+    public static function configure(Schema $schema): Schema
+    {
+        return $schema->components([
+            Section::make('Who they are')
+                ->schema([
+                    TextInput::make('name')->required()->maxLength(80),
+                    TextInput::make('phone')
+                        ->label('Phone')
+                        ->required()
+                        ->maxLength(20)
+                        // Unique because the phone IS the identity here, the
+                        // same as it is for customers. Two rows for one person
+                        // means two codes, and the second sale is credited to
+                        // whichever row the buyer happened to click.
+                        ->unique(ignoreRecord: true)
+                        ->helperText('Canonical form, e.g. 254712345678. This is how a self-referral is spotted.'),
+                    TextInput::make('email')->email()->maxLength(120),
+                    TextInput::make('code')
+                        ->label('Referral code')
+                        ->required()
+                        ->maxLength(32)
+                        ->unique(ignoreRecord: true)
+                        ->helperText('CHANGING THIS BREAKS EVERY LINK ALREADY SHARED. Sales already recorded keep the old code on the order, so history stays readable — but anyone holding the old link stops being credited.'),
+                ])
+                ->columns(2),
+
+            Section::make('Getting paid')
+                ->schema([
+                    TextInput::make('payout_phone')
+                        ->label('M-Pesa number for payment')
+                        ->maxLength(20),
+                    TextInput::make('mpesa_name')
+                        ->label('Name registered on that number')
+                        ->maxLength(80)
+                        ->helperText('Check this against the M-Pesa confirmation before sending money.'),
+                    TextInput::make('kra_pin')
+                        ->label('KRA PIN')
+                        ->maxLength(20)
+                        // Not validated and not required: whether it is needed
+                        // at all is a question for an accountant, and a
+                        // required field would be this code pretending to
+                        // know the answer.
+                        ->helperText('Collected only if your accountant says commission payments need withholding tax handled. Nothing in the system uses it.'),
+                    TextInput::make('commission_percent')
+                        ->label('Their rate (%)')
+                        ->numeric()->minValue(0)->maxValue(100)->step('0.01')
+                        ->helperText('Leave blank to use the house rate, currently '
+                            .rtrim(rtrim(number_format(ReferralSettings::percent(), 2), '0'), '.')
+                            .'%. A rate set here applies to FUTURE sales only — commission already earned keeps the rate it was earned at.'),
+                ])
+                ->columns(2),
+        ]);
+    }
+}
diff --git a/app/Filament/Resources/Referrers/Tables/ReferrersTable.php b/app/Filament/Resources/Referrers/Tables/ReferrersTable.php
new file mode 100644
index 0000000..d7ac695
--- /dev/null
+++ b/app/Filament/Resources/Referrers/Tables/ReferrersTable.php
@@ -0,0 +1,183 @@
+<?php
+
+namespace App\Filament\Resources\Referrers\Tables;
+
+use App\Models\AuditLog;
+use App\Models\Referrer;
+use App\Support\Phone;
+use Filament\Actions\Action;
+use Filament\Actions\EditAction;
+use Filament\Notifications\Notification;
+use Filament\Tables\Columns\TextColumn;
+use Filament\Tables\Filters\SelectFilter;
+use Filament\Tables\Table;
+use Illuminate\Database\Eloquent\Builder;
+
+class ReferrersTable
+{
+    public static function configure(Table $table): Table
+    {
+        return $table
+            // Summed in the query, not per row: a hundred sellers each asking
+            // the commissions table for their own total is a hundred queries
+            // to draw one page.
+            ->modifyQueryUsing(fn (Builder $query) => $query
+                ->withCount(['commissions as sales_count' => fn (Builder $q) => $q->where('status', '!=', 'void')])
+                ->withSum(
+                    ['commissions as earned_cents' => fn (Builder $q) => $q->whereIn('status', ['earned', 'payable', 'paid'])],
+                    'amount_cents',
+                )
+                ->withSum(
+                    ['commissions as payable_cents' => fn (Builder $q) => $q->where('status', 'payable')],
+                    'amount_cents',
+                ))
+            ->defaultSort('created_at', 'desc')
+            ->columns([
+                TextColumn::make('name')
+                    ->searchable()
+                    ->description(fn (Referrer $r): string => Phone::forHumans($r->phone)),
+                TextColumn::make('code')
+                    ->label('Code')
+                    ->searchable()
+                    ->copyable()
+                    ->copyMessage('Code copied')
+                    ->fontFamily('mono'),
+                TextColumn::make('status')
+                    ->badge()
+                    ->color(fn (string $state): string => match ($state) {
+                        'active' => 'success',
+                        'pending' => 'warning',
+                        'paused' => 'gray',
+                        'blocked' => 'danger',
+                        default => 'gray',
+                    }),
+                TextColumn::make('commission_percent')
+                    ->label('Rate')
+                    ->formatStateUsing(fn (?string $state): string => $state === null
+                        ? 'house rate'
+                        : rtrim(rtrim(number_format((float) $state, 2), '0'), '.').'%'),
+                TextColumn::make('sales_count')
+                    ->label('Sales')
+                    ->sortable()
+                    ->alignEnd(),
+                TextColumn::make('earned_cents')
+                    ->label('Earned')
+                    ->sortable()
+                    ->alignEnd()
+                    ->formatStateUsing(fn (?int $state): string => 'KES '.number_format((int) $state / 100)),
+                TextColumn::make('payable_cents')
+                    ->label('Owed now')
+                    ->sortable()
+                    ->alignEnd()
+                    ->weight('bold')
+                    ->formatStateUsing(fn (?int $state): string => 'KES '.number_format((int) $state / 100))
+                    ->description(fn (Referrer $r): ?string => ($claw = (int) $r->commissions()->sum('clawback_cents')) > 0
+                        ? 'less KES '.number_format($claw / 100).' clawback'
+                        : null),
+                TextColumn::make('created_at')
+                    ->label('Signed up')
+                    ->date()
+                    ->sortable()
+                    ->toggleable(isToggledHiddenByDefault: true),
+            ])
+            ->filters([
+                SelectFilter::make('status')->options([
+                    'pending' => 'Waiting for approval',
+                    'active' => 'Active',
+                    'paused' => 'Paused',
+                    'blocked' => 'Blocked',
+                ]),
+            ])
+            ->recordActions([
+                /*
+                 * Approval is the switch that turns a link from a piece of
+                 * paper into a promise to pay somebody. It is one click, but
+                 * it is confirmed and it is logged with a name against it.
+                 */
+                Action::make('approve')
+                    ->label('Approve')
+                    ->icon('heroicon-o-check-circle')
+                    ->color('success')
+                    ->visible(fn (Referrer $r): bool => $r->status !== 'active')
+                    ->requiresConfirmation()
+                    ->modalHeading('Approve this seller')
+                    ->modalDescription('From now on, sales through their link earn commission. Sales made before this moment do not — they were not approved when the money landed.')
+                    ->action(function (Referrer $r): void {
+                        $was = $r->status;
+
+                        $r->update([
+                            'status' => 'active',
+                            'approved_at' => $r->approved_at ?? now(),
+                            'approved_by' => auth()->id(),
+                        ]);
+
+                        self::log($r, 'referrer.approved', $was);
+
+                        Notification::make()
+                            ->title($r->name.' can now earn')
+                            ->body('Their link is '.url('/').'?ref='.$r->code)
+                            ->success()
+                            ->send();
+                    }),
+
+                /*
+                 * Paused and blocked do the same thing to earning and mean
+                 * different things to a person. Paused is "not this season";
+                 * blocked is "we are not working with you". Both are kept
+                 * because the reason belongs in the record.
+                 */
+                Action::make('pause')
+                    ->label('Pause')
+                    ->icon('heroicon-o-pause-circle')
+                    ->color('gray')
+                    ->visible(fn (Referrer $r): bool => $r->status === 'active')
+                    ->requiresConfirmation()
+                    ->modalDescription('Their link keeps working as a link, but stops earning. Commission already earned is unaffected.')
+                    ->action(function (Referrer $r): void {
+                        $r->update(['status' => 'paused']);
+                        self::log($r, 'referrer.paused', 'active');
+                        Notification::make()->title('Paused')->success()->send();
+                    }),
+
+                Action::make('block')
+                    ->label('Block')
+                    ->icon('heroicon-o-no-symbol')
+                    ->color('danger')
+                    ->visible(fn (Referrer $r): bool => $r->status !== 'blocked')
+                    ->requiresConfirmation()
+                    ->modalHeading('Block this seller')
+                    ->modalDescription('Stops all future earning. It does NOT cancel commission already earned — if you mean not to pay that, void the individual commissions, so there is a record of the decision.')
+                    ->action(function (Referrer $r): void {
+                        $was = $r->status;
+                        $r->update(['status' => 'blocked']);
+                        self::log($r, 'referrer.blocked', $was);
+                        Notification::make()->title('Blocked')->success()->send();
+                    }),
+
+                Action::make('openPage')
+                    ->label('Their page')
+                    ->icon('heroicon-o-arrow-top-right-on-square')
+                    ->url(fn (Referrer $r): string => route('referrals.dashboard', $r->uuid))
+                    ->openUrlInNewTab(),
+
+                EditAction::make(),
+            ]);
+    }
+
+    private static function log(Referrer $referrer, string $action, ?string $was): void
+    {
+        AuditLog::create([
+            'user_id' => auth()->id(),
+            'organiser_id' => auth()->user()?->organiser_id,
+            'action' => $action,
+            'subject_type' => Referrer::class,
+            'subject_id' => $referrer->id,
+            'changes' => [
+                'from' => $was,
+                'to' => $referrer->status,
+                'code' => $referrer->code,
+                'phone' => $referrer->phone,
+            ],
+        ]);
+    }
+}

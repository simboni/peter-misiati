@@ -0,0 +1,65 @@
+<?php
+
+namespace App\Filament\Resources\Referrers\Pages;
+
+use App\Filament\Resources\Referrers\ReferrerResource;
+use App\Services\Referrals;
+use App\Support\ReferralSettings;
+use Filament\Actions\Action;
+use Filament\Forms\Components\TextInput;
+use Filament\Notifications\Notification;
+use Filament\Resources\Pages\ListRecords;
+use Filament\Support\Icons\Heroicon;
+
+class ListReferrers extends ListRecords
+{
+    protected static string $resource = ReferrerResource::class;
+
+    public function getSubheading(): ?string
+    {
+        if (! ReferralSettings::enabled()) {
+            return 'The referral programme is SWITCHED OFF. Links do not earn and /sell-tickets is not reachable. Turn it on under Marketing → Referral programme.';
+        }
+
+        return 'Anyone can sign up at '.url('/sell-tickets').' — they arrive here waiting for approval.';
+    }
+
+    protected function getHeaderActions(): array
+    {
+        return [
+            /*
+             * Adding somebody at the desk. Goes through the same register()
+             * the public form uses rather than a create form, because the code
+             * and the uuid have to be minted and a hand-typed code would
+             * eventually collide with a real one.
+             */
+            Action::make('add')
+                ->label('Add a seller')
+                ->icon(Heroicon::OutlinedUserPlus)
+                ->schema([
+                    TextInput::make('name')->required()->maxLength(80),
+                    TextInput::make('phone')
+                        ->label('Phone')
+                        ->required()
+                        ->maxLength(20)
+                        ->helperText('Any format. If this number has signed up already you will be taken to the existing record rather than a second one being made.'),
+                    TextInput::make('email')->email()->maxLength(120),
+                    TextInput::make('payout_phone')->label('M-Pesa number for payment')->maxLength(20),
+                    TextInput::make('mpesa_name')->label('Name on that M-Pesa number')->maxLength(80),
+                ])
+                ->action(function (array $data, Referrals $referrals): void {
+                    $referrer = $referrals->register($data + ['terms' => true]);
+
+                    Notification::make()
+                        ->title($referrer->wasRecentlyCreated
+                            ? 'Added — code '.$referrer->code
+                            : 'Already signed up — code '.$referrer->code)
+                        ->body($referrer->isActive()
+                            ? 'Their link is live: '.url('/').'?ref='.$referrer->code
+                            : 'Waiting for approval, so the link does not earn yet. Approve them in the list below.')
+                        ->success()
+                        ->send();
+                }),
+        ];
+    }
+}

@@ -0,0 +1,87 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Referrer;
+use App\Services\Referrals;
+use App\Support\ReferralSettings;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\View\View;
+
+/**
+ * Signing up to sell tickets, and seeing what you have earned.
+ *
+ * Reached by uuid, like the order page and the group roster — a capability URL
+ * rather than an account. Members of the public are not Users: giving two
+ * hundred strangers a password on the same table that reaches /admin would be
+ * trading a growth feature for an authentication surface.
+ *
+ * ABORTS WHEN THE PROGRAMME IS OFF. Not a polite empty page: while it is off
+ * nothing accrues, so a signup form that still worked would be collecting
+ * people's phone numbers against a promise of money that no setting has agreed
+ * to pay.
+ */
+class ReferralController extends Controller
+{
+    public function join(): View
+    {
+        $this->mustBeOpen();
+
+        return view('referrals.join');
+    }
+
+    public function register(Request $request, Referrals $referrals): RedirectResponse
+    {
+        $this->mustBeOpen();
+
+        $validated = $request->validate([
+            'name' => ['required', 'string', 'max:80'],
+            'phone' => ['required', 'string', 'max:20'],
+            'email' => ['nullable', 'email', 'max:120'],
+            'payout_phone' => ['nullable', 'string', 'max:20'],
+            'mpesa_name' => ['nullable', 'string', 'max:80'],
+            'terms' => ['accepted'],
+        ], [
+            'terms.accepted' => 'Please confirm you have read how commission works.',
+        ]);
+
+        $referrer = $referrals->register($validated);
+
+        return redirect()->route('referrals.dashboard', $referrer->uuid);
+    }
+
+    /**
+     * Their own page: the link to share, and what it has earned.
+     *
+     * Deliberately readable while the account is still pending. Somebody who
+     * has just signed up wants to see that it worked; the banner tells them
+     * plainly that nothing earns yet.
+     */
+    public function dashboard(string $uuid): View
+    {
+        $referrer = Referrer::where('uuid', $uuid)->firstOrFail();
+
+        $commissions = $referrer->commissions()
+            ->with(['order.customer', 'performance.event'])
+            ->latest('id')
+            ->limit(100)
+            ->get();
+
+        return view('referrals.dashboard', [
+            'referrer' => $referrer,
+            'commissions' => $commissions,
+            'link' => url('/').'?ref='.$referrer->code,
+            'ratePercent' => (float) ($referrer->commission_percent ?? ReferralSettings::percent()),
+            'holdHours' => ReferralSettings::holdHours(),
+            'earnedCents' => $referrer->earnedCents(),
+            'payableCents' => $referrer->payableCents(),
+            'paidCents' => $referrer->paidCents(),
+        ]);
+    }
+
+    private function mustBeOpen(): void
+    {
+        abort_unless(ReferralSettings::enabled(), 404);
+    }
+}
diff --git a/app/Http/Middleware/CaptureReferral.php b/app/Http/Middleware/CaptureReferral.php
new file mode 100644
index 0000000..2392160
--- /dev/null
+++ b/app/Http/Middleware/CaptureReferral.php
@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Services\Referrals;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Remember which link brought somebody here.
+ *
+ * FIRST TOUCH, NOT LAST. The cookie is written only when there is none. A
+ * ticket link gets forwarded through WhatsApp groups, and last-touch would let
+ * whoever reshared it last take the commission from whoever actually found the
+ * buyer — which is the argument the theatre would then have to referee.
+ *
+ * httpOnly: nothing in the page needs to read it, and a referral code that
+ * JavaScript can rewrite is a referral code that gets rewritten.
+ */
+class CaptureReferral
+{
+    public const COOKIE = 'ref';
+
+    private const DAYS = 30;
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $code = $request->query('ref');
+
+        if (blank($code) || $request->cookie(self::COOKIE)) {
+            return $next($request);
+        }
+
+        // Validated before it is stored, so a junk or revoked code never sits
+        // in somebody's browser for a month pretending to be worth something.
+        $referrer = app(Referrals::class)->byCode((string) $code);
+
+        if (! $referrer) {
+            return $next($request);
+        }
+
+        return $next($request)->withCookie(
+            cookie(self::COOKIE, $referrer->code, self::DAYS * 24 * 60, null, null, null, true),
+        );
+    }
+}

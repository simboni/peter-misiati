@@ -0,0 +1,102 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * Referrals — members of the public selling tickets for a commission.
+ *
+ * A referrer is NOT a User. Role::canAccessPanel() lets staff roles into
+ * /admin, and `users` carries a password and a reset surface; two hundred
+ * strangers do not belong in the staff table. Phone is the identity here, as
+ * it already is for customers, and a uuid capability URL is already how the
+ * public reaches private data.
+ *
+ * Statuses are plain strings, not enums. The codebase's own reason, recorded
+ * when PayHero was added: changing an enum on SQLite rebuilds a table, and
+ * these tables will hold records of money owed to people.
+ *
+ * COMMISSION IS EARNED, THEN PAYABLE, THEN PAID — three different facts.
+ * Earned means money landed. Payable means the show has happened and the
+ * order is still paid, so it is safe to hand over. Paid means somebody sent
+ * it. Collapsing those is how a theatre pays commission on a ticket it later
+ * refunds.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::create('referrers', function (Blueprint $table) {
+            $table->id();
+            $table->uuid('uuid')->unique();          // their private dashboard
+            $table->string('code')->unique();        // the ?ref= in the link
+            $table->string('name');
+            $table->string('phone')->unique();       // canonical, via Phone::normalise
+            $table->string('email')->nullable();
+            $table->string('mpesa_name')->nullable();  // name on the payout number
+            $table->string('payout_phone')->nullable();
+            $table->string('kra_pin')->nullable();     // see the withholding note
+            $table->foreignId('customer_id')->nullable()->constrained();
+            // Null means "use the house rate". A per-referrer override is for
+            // a negotiated deal, not the common case.
+            $table->decimal('commission_percent', 5, 2)->nullable();
+            $table->string('status')->default('pending'); // pending|active|paused|blocked
+            $table->timestamp('terms_accepted_at')->nullable();
+            $table->timestamp('approved_at')->nullable();
+            $table->foreignId('approved_by')->nullable()->constrained('users');
+            $table->timestamps();
+            $table->index(['status']);
+        });
+
+        Schema::table('orders', function (Blueprint $table) {
+            $table->foreignId('referrer_id')->nullable()->after('promo_code')->constrained();
+            // Frozen as clicked. If a referrer's code is ever changed, the
+            // order still says which link actually brought the buyer.
+            $table->string('referral_code')->nullable()->after('referrer_id');
+            $table->index(['referrer_id']);
+        });
+
+        Schema::create('referral_commissions', function (Blueprint $table) {
+            $table->id();
+            $table->uuid('uuid')->unique();
+            $table->foreignId('referrer_id')->constrained();
+            // The database guarantee against ever earning twice on one sale,
+            // whatever future code path calls confirm().
+            $table->foreignId('order_id')->unique()->constrained();
+            $table->foreignId('organiser_id')->constrained();
+            $table->foreignId('performance_id')->nullable()->constrained();
+            // What the rate was applied to, and the rate itself, both frozen
+            // at accrual — a later rate change must not rewrite history.
+            $table->unsignedInteger('base_cents');
+            $table->decimal('rate_percent', 5, 2);
+            $table->unsignedInteger('amount_cents');
+            // Its own column, not a negative: the money columns are unsigned,
+            // and a clawback is a separate fact from the original earning.
+            $table->unsignedInteger('clawback_cents')->default(0);
+            $table->string('status')->default('earned'); // earned|payable|paid|void
+            $table->timestamp('earned_at')->nullable();
+            // When it MAY become payable. Anchored to the performance, not the
+            // order: an order-age hold would still mature on a show cancelled
+            // in week three.
+            $table->timestamp('payable_at')->nullable();
+            $table->timestamp('paid_at')->nullable();
+            $table->timestamp('voided_at')->nullable();
+            $table->string('void_reason')->nullable();
+            $table->timestamps();
+            $table->index(['referrer_id', 'status']);
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::dropIfExists('referral_commissions');
+
+        Schema::table('orders', function (Blueprint $table) {
+            $table->dropConstrainedForeignId('referrer_id');
+            $table->dropColumn('referral_code');
+        });
+
+        Schema::dropIfExists('referrers');
+    }
+};

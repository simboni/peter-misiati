+<script>
+    (function () {
+        var btn = document.getElementById('copy');
+        var box = document.getElementById('reflink');
+
+        if (!btn || !box) { return; }
+
+        btn.addEventListener('click', function () {
+            var done = function () {
+                btn.textContent = 'Copied';
+                setTimeout(function () { btn.textContent = 'Copy link'; }, 1800);
+            };
+
+            if (navigator.clipboard && navigator.clipboard.writeText) {
+                navigator.clipboard.writeText(box.value).then(done, function () {
+                    box.select();
+                });
+                return;
+            }
+
+            // Older Android browsers, which is a lot of the audience here.
+            box.select();
+            try { document.execCommand('copy'); done(); } catch (e) { /* leave it selected */ }
+        });
+    })();
+</script>

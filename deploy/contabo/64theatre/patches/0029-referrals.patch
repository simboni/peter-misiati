@@ -0,0 +1,203 @@
+<?php
+
+namespace App\Filament\Resources\ReferralCommissions\Tables;
+
+use App\Models\AuditLog;
+use App\Models\ReferralCommission;
+use App\Support\Phone;
+use App\Support\Role;
+use Filament\Actions\Action;
+use Filament\Actions\BulkAction;
+use Filament\Forms\Components\Textarea;
+use Filament\Notifications\Notification;
+use Filament\Tables\Columns\TextColumn;
+use Filament\Tables\Filters\SelectFilter;
+use Filament\Tables\Table;
+use Illuminate\Database\Eloquent\Collection;
+
+class ReferralCommissionsTable
+{
+    public static function configure(Table $table): Table
+    {
+        return $table
+            ->modifyQueryUsing(fn ($query) => $query->with(['referrer', 'order', 'performance.event']))
+            ->defaultSort('id', 'desc')
+            ->columns([
+                TextColumn::make('referrer.name')
+                    ->label('Seller')
+                    ->searchable()
+                    ->description(fn (ReferralCommission $c): string => Phone::forHumans($c->referrer?->payout_phone ?: $c->referrer?->phone)),
+                TextColumn::make('performance.event.title')
+                    ->label('Show')
+                    ->limit(28)
+                    ->toggleable(),
+                TextColumn::make('base_cents')
+                    ->label('Sale')
+                    ->alignEnd()
+                    ->formatStateUsing(fn (int $state): string => 'KES '.number_format($state / 100)),
+                TextColumn::make('rate_percent')
+                    ->label('Rate')
+                    ->alignEnd()
+                    ->formatStateUsing(fn (string $state): string => rtrim(rtrim(number_format((float) $state, 2), '0'), '.').'%'),
+                TextColumn::make('amount_cents')
+                    ->label('Commission')
+                    ->alignEnd()
+                    ->weight('bold')
+                    ->sortable()
+                    ->formatStateUsing(fn (int $state): string => 'KES '.number_format($state / 100)),
+                TextColumn::make('status')
+                    ->badge()
+                    ->color(fn (string $state): string => match ($state) {
+                        'payable' => 'success',
+                        'paid' => 'info',
+                        'void' => 'danger',
+                        default => 'warning',
+                    })
+                    ->formatStateUsing(fn (string $state): string => match ($state) {
+                        'earned' => 'not yet due',
+                        'payable' => 'ready to pay',
+                        default => $state,
+                    }),
+                TextColumn::make('payable_at')
+                    ->label('Due')
+                    ->dateTime('j M Y, g:i a')
+                    ->description(fn (ReferralCommission $c): ?string => $c->status === 'earned' && $c->payable_at?->isFuture()
+                        ? 'held until after the show'
+                        : null)
+                    ->sortable(),
+                TextColumn::make('clawback_cents')
+                    ->label('Clawback')
+                    ->alignEnd()
+                    ->formatStateUsing(fn (int $state): string => $state > 0 ? '−KES '.number_format($state / 100) : '—')
+                    ->toggleable(isToggledHiddenByDefault: true),
+                TextColumn::make('order.uuid')
+                    ->label('Order')
+                    ->limit(8)
+                    ->copyable()
+                    ->toggleable(isToggledHiddenByDefault: true),
+            ])
+            ->filters([
+                SelectFilter::make('status')->options([
+                    'earned' => 'Not yet due',
+                    'payable' => 'Ready to pay',
+                    'paid' => 'Paid',
+                    'void' => 'Void',
+                ]),
+                SelectFilter::make('referrer_id')
+                    ->label('Seller')
+                    ->relationship('referrer', 'name')
+                    ->searchable()
+                    ->preload(),
+            ])
+            ->recordActions([
+                /*
+                 * Recording a payout that has already happened. The money
+                 * moved in M-Pesa; this is the book catching up, which is why
+                 * it is only offered on commission that was ready to pay.
+                 */
+                Action::make('markPaid')
+                    ->label('Mark paid')
+                    ->icon('heroicon-o-check-badge')
+                    ->color('success')
+                    ->visible(fn (ReferralCommission $c): bool => $c->status === 'payable'
+                        && Role::canHandleMoney(auth()->user()?->role))
+                    ->requiresConfirmation()
+                    ->modalHeading('Record this as paid')
+                    ->modalDescription('Only after the M-Pesa has actually gone out. Nothing here sends money.')
+                    ->action(function (ReferralCommission $c): void {
+                        $c->update(['status' => 'paid', 'paid_at' => now()]);
+                        self::log($c, 'referral_commission.paid', 'payable');
+                        Notification::make()->title('Recorded as paid')->success()->send();
+                    }),
+
+                /*
+                 * Voiding is for the cases the automatic rules cannot see — a
+                 * seller caught claiming sales they did not bring, a buyer who
+                 * never turned up and was let off. A reason is required
+                 * because the person owed the money will ask.
+                 */
+                Action::make('void')
+                    ->label('Void')
+                    ->icon('heroicon-o-x-circle')
+                    ->color('danger')
+                    ->visible(fn (ReferralCommission $c): bool => ! in_array($c->status, ['void', 'paid'], true)
+                        && Role::canHandleMoney(auth()->user()?->role))
+                    ->schema([
+                        Textarea::make('reason')->label('Why?')->required()->maxLength(200),
+                    ])
+                    ->requiresConfirmation()
+                    ->action(function (ReferralCommission $c, array $data): void {
+                        $was = $c->status;
+                        $c->update([
+                            'status' => 'void',
+                            'voided_at' => now(),
+                            'void_reason' => $data['reason'],
+                        ]);
+                        self::log($c, 'referral_commission.voided', $was, $data['reason']);
+                        Notification::make()->title('Voided')->success()->send();
+                    }),
+            ])
+            ->toolbarActions([
+                /*
+                 * A payout run: filter to one seller, select their ready rows,
+                 * send one M-Pesa for the total, record it here. Refuses
+                 * anything not ready to pay rather than silently skipping it,
+                 * so the total on screen is the total you send.
+                 */
+                BulkAction::make('markPaidBulk')
+                    ->label('Mark selected as paid')
+                    ->icon('heroicon-o-check-badge')
+                    ->color('success')
+                    ->visible(fn (): bool => Role::canHandleMoney(auth()->user()?->role))
+                    ->requiresConfirmation()
+                    ->modalHeading('Record these as paid')
+                    ->modalDescription('Only after the money has gone out. Any row that is not ready to pay will be refused.')
+                    ->action(function (Collection $records): void {
+                        $notReady = $records->where('status', '!=', 'payable');
+
+                        if ($notReady->isNotEmpty()) {
+                            Notification::make()
+                                ->title('Nothing recorded')
+                                ->body($notReady->count().' of the selected rows are not ready to pay. Deselect them, or filter to "Ready to pay" first.')
+                                ->danger()
+                                ->send();
+
+                            return;
+                        }
+
+                        $total = 0;
+
+                        foreach ($records as $c) {
+                            $c->update(['status' => 'paid', 'paid_at' => now()]);
+                            self::log($c, 'referral_commission.paid', 'payable');
+                            $total += (int) $c->amount_cents;
+                        }
+
+                        Notification::make()
+                            ->title('Recorded')
+                            ->body('KES '.number_format($total / 100).' across '.$records->count().' sales.')
+                            ->success()
+                            ->send();
+                    })
+                    ->deselectRecordsAfterCompletion(),
+            ]);
+    }
+
+    private static function log(ReferralCommission $c, string $action, ?string $was, ?string $reason = null): void
+    {
+        AuditLog::create([
+            'user_id' => auth()->id(),
+            'organiser_id' => $c->organiser_id,
+            'action' => $action,
+            'subject_type' => ReferralCommission::class,
+            'subject_id' => $c->id,
+            'changes' => array_filter([
+                'from' => $was,
+                'to' => $c->status,
+                'amount_cents' => (int) $c->amount_cents,
+                'referrer' => $c->referrer?->phone,
+                'reason' => $reason,
+            ], fn ($v) => $v !== null),
+        ]);
+    }
+}

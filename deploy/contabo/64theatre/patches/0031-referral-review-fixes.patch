diff --git a/app/Mail/ReferralLink.php b/app/Mail/ReferralLink.php
new file mode 100644
index 0000000..2af8eda
--- /dev/null
+++ b/app/Mail/ReferralLink.php
@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Mail;
+
+use App\Models\Referrer;
+use Illuminate\Bus\Queueable;
+use Illuminate\Mail\Mailable;
+use Illuminate\Mail\Mailables\Content;
+use Illuminate\Mail\Mailables\Envelope;
+use Illuminate\Queue\SerializesModels;
+
+/**
+ * Sending a seller their own page.
+ *
+ * This exists so the signup form does not have to. Submitting a phone number
+ * that is already registered used to redirect straight to that seller's
+ * dashboard — and the dashboard URL is the only credential it has. Anyone who
+ * knew a seller's number, which is everyone in the group chat where she shared
+ * her link, could type it in and get permanent access to her page, her rate
+ * and her earnings. Emailing the link instead means the person has to hold the
+ * mailbox, not just know the number.
+ */
+class ReferralLink extends Mailable
+{
+    use Queueable, SerializesModels;
+
+    public function __construct(public Referrer $referrer) {}
+
+    public function envelope(): Envelope
+    {
+        return new Envelope(subject: 'Your 64 Theatre selling link');
+    }
+
+    public function content(): Content
+    {
+        return new Content(view: 'mail.referral-link', with: [
+            'link' => url('/').'?ref='.$this->referrer->code,
+            'page' => route('referrals.dashboard', $this->referrer->uuid),
+        ]);
+    }
+}

+    /**
+     * The bug this exists for: a clawback was subtracted from every future
+     * payout, for ever, because nothing ever marked one settled. One KES 100
+     * clawback shorted the seller KES 100 on every payout run they ever had.
+     */
+    public function test_a_clawback_is_deducted_once_and_then_cleared(): void
+    {
+        $ref = $this->referrer();
+        $type = TicketType::factory()->create(['price_cents' => 50000, 'quantity_total' => 50]);
+
+        // Sale one: paid out, then refunded — so KES 100 is owed back.
+        $first = $this->buy($type, $ref);
+        ReferralCommission::first()->update(['status' => 'paid', 'paid_at' => now()]);
+        app(Refunds::class)->refund($first->fresh(), 'Duplicate payment');
+
+        $this->assertSame(10000, $ref->fresh()->outstandingClawbackCents());
+
+        // Sale two matures. Gross 100, less 100 owed back, so nothing to send.
+        $this->buy($type, $ref, phone: '0722222222');
+        $second = ReferralCommission::where('order_id', '!=', $first->id)->firstOrFail();
+        $second->update(['status' => 'payable']);
+
+        $this->assertSame(0, $ref->fresh()->payableCents());
+
+        $result = app(Referrals::class)->recordPayout([$second->fresh()]);
+        $this->assertSame(10000, $result['gross']);
+        $this->assertSame(10000, $result['recovered']);
+        $this->assertSame(0, $result['net']);
+
+        // SETTLED. Nothing is owed back any more.
+        $this->assertSame(0, $ref->fresh()->outstandingClawbackCents());
+
+        // Sale three matures and is paid in full — the old code deducted the
+        // same KES 100 again here, and again on every run after that.
+        $this->buy($type, $ref, phone: '0733333333');
+        $third = ReferralCommission::where('status', 'earned')->firstOrFail();
+        $third->update(['status' => 'payable']);
+
+        $this->assertSame(10000, $ref->fresh()->payableCents());
+        $this->assertSame(10000, app(Referrals::class)->recordPayout([$third->fresh()])['net']);
+    }

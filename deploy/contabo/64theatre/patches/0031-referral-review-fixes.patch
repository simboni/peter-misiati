@@ -0,0 +1,38 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * Remembering that a clawback has been settled.
+ *
+ * `clawback_cents` recorded that commission had been paid on a sale which was
+ * later refunded, so the money was owed back. Nothing ever cleared it. The
+ * seller's page netted it off the payable total on every single payout run
+ * from then on, so one KES 100 clawback shorted them KES 100 every time they
+ * were paid, for ever. There was no column and no action that could settle it.
+ *
+ * So: how much of each clawback has actually been recovered. Owed back is
+ * `clawback_cents - clawback_recovered_cents`, which is zero once it is
+ * settled, and the original figure stays on the row because what was clawed
+ * back is a fact worth keeping separately from whether it has been collected.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::table('referral_commissions', function (Blueprint $table) {
+            $table->unsignedInteger('clawback_recovered_cents')
+                ->default(0)
+                ->after('clawback_cents');
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::table('referral_commissions', function (Blueprint $table) {
+            $table->dropColumn('clawback_recovered_cents');
+        });
+    }
+};

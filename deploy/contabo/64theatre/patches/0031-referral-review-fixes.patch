+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Event;
+use App\Models\Order;
+use App\Models\Organiser;
+use App\Models\Payment;
+use App\Models\Performance;
+use App\Models\ReferralCommission;
+use App\Models\Setting;
+use App\Models\TicketGroup;
+use App\Models\TicketType;
+use App\Models\Venue;
+use App\Services\Checkout;
+use App\Services\Referrals;
+use App\Support\EventRemoval;
+use App\Support\ReferralSettings;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Queue;
+use Tests\TestCase;
+
+/**
+ * Erasing an event and everything sold for it.
+ *
+ * Every feature that adds a table pointing at `orders` has to be added to the
+ * delete order in EventRemoval, and twice it was not: group tickets and
+ * referral commissions. Purging an event that had sold one of either failed on
+ * a foreign key — and those are exactly the events this button exists for. The
+ * transaction meant nothing was half-deleted, so the only symptom was an
+ * unexplained error on an action with no alternative.
+ *
+ * These tests are the guard. A new table pointing at an order breaks one of
+ * them rather than breaking the button on a Monday morning.
+ */
+class EventRemovalTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        Queue::fake();
+    }
+
+    private function performance(): Performance
+    {
+        $organiser = Organiser::create(['name' => 'Test', 'slug' => 'test-'.uniqid()]);
+        $venue = Venue::create(['organiser_id' => $organiser->id, 'name' => 'Hall', 'town' => 'Eldoret']);
+        $event = Event::create([
+            'organiser_id' => $organiser->id,
+            'title' => 'Show', 'slug' => 'show-'.uniqid(),
+            'category' => 'theatre', 'status' => 'published',
+        ]);
+
+        return Performance::create([
+            'event_id' => $event->id, 'venue_id' => $venue->id,
+            'starts_at' => now()->addWeek(), 'status' => 'on_sale',
+        ]);
+    }
+
+    private function settle(Order $order): Order
+    {
+        $payment = Payment::create([
+            'order_id' => $order->id, 'gateway' => 'cash', 'gateway_ref' => 'E-'.uniqid(),
+            'amount_cents' => $order->total_cents, 'status' => 'initiated',
+        ]);
+
+        return app(Checkout::class)->confirm($order, $payment);
+    }
+
+    public function test_an_event_with_a_referred_sale_can_be_erased(): void
+    {
+        Setting::put(ReferralSettings::KEY_ENABLED, '1');
+        Setting::put(ReferralSettings::KEY_PERCENT, '10');
+
+        $performance = $this->performance();
+        $type = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Regular',
+            'price_cents' => 50000, 'quantity_total' => 20,
+        ]);
+
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        $this->settle(app(Checkout::class)->startOrder(
+            items: [$type->id => 2], phone: '0799888777', referrer: $referrer,
+        ));
+
+        $this->assertSame(1, ReferralCommission::count());
+
+        EventRemoval::purge($performance->event->fresh());
+
+        $this->assertSame(0, ReferralCommission::count());
+        $this->assertSame(0, Order::count());
+        // The seller survives — they are a person, not part of this event.
+        $this->assertDatabaseHas('referrers', ['id' => $referrer->id]);
+    }
+
+    public function test_an_event_with_a_group_sale_can_be_erased(): void
+    {
+        $performance = $this->performance();
+        $type = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 4',
+            'price_cents' => 180000, 'quantity_total' => 10, 'admits' => 4,
+        ]);
+
+        $this->settle(app(Checkout::class)->startOrder(
+            items: [$type->id => 1], phone: '0712345678', name: 'School',
+        ));
+
+        $this->assertSame(1, TicketGroup::count());
+
+        EventRemoval::purge($performance->event->fresh());
+
+        $this->assertSame(0, TicketGroup::count());
+        $this->assertSame(0, Order::count());
+    }
+
+    public function test_an_event_with_both_can_be_erased(): void
+    {
+        Setting::put(ReferralSettings::KEY_ENABLED, '1');
+        Setting::put(ReferralSettings::KEY_PERCENT, '10');
+
+        $performance = $this->performance();
+        $group = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 4',
+            'price_cents' => 180000, 'quantity_total' => 10, 'admits' => 4,
+        ]);
+
+        $referrer = app(Referrals::class)->register(['name' => 'Mercy', 'phone' => '0712345678']);
+        $referrer->update(['status' => 'active']);
+
+        $this->settle(app(Checkout::class)->startOrder(
+            items: [$group->id => 1], phone: '0799888777', name: 'School', referrer: $referrer,
+        ));
+
+        $removed = EventRemoval::purge($performance->event->fresh());
+
+        $this->assertSame(0, Order::count());
+        $this->assertSame(0, TicketGroup::count());
+        $this->assertSame(0, ReferralCommission::count());
+        // Reported, so the operator can see what went.
+        $this->assertArrayHasKey('ticket_groups', $removed);
+        $this->assertArrayHasKey('referral_commissions', $removed);
+    }
+
+    public function test_an_event_with_nothing_sold_is_still_fine(): void
+    {
+        $performance = $this->performance();
+        TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Regular',
+            'price_cents' => 50000, 'quantity_total' => 20,
+        ]);
+
+        EventRemoval::purge($performance->event->fresh());
+

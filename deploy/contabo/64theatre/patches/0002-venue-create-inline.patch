+<?php
+
+namespace App\Filament\Forms\Components;
+
+use App\Models\Organiser;
+use App\Models\Venue;
+use Filament\Forms\Components\Select;
+use Filament\Forms\Components\Textarea;
+use Filament\Forms\Components\TextInput;
+
+/**
+ * The venue field, with the ability to add and correct venues in place.
+ *
+ * Venues were only ever created by the demo seeder, which runs under
+ * `local` and `staging` and not under `production`, and no admin screen
+ * creates one. A real install therefore started with an empty venue list and
+ * no way to fill it — and because a performance requires a venue, no event
+ * could be created at all. The demo venues on the staging box disguised this
+ * completely.
+ *
+ * Adding a Venues item to the sidebar would have fixed it too, but venues are
+ * not something anyone sets out to manage: you think about them while
+ * scheduling a performance, which is exactly where this puts them. It also
+ * keeps the navigation as short as it was deliberately made.
+ */
+final class VenuePicker
+{
+    public static function make(string $name = 'venue_id'): Select
+    {
+        return Select::make($name)
+            ->label('Venue')
+            ->placeholder('Choose a venue — or add one')
+            ->options(fn (): array => Venue::query()
+                ->orderBy('name')
+                ->get()
+                ->mapWithKeys(fn (Venue $v): array => [$v->getKey() => self::label($v)])
+                ->all())
+            ->searchable()
+            ->required()
+            ->helperText('No venue listed? Use + to add one.')
+
+            // ---------------------------------------------------------- add --
+            ->createOptionForm(self::fields())
+            ->createOptionModalHeading('Add a venue')
+            ->createOptionUsing(function (array $data): int {
+                // firstOrCreate, not create: the same hall typed twice would
+                // otherwise sit in the dropdown twice, and nothing in the
+                // schema prevents that.
+                return Venue::firstOrCreate(
+                    [
+                        'organiser_id' => self::organiserId(),
+                        'name' => trim($data['name']),
+                        'town' => trim($data['town']),
+                    ],
+                    [
+                        'capacity' => $data['capacity'] ?? null,
+                        'directions' => $data['directions'] ?? null,
+                        'map_url' => $data['map_url'] ?? null,
+                    ],
+                )->getKey();
+            })
+
+            // --------------------------------------------------------- amend --
+            // A venue added mid-schedule is typed in a hurry. Being able to
+            // fix the capacity or add directions afterwards, without leaving
+            // the form, is what stops it staying wrong.
+            ->editOptionForm(self::fields())
+            ->editOptionModalHeading('Edit venue')
+            ->fillEditOptionActionFormUsing(function (Select $component): ?array {
+                $venue = Venue::find($component->getState());
+
+                return $venue?->only(['name', 'town', 'capacity', 'directions', 'map_url']);
+            })
+            ->updateOptionUsing(function (array $data, Select $component): void {
+                Venue::whereKey($component->getState())->update([
+                    'name' => trim($data['name']),
+                    'town' => trim($data['town']),
+                    'capacity' => $data['capacity'] ?? null,
+                    'directions' => $data['directions'] ?? null,
+                    'map_url' => $data['map_url'] ?? null,
+                ]);
+            });
+    }
+
+    /** Town alongside the name, because "Town Hall" alone is not a place. */
+    private static function label(Venue $venue): string
+    {
+        return filled($venue->town)
+            ? "{$venue->name} — {$venue->town}"
+            : $venue->name;
+    }
+
+    /**
+     * `venues.organiser_id` is NOT NULL, so one has to be chosen. The signed-in
+     * administrator's own organiser is the right answer; the first organiser is
+     * the fallback for a user record without one.
+     */
+    private static function organiserId(): int
+    {
+        return auth()->user()?->organiser_id
+            ?? Organiser::query()->orderBy('id')->value('id');
+    }
+
+    /** @return array<int, \Filament\Forms\Components\Component> */
+    private static function fields(): array
+    {
+        return [
+            TextInput::make('name')
+                ->label('Venue name')
+                ->placeholder('Eldoret Town Hall')
+                ->required()
+                ->maxLength(120),
+            TextInput::make('town')
+                ->label('Town')
+                ->placeholder('Eldoret')
+                ->required()
+                ->maxLength(80),
+            TextInput::make('capacity')
+                ->label('Capacity')
+                ->numeric()
+                ->minValue(1)
+                ->helperText('Optional. Seats available — it does not cap ticket sales.'),
+            Textarea::make('directions')
+                ->label('Directions')
+                ->rows(3)
+                ->helperText('Optional. Shown to ticket holders.'),
+            TextInput::make('map_url')
+                ->label('Map link')
+                ->url()
+                ->placeholder('https://maps.google.com/…')
+                ->helperText('Optional.'),
+        ];
+    }
+}

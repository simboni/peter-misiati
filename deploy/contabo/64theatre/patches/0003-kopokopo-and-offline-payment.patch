@@ -0,0 +1,54 @@
+<?php
+
+namespace App\Http\Controllers\Webhooks;
+
+use App\Http\Controllers\Controller;
+use App\Payments\KopoKopoGateway;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Kopo Kopo posts the STK-push result here.
+ *
+ * This endpoint is public and unauthenticated, so anyone who learns the URL
+ * can post to it. The HMAC signature is the only thing standing between that
+ * and a stranger marking their own order paid, which is why it is checked
+ * before the body is parsed, let alone acted on.
+ *
+ * The signature covers the RAW request body. `$request->all()` would give us
+ * decoded JSON, and re-encoding it changes the bytes and therefore the hash,
+ * so the raw content is read first and handed on only once it verifies.
+ */
+class KopoKopoCallbackController extends Controller
+{
+    public function __invoke(Request $request, KopoKopoGateway $gateway): JsonResponse
+    {
+        $raw = $request->getContent();
+
+        if (! KopoKopoGateway::signatureIsValid($raw, $request->header('X-KopoKopo-Signature'))) {
+            // Deliberately terse, and logged without the body: an attacker
+            // probing this should learn nothing about what we expected.
+            Log::channel('single')->warning('kopokopo.callback.bad_signature', [
+                'ip' => $request->ip(),
+            ]);
+
+            return response()->json(['status' => 'rejected'], 401);
+        }
+
+        $payload = json_decode($raw, true);
+
+        if (! is_array($payload)) {
+            return response()->json(['status' => 'bad request'], 400);
+        }
+
+        Log::channel('single')->info('kopokopo.callback', $payload);
+
+        $gateway->handleCallback($payload);
+
+        // Always 200 once the signature is good, even for an order we cannot
+        // place: anything else makes Kopo Kopo retry a delivery that will
+        // never succeed.
+        return response()->json(['status' => 'ok']);
+    }
+}
diff --git a/app/Payments/KopoKopoGateway.php b/app/Payments/KopoKopoGateway.php
new file mode 100644
index 0000000..582f5cd
--- /dev/null
+++ b/app/Payments/KopoKopoGateway.php
@@ -0,0 +1,262 @@
+<?php
+
+namespace App\Payments;
+
+use App\Models\Order;
+use App\Models\Payment;
+use App\Services\Checkout;
+use Illuminate\Support\Facades\Cache;
+use Illuminate\Support\Facades\Http;
+use RuntimeException;
+
+/**
+ * Kopo Kopo — M-Pesa STK Push through an aggregator.
+ *
+ * Why this exists: Safaricom's own Daraja needs a paybill in 64 Theatre's
+ * name, and that approval takes weeks. Kopo Kopo sells through its own till
+ * today and settles to the client's account, so tickets can go on sale now.
+ * When the Safaricom shortcode lands, PAYMENT_GATEWAY=daraja and nothing else
+ * in the application changes — that is what the PaymentGateway seam is for.
+ *
+ * The flow, which is the same one the billing platform uses:
+ *   OAuth    POST {base}/oauth/token                   client_credentials
+ *   STK      POST {base}/api/v1/incoming_payments      201 + Location header
+ *   Status   GET  {location}                           data.attributes.status
+ *   Webhook  POST our callback, signed X-KopoKopo-Signature
+ *            = HMAC-SHA256(raw body, API key)
+ *
+ * Two things differ from Daraja and both have bitten people before:
+ *   · Success is 201 with the handle in the `Location` HEADER, not the body.
+ *   · The webhook is signed with the API key, which is a different secret
+ *     from the client secret.
+ */
+class KopoKopoGateway implements PaymentGateway
+{
+    /** Recorded in gateway_payload, since `gateway` itself says 'aggregator'. */
+    private const PROVIDER = 'kopokopo';
+
+    /** The enum value Kopo Kopo payments are stored under. */
+    private const GATEWAY = 'aggregator';
+
+    public function initiate(Order $order, string $payerPhone): Payment
+    {
+        $phone = $this->normalisePhone($payerPhone);
+
+        if ($phone === null) {
+            throw new RuntimeException("Not a Kenyan mobile number: {$payerPhone}");
+        }
+
+        $response = Http::withToken($this->accessToken())
+            ->acceptJson()
+            ->post($this->base().'/api/v1/incoming_payments', [
+                'payment_channel' => 'M-PESA STK Push',
+                'till_number' => config('services.kopokopo.till_number'),
+                'subscriber' => [
+                    'first_name' => $this->firstName($order),
+                    'last_name' => $this->lastName($order),
+                    'phone_number' => $phone,
+                ],
+                // Kopo Kopo takes whole shillings as a string; we store cents.
+                'amount' => [
+                    'currency' => 'KES',
+                    'value' => (string) intdiv($order->total_cents, 100),
+                ],
+                // Comes back on the webhook, and is how we find the order
+                // without trusting anything the caller sent.
+                'metadata' => ['order_uuid' => $order->uuid],
+                '_links' => ['callback_url' => route('webhooks.kopokopo')],
+            ])->throw();
+
+        // 201 Created; the payment's handle is the Location header, not body.
+        $location = $response->header('Location');
+
+        return Payment::create([
+            'order_id' => $order->id,
+            // `payments.gateway` is an enum: mpesa_stk | cash | bank_transfer
+            // | card | aggregator. Kopo Kopo is an aggregator, exactly as
+            // Pesapal is, so it uses the value that already exists. Adding
+            // 'kopokopo' would mean an enum migration, and on SQLite that
+            // rebuilds a table holding real payment records — a bad trade for
+            // a label. The provider is recorded in the payload instead.
+            'gateway' => self::GATEWAY,
+            'gateway_ref' => $location ?: null,
+            'payer_phone' => $phone,
+            'amount_cents' => $order->total_cents,
+            'status' => 'initiated',
+            'gateway_payload' => [
+                'provider' => self::PROVIDER,
+                'location' => $location,
+                'body' => $response->json(),
+            ],
+        ]);
+    }
+
+    public function authorizationUrl(Payment $payment): ?string
+    {
+        return null; // inline — the buyer approves on their handset
+    }
+
+    /**
+     * Settle from a webhook body. The signature is verified in the controller,
+     * before this is called — nothing here may act on an unverified payload.
+     */
+    public function handleCallback(array $payload): ?Payment
+    {
+        $attributes = data_get($payload, 'data.attributes', $payload);
+        $orderUuid = data_get($attributes, 'metadata.order_uuid');
+        $reference = data_get($attributes, 'event.resource.reference');
+
+        $payment = $this->locatePayment($orderUuid, data_get($payload, 'data.id'));
+
+        if (! $payment || $payment->status !== 'initiated') {
+            return $payment; // unknown, or already settled — idempotent
+        }
+
+        $status = $this->normaliseStatus((string) data_get($attributes, 'status', ''));
+
+        if ($status === 'success') {
+            $payment->update([
+                // The M-Pesa receipt the buyer can quote; far more use at the
+                // gate than our own internal handle.
+                'gateway_ref' => $reference ?: $payment->gateway_ref,
+                'gateway_payload' => $payload,
+            ]);
+
+            app(Checkout::class)->confirm($payment->order, $payment);
+        } elseif ($status === 'failed') {
+            $payment->update(['status' => 'failed', 'gateway_payload' => $payload]);
+        }
+        // 'pending' is a progress ping — leave it initiated and wait.
+
+        return $payment->refresh();
+    }
+
+    /**
+     * Verify a webhook signature: HMAC-SHA256 of the RAW body under the API
+     * key. Raw, because re-encoding decoded JSON changes bytes and the hash
+     * with them.
+     */
+    public static function signatureIsValid(string $rawBody, ?string $signature): bool
+    {
+        $apiKey = config('services.kopokopo.api_key');
+
+        if (blank($signature) || blank($apiKey)) {
+            return false;
+        }
+
+        return hash_equals(hash_hmac('sha256', $rawBody, $apiKey), strtolower($signature));
+    }
+
+    /**
+     * Ask Kopo Kopo directly what happened. The webhook is the primary path;
+     * this covers the case where it never arrived — which on a box with one
+     * public IP and no retry queue is not rare.
+     */
+    public function pollStatus(Payment $payment): ?string
+    {
+        $location = $payment->gateway_ref;
+
+        if (blank($location) || ! str_starts_with($location, 'http')) {
+            return null;
+        }
+
+        $response = Http::withToken($this->accessToken())->acceptJson()->get($location);
+
+        if (! $response->successful()) {
+            return null;
+        }
+
+        return $this->normaliseStatus((string) $response->json('data.attributes.status', ''));
+    }
+
+    /** Kopo Kopo's status vocabulary is wider than ours. */
+    private function normaliseStatus(string $raw): string
+    {
+        return match (strtolower($raw)) {
+            'received', 'success', 'successful', 'completed', 'settled' => 'success',
+            'failed', 'cancelled', 'canceled', 'error', 'declined' => 'failed',
+            default => 'pending',
+        };
+    }
+
+    private function locatePayment(?string $orderUuid, ?string $resourceId): ?Payment
+    {
+        if (filled($orderUuid)) {
+            $order = Order::where('uuid', $orderUuid)->first();
+
+            if ($order) {
+                // The order's most recent unsettled attempt. Safe even if an
+                // earlier Pesapal attempt shares the 'aggregator' value: this
+                // webhook was signed with our Kopo Kopo key, so it is a real
+                // Kopo Kopo event, and it is settling the live attempt.
+                return $order->payments()
+                    ->where('gateway', self::GATEWAY)
+                    ->where('status', 'initiated')
+                    ->latest('id')
+                    ->first();
+            }
+        }
+
+        // Fall back to the resource id embedded in the Location we stored.
+        return filled($resourceId)
+            ? Payment::where('gateway', self::GATEWAY)
+                ->where('gateway_ref', 'like', '%'.$resourceId)
+                ->first()
+            : null;
+    }
+
+    private function accessToken(): string
+    {
+        // Kopo Kopo's tokens last an hour; 50 minutes leaves room for clock
+        // drift without a round trip on every checkout.
+        return Cache::remember('kopokopo.access_token', 3000, function (): string {
+            $token = Http::asForm()
+                ->acceptJson()
+                ->post($this->base().'/oauth/token', [
+                    'client_id' => config('services.kopokopo.client_id'),
+                    'client_secret' => config('services.kopokopo.client_secret'),
+                    'grant_type' => 'client_credentials',
+                ])->throw()->json('access_token');
+
+            if (blank($token)) {
+                throw new RuntimeException('Kopo Kopo returned no access token.');
+            }
+
+            return $token;
+        });
+    }
+
+    private function base(): string
+    {
+        return rtrim((string) config('services.kopokopo.base_url'), '/');
+    }
+
+    /** 07XX / 01XX / 2547XX / +2547XX → +2547XXXXXXXX. Null if it is not one. */
+    private function normalisePhone(string $phone): ?string
+    {
+        $digits = preg_replace('/\D/', '', $phone);
+
+        if (str_starts_with($digits, '0')) {
+            $digits = '254'.substr($digits, 1);
+        } elseif (str_starts_with($digits, '7') || str_starts_with($digits, '1')) {
+            $digits = '254'.$digits;
+        }
+
+        // Kopo Kopo wants E.164 with the plus; Daraja wants it without.
+        return preg_match('/^254[71]\d{8}$/', $digits) ? '+'.$digits : null;
+    }
+
+    private function firstName(Order $order): string
+    {
+        $name = trim((string) ($order->customer->name ?? ''));
+
+        return $name === '' ? 'Customer' : (explode(' ', $name)[0]);
+    }
+
+    private function lastName(Order $order): string
+    {
+        $parts = preg_split('/\s+/', trim((string) ($order->customer->name ?? '')));
+
+        return count($parts) > 1 ? end($parts) : '';
+    }
+}

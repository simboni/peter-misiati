+    /**
+     * The "ask for member names" switch has to actually do something.
+     *
+     * It was stored, cast on the model, and read nowhere — so a theatre that
+     * turned it off was asked for names anyway, and the switch was decoration.
+     * Same class of problem as a settings toggle that cannot reach the code
+     * it claims to control.
+     */
+    public function test_the_roster_is_offered_when_names_are_wanted(): void
+    {
+        $performance = $this->performance();
+        $type = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 4',
+            'price_cents' => 180000, 'quantity_total' => 5, 'admits' => 4,
+            'collect_member_names' => true,
+        ]);
+
+        $order = $this->settle(app(Checkout::class)->startOrder(
+            items: [$type->id => 1], phone: '0712345678', name: 'School',
+        ));
+
+        $this->get('/orders/'.$order->uuid)
+            ->assertOk()
+            ->assertSee('Name the members', escape: false);
+    }
+
+    public function test_the_roster_is_not_offered_when_names_are_not_wanted(): void
+    {
+        $performance = $this->performance();
+        $type = TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Group of 4',
+            'price_cents' => 180000, 'quantity_total' => 5, 'admits' => 4,
+            'collect_member_names' => false,
+        ]);
+
+        $order = $this->settle(app(Checkout::class)->startOrder(
+            items: [$type->id => 1], phone: '0712345678', name: 'School',
+        ));
+
+        $response = $this->get('/orders/'.$order->uuid)->assertOk();
+        $response->assertDontSee('Name the members', escape: false);
+        // The group panel itself stays — how many of you are in is useful
+        // whether or not anybody is named.
+        $response->assertSee('4 people', escape: false);
+    }
+
+    public function test_making_a_category_a_group_switches_name_collection_on(): void
+    {
+        $performance = $this->performance();
+        $admin = User::factory()->create(['role' => 'super_admin']);
+
+        // An ordinary category that already exists, carrying the column's
+        // default of false. Raising admits used to leave the switch reading
+        // off, so the buyer was never offered the roster and nothing on
+        // screen said the feature was only half on.
+        TicketType::create([
+            'performance_id' => $performance->id, 'name' => 'Regular',
+            'price_cents' => 50000, 'quantity_total' => 100,
+        ]);
+
+        $component = Livewire::actingAs($admin)
+            ->test(PerformancesRelationManager::class, [
+                'ownerRecord' => $performance->event,
+                'pageClass' => EditEvent::class,
+            ])
+            ->mountAction(TestAction::make('edit')->table($performance));
+
+        // The repeater keys its items by uuid, so the path has to be read
+        // back rather than guessed.
+        $data = $component->get('mountedActions.0.data');
+        $key = array_key_first($data['ticketTypes']);
+        $this->assertFalse((bool) $data['ticketTypes'][$key]['collect_member_names']);
+
+        // Typing 8 and leaving the field, which is what ->live(onBlur) does.
+        $component->set("mountedActions.0.data.ticketTypes.{$key}.admits", 8);
+
+        $this->assertTrue(
+            (bool) $component->get("mountedActions.0.data.ticketTypes.{$key}.collect_member_names"),
+            'Turning a category into a group must switch name collection on.',
+        );
+    }

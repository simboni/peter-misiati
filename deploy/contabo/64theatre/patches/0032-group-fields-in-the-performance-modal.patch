+                    [
+                        'name' => 'Group of 8',
+                        'price_kes' => 12000,
+                        'quantity_total' => 5,
+                        'max_per_order' => 1,
+                        'admits' => 8,
+                        'group_label' => 'Group of 8 — save 20%',
+                        'collect_member_names' => true,
+                    ],

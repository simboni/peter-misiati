diff --git a/app/Support/Phone.php b/app/Support/Phone.php
new file mode 100644
index 0000000..f5d1798
--- /dev/null
+++ b/app/Support/Phone.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Support;
+
+/**
+ * One canonical form for a Kenyan mobile number: 2547XXXXXXXX / 2541XXXXXXXX.
+ *
+ * Customers are identified by phone — `Customer::firstOrCreate(['phone' => …])`
+ * — and the number arrived from the form exactly as typed. So one person
+ * entering 0712345678 today and +254 712 345 678 tomorrow became two
+ * customers, with their tickets split between them and neither lookup finding
+ * both. It also meant nothing could reliably ask "does this buyer already have
+ * an order for this show?", which is what stops somebody paying twice.
+ *
+ * Stored without the leading `+`: that is the form the tickets table and the
+ * SMS sender already use, so it matches what is on the box office's screen.
+ */
+class Phone
+{
+    /** Canonical digits, or null if it is not a Kenyan mobile. */
+    public static function normalise(?string $phone): ?string
+    {
+        $digits = preg_replace('/\D/', '', (string) $phone);
+
+        if ($digits === '') {
+            return null;
+        }
+
+        if (str_starts_with($digits, '0')) {
+            $digits = '254'.substr($digits, 1);
+        } elseif (str_starts_with($digits, '7') || str_starts_with($digits, '1')) {
+            $digits = '254'.$digits;
+        }
+
+        return preg_match('/^254[71]\d{8}$/', $digits) ? $digits : null;
+    }
+
+    /**
+     * Normalise, or hand back the original.
+     *
+     * For paths that must not reject a number outright — a box-office sale to
+     * someone with a foreign phone, say. Better a record under an odd format
+     * than no record of who holds the ticket.
+     */
+    public static function normaliseOrKeep(?string $phone): ?string
+    {
+        return self::normalise($phone) ?? (filled($phone) ? trim((string) $phone) : null);
+    }
+
+    /** 2547XXXXXXXX → 0712 345 678, for reading back to a customer. */
+    public static function forHumans(?string $phone): string
+    {
+        $n = self::normalise($phone);
+
+        if ($n === null) {
+            return (string) $phone;
+        }
+
+        $local = '0'.substr($n, 3);
+
+        return substr($local, 0, 4).' '.substr($local, 4, 3).' '.substr($local, 7);
+    }
+}

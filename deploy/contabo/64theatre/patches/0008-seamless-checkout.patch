 <script>
+    // Three steps, client-side. The form posts exactly as before — stepping is
+    // only about how much is on screen at once, so checkout still works with
+    // JavaScript off: every step is revealed and the page behaves as the
+    // single long form it used to be.
+    document.querySelectorAll('form.booking').forEach(function (form) {
+        const steps = form.querySelectorAll('.step');
+        const crumbs = form.querySelectorAll('.steps li');
+        if (!steps.length) return;
+
+        steps.forEach(function (s) { s.hidden = s.dataset.step !== '1'; });
+
+        function show(n) {
+            steps.forEach(function (s) { s.hidden = s.dataset.step !== String(n); });
+            crumbs.forEach(function (li, i) { li.classList.toggle('on', i < n); });
+            if (n === 3) buildReview();
+            const head = form.closest('.perf');
+            if (head) head.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        }
+
+        function money(n) { return 'KES ' + n.toLocaleString('en-KE'); }
+
+        function lines() {
+            const out = [];
+            form.querySelectorAll('.trow').forEach(function (row) {
+                const input = row.querySelector('input.qty');
+                const qty = parseInt(input && input.value, 10) || 0;
+                if (qty < 1) return;
+                const price = parseInt(row.dataset.price || '0', 10);
+                const name = (row.querySelector('.tname') || {}).firstChild;
+                out.push({
+                    name: (name ? name.textContent : 'Ticket').trim(),
+                    qty: qty,
+                    subtotal: qty * price,
+                });
+            });
+            return out;
+        }
+
+        function total() { return lines().reduce(function (s, l) { return s + l.subtotal; }, 0); }
+
+        function refresh() {
+            const t = total();
+            const el = form.querySelector('.run-total');
+            if (el) el.textContent = money(t);
+            const next = form.querySelector('.step[data-step="1"] .step-next');
+            if (next) next.disabled = lines().length === 0;
+        }
+
+        function buildReview() {
+            const dl = form.querySelector('.review');
+            if (!dl) return;
+            dl.innerHTML = '';
+            lines().forEach(function (l) {
+                dl.insertAdjacentHTML('beforeend',
+                    '<dt>' + l.qty + ' × ' + l.name + '</dt><dd>' + money(l.subtotal) + '</dd>');
+            });
+            const phone = form.querySelector('[name="phone"]');
+            const email = form.querySelector('[name="email"]');
+            if (phone && phone.value) dl.insertAdjacentHTML('beforeend', '<dt>Prompt to</dt><dd>' + phone.value + '</dd>');
+            if (email && email.value) dl.insertAdjacentHTML('beforeend', '<dt>Tickets to</dt><dd>' + email.value + '</dd>');
+            dl.insertAdjacentHTML('beforeend', '<dt class="grand">Total</dt><dd class="grand">' + money(total()) + '</dd>');
+            const pt = form.querySelector('.pay-total');
+            if (pt) pt.textContent = money(total());
+        }
+
+        form.addEventListener('input', refresh);
+        form.addEventListener('click', function (e) {
+            const btn = e.target.closest('.step-next, .step-back');
+            if (!btn || !form.contains(btn)) return;
+            const to = parseInt(btn.dataset.goto, 10);
+            // Going forward validates the step being left; going back never
+            // does, or a half-filled form traps someone on it.
+            if (btn.classList.contains('step-next') && to > 2) {
+                const current = form.querySelector('.step[data-step="2"]');
+                const invalid = current && current.querySelector(':invalid');
+                if (invalid) { invalid.reportValidity(); return; }
+            }
+            show(to);
+        });
+
+        refresh();
+    });
+

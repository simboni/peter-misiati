diff --git a/app/Filament/Widgets/ServiceFees.php b/app/Filament/Widgets/ServiceFees.php
new file mode 100644
index 0000000..810fbaf
--- /dev/null
+++ b/app/Filament/Widgets/ServiceFees.php
@@ -0,0 +1,93 @@
+<?php
+
+namespace App\Filament\Widgets;
+
+use App\Models\Payment;
+use App\Support\PayHeroWallet;
+use App\Support\ServiceFeeSettings;
+use Filament\Widgets\StatsOverviewWidget;
+use Filament\Widgets\StatsOverviewWidget\Stat;
+
+/**
+ * What taking money costs — the other side of SalesOverview.
+ *
+ * Revenue without its cost of collection flatters every figure above it, and
+ * the prepaid service wallet is the one balance that silently stops a show
+ * selling. Both belong where the office already looks.
+ *
+ * Fees are an ESTIMATE from the agreed rate, and say so. PayHero's callbacks
+ * on this account report `cost: 0`, so a figure claimed as actual would be
+ * confidently wrong — see ServiceFeeSettings.
+ */
+class ServiceFees extends StatsOverviewWidget
+{
+    protected static ?int $sort = 4;
+
+    protected function getStats(): array
+    {
+        $wallet = PayHeroWallet::service();
+        $floor = ServiceFeeSettings::walletFloorCents();
+
+        $walletStat = match (true) {
+            $wallet === null => Stat::make('Service wallet', 'Unavailable')
+                ->description('PayHero could not be reached, or no credentials are set')
+                ->color('gray'),
+
+            $wallet['status'] !== null && $wallet['status'] !== 'ACTIVE' => Stat::make(
+                'Service wallet',
+                'KES '.number_format($wallet['balance_cents'] / 100),
+            )
+                ->description('Wallet is '.$wallet['status'].', not ACTIVE — prompts may be refused')
+                ->color('danger'),
+
+            $wallet['balance_cents'] < $floor => Stat::make(
+                'Service wallet',
+                'KES '.number_format($wallet['balance_cents'] / 100),
+            )
+                // The failure this prevents: an empty service wallet refuses
+                // every prompt while everything else still looks healthy.
+                ->description('Low — top up or M-Pesa prompts will stop')
+                ->color('danger'),
+
+            default => Stat::make('Service wallet', 'KES '.number_format($wallet['balance_cents'] / 100))
+                ->description('Prepaid balance PayHero spends per prompt')
+                ->color('success'),
+        };
+
+        if (! ServiceFeeSettings::anyRateSet()) {
+            return [
+                $walletStat,
+                Stat::make('Service fees', 'Not set')
+                    ->description('Enter the rates under Sales → Payment methods')
+                    ->color('gray'),
+            ];
+        }
+
+        // Only money that actually moved through the gateway carries a gateway
+        // fee. Cash at the door costs PayHero nothing and billing it would be
+        // wrong.
+        $base = Payment::where('status', 'confirmed')->whereIn('gateway', ['mpesa_stk', 'aggregator', 'card']);
+
+        $monthAmounts = (clone $base)->whereBetween('created_at', [now()->startOfMonth(), now()->endOfMonth()])
+            ->pluck('amount_cents');
+        $allAmounts = (clone $base)->pluck('amount_cents');
+
+        $feeOf = fn ($amounts) => $amounts->sum(fn (int $c) => ServiceFeeSettings::feeOnCents($c));
+
+        $monthFees = $feeOf($monthAmounts) + ServiceFeeSettings::platformMonthlyCents();
+        $allFees = $feeOf($allAmounts);
+
+        $rate = rtrim(rtrim(number_format(ServiceFeeSettings::percent(), 2), '0'), '.');
+        $flat = ServiceFeeSettings::flatCents();
+
+        return [
+            $walletStat,
+            Stat::make('Fees this month (est.)', 'KES '.number_format($monthFees / 100))
+                ->description($monthAmounts->count().' gateway payments · '.$rate.'%'
+                    .($flat > 0 ? ' + KES '.number_format($flat / 100).' each' : '')
+                    .(ServiceFeeSettings::platformMonthlyCents() > 0 ? ' + monthly fee' : '')),
+            Stat::make('Gateway fees to date (est.)', 'KES '.number_format($allFees / 100))
+                ->description('Excludes cash — only money that went through the gateway'),
+        ];
+    }
+}

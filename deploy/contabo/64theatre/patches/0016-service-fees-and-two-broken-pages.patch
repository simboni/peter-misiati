+<?php
+
+namespace App\Filament\Pages;
+
+use App\Models\Checkin;
+use App\Models\Performance;
+use App\Models\Ticket;
+use BackedEnum;
+use Filament\Forms\Components\Select;
+use Filament\Pages\Page;
+use Filament\Schemas\Components\EmbeddedSchema;
+use Filament\Schemas\Components\Form;
+use Filament\Schemas\Components\Section;
+use Filament\Schemas\Components\Text;
+use Filament\Schemas\Schema;
+use Filament\Support\Icons\Heroicon;
+
+/**
+ * How full the house is, right now.
+ *
+ * REPLACES A BROKEN MENU ITEM. The Door menu linked "Door stats" straight at
+ * route('gate.stats'), which is a JSON endpoint for the scanner's own polling
+ * and needs a performance_id it was never given. Clicking it showed the office
+ * {"checked_in":0,"issued":0} — raw JSON, always zero, no way back. A menu
+ * item must point at a page; that was my mistake and this is the page.
+ *
+ * Deliberately read-only. Admitting and verifying already have their own
+ * screens, and a count somebody is watching during a performance should not
+ * also be a place where a ticket can be spent by a mis-click.
+ */
+class DoorStats extends Page
+{
+    protected static string|BackedEnum|null $navigationIcon = Heroicon::OutlinedChartBar;
+
+    protected static string|\UnitEnum|null $navigationGroup = 'Door';
+
+    protected static ?int $navigationSort = 4;
+
+    protected static ?string $title = 'Door stats';
+
+    protected static ?string $slug = 'door-stats';
+
+    /** @var array<string, mixed>|null */
+    public ?array $data = [];
+
+    public static function canAccess(): bool
+    {
+        return in_array(auth()->user()?->role, ['super_admin', 'admin', 'finance', 'gate'], true);
+    }
+
+    public function mount(): void
+    {
+        $this->form->fill([
+            // Tonight's performance, not the newest record. Yesterday is still
+            // offered because a late-night show is settled the next morning.
+            'performance_id' => Performance::query()
+                ->where('starts_at', '>=', now()->subDay())
+                ->orderBy('starts_at')
+                ->value('id'),
+        ]);
+    }
+
+    public function form(Schema $schema): Schema
+    {
+        return $schema
+            ->components([
+                Select::make('performance_id')
+                    ->label('Performance')
+                    ->live()
+                    ->native(false)
+                    ->options(fn (): array => Performance::with('event')
+                        ->orderByDesc('starts_at')
+                        ->limit(60)
+                        ->get()
+                        ->mapWithKeys(fn (Performance $p): array => [
+                            $p->id => ($p->event?->title ?? 'Performance')
+                                .' — '.$p->starts_at?->format('D j M, H:i'),
+                        ])
+                        ->all()),
+            ])
+            ->statePath('data');
+    }
+
+    /** @return array<string, int|string> */
+    public function figures(): array
+    {
+        $id = (int) ($this->data['performance_id'] ?? 0);
+
+        if ($id === 0) {
+            return [];
+        }
+
+        $issued = Ticket::where('performance_id', $id)->whereIn('status', ['issued', 'redeemed'])->count();
+        $in = Checkin::where('performance_id', $id)->count();
+
+        return [
+            'issued' => $issued,
+            'in' => $in,
+            'out' => max($issued - $in, 0),
+            // Guarded: a performance with nothing issued would divide by zero,
+            // and an empty house is exactly when somebody opens this page.
+            'pct' => $issued > 0 ? (int) round($in / $issued * 100) : 0,
+        ];
+    }
+
+    public function content(Schema $schema): Schema
+    {
+        return $schema->components([
+            Form::make([EmbeddedSchema::make('form')])->id('form'),
+
+            Section::make('Tonight')
+                ->visible(fn (): bool => $this->figures() !== [])
+                ->schema([
+                    Text::make(function (): string {
+                        $f = $this->figures();
+
+                        return $f === []
+                            ? ''
+                            : "{$f['in']} of {$f['issued']} admitted ({$f['pct']}%) · {$f['out']} still to arrive";
+                    }),
+                ]),
+
+            Section::make()
+                ->visible(fn (): bool => $this->figures() === [])
+                ->schema([
+                    Text::make('Choose a performance to see how many have come in.'),
+                ]),
+        ]);
+    }
+}

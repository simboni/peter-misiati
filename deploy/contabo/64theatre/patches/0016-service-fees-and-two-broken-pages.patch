 namespace App\Filament\Resources\Orders\Pages;
 
+use App\Exceptions\SoldOutException;
 use App\Filament\Resources\Orders\OrderResource;
+use App\Models\Payment;
+use App\Services\Checkout;
+use Filament\Notifications\Notification;
 use Filament\Resources\Pages\CreateRecord;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Str;
 
+/**
+ * Creating an order from the office.
+ *
+ * The record is NOT built here. Everything that makes an order real — the
+ * oversell guard, promo validation, customer de-duplication by phone, the
+ * uuid, the totals and the tickets themselves — lives in Checkout, which the
+ * website and the box office already use. This page only translates the form
+ * into that call, so the desk and the website cannot drift apart.
+ */
 class CreateOrder extends CreateRecord
 {
     protected static string $resource = OrderResource::class;
+
+    protected function handleRecordCreation(array $data): Model
+    {
+        // ticket_type_id => quantity, summed rather than assigned so two rows
+        // of the same type do not silently overwrite each other.
+        $items = [];
+
+        foreach ($data['lines'] ?? [] as $line) {
+            $id = (int) ($line['ticket_type_id'] ?? 0);
+            $qty = (int) ($line['quantity'] ?? 0);
+
+            if ($id > 0 && $qty > 0) {
+                $items[$id] = ($items[$id] ?? 0) + $qty;
+            }
+        }
+
+        if ($items === []) {
+            Notification::make()->title('Add at least one ticket')->danger()->send();
+            $this->halt();
+        }
+
+        try {
+            $order = app(Checkout::class)->startOrder(
+                items: $items,
+                phone: (string) $data['phone'],
+                name: $data['name'] ?? null,
+                channel: $data['channel'] ?? 'box_office',
+                marketingConsent: false,
+                promoCode: ($data['promo_code'] ?? null) ?: null,
+                email: ($data['email'] ?? null) ?: null,
+            );
+        } catch (SoldOutException $e) {
+            // The guard that matters: without it the desk can sell a seat the
+            // website has already sold.
+            Notification::make()
+                ->title('Not enough tickets left')
+                ->body($e->getMessage())
+                ->danger()
+                ->send();
+            $this->halt();
+        }
+
+        if (! ($data['mark_paid'] ?? false)) {
+            Notification::make()
+                ->title('Order created, unpaid')
+                ->body('No tickets are issued until it is paid.')
+                ->warning()
+                ->send();
+
+            return $order;
+        }
+
+        $payment = Payment::create([
+            'order_id' => $order->id,
+            // Only ever a method a human can genuinely vouch for — M-Pesa is
+            // kept out of the form for the same reason.
+            'gateway' => $data['payment_method'] ?? 'cash',
+            'gateway_ref' => ($data['payment_reference'] ?? null) ?: 'DESK-'.strtoupper(Str::random(8)),
+            'payer_phone' => $data['phone'],
+            'amount_cents' => $order->total_cents,
+            'status' => 'initiated',
+        ]);
+
+        $order = app(Checkout::class)->confirm($order, $payment);
+
+        Notification::make()
+            ->title('Paid — tickets issued')
+            ->body($order->tickets()->count().' ticket(s) for KES '.number_format($order->total_cents / 100).'.')
+            ->success()
+            ->send();
+
+        return $order;
+    }
+
+    // Suppressed: the messages above already said what happened, with numbers.
+    protected function getCreatedNotification(): ?Notification
+    {
+        return null;
+    }
+
+    protected function getRedirectUrl(): string
+    {
+        return static::getResource()::getUrl('view', ['record' => $this->getRecord()]);
+    }
 }

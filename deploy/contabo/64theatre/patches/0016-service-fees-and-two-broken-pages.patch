diff --git a/app/Support/PayHeroWallet.php b/app/Support/PayHeroWallet.php
new file mode 100644
index 0000000..2e00787
--- /dev/null
+++ b/app/Support/PayHeroWallet.php
@@ -0,0 +1,96 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Support\Facades\Cache;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * The prepaid SERVICE wallet balance, read from PayHero.
+ *
+ * This is the number that stops a show selling. PayHero spends the service
+ * wallet to send each STK prompt — separate from the money being collected —
+ * and an empty one refuses every prompt while the credentials, the channel and
+ * the callbacks all still look perfect. It is the least obvious failure in the
+ * whole payment path, so it belongs on the dashboard rather than in a script
+ * somebody remembers to run.
+ *
+ * THREE RULES, because this is a live third-party call on a page load:
+ *   · cached for five minutes — a dashboard refresh must not hammer PayHero;
+ *   · a short timeout — a slow gateway must not hold the admin open;
+ *   · every failure returns null, never an exception. An unreachable API is a
+ *     "balance unavailable" note, not a broken dashboard.
+ *
+ * The response shape was confirmed against the live account: a list of wallet
+ * objects, each tagged `wallet_type`, holding `available_balance`. It is NOT a
+ * flat `service_balance` key, which is the obvious guess and is wrong.
+ */
+class PayHeroWallet
+{
+    private const CACHE_KEY = 'payhero:service_wallet';
+
+    private const TTL_SECONDS = 300;
+
+    /** @return array{balance_cents:int,status:?string}|null */
+    public static function service(): ?array
+    {
+        if (! config('services.payhero.username') || ! config('services.payhero.password')) {
+            return null;
+        }
+
+        return Cache::remember(self::CACHE_KEY, self::TTL_SECONDS, fn () => self::fetch());
+    }
+
+    public static function forget(): void
+    {
+        Cache::forget(self::CACHE_KEY);
+    }
+
+    /** @return array{balance_cents:int,status:?string}|null */
+    private static function fetch(): ?array
+    {
+        try {
+            $response = Http::withBasicAuth(
+                (string) config('services.payhero.username'),
+                (string) config('services.payhero.password'),
+            )
+                ->timeout(8)
+                ->acceptJson()
+                ->get(rtrim((string) config('services.payhero.base_url'), '/').'/api/v2/wallets');
+
+            if (! $response->successful()) {
+                return null;
+            }
+
+            $body = $response->json();
+
+            // The endpoint has been seen returning a bare list, and a list
+            // wrapped under `data` or `wallets`. Accept all three rather than
+            // betting on one.
+            $rows = is_array($body) && array_is_list($body)
+                ? $body
+                : ($body['data'] ?? $body['wallets'] ?? [$body]);
+
+            foreach ($rows as $wallet) {
+                if (! is_array($wallet) || ($wallet['wallet_type'] ?? null) !== 'service_wallet') {
+                    continue;
+                }
+
+                return [
+                    // PayHero reports whole shillings; the rest of this app
+                    // counts in cents and mixing the two silently is how a
+                    // balance reads 100× too low.
+                    'balance_cents' => (int) round(((float) ($wallet['available_balance'] ?? 0)) * 100),
+                    'status' => $wallet['wallet_status'] ?? null,
+                ];
+            }
+
+            return null;
+        } catch (\Throwable $e) {
+            Log::warning('payhero.wallet_lookup_failed', ['error' => $e->getMessage()]);
+
+            return null;
+        }
+    }
+}
diff --git a/app/Support/ServiceFeeSettings.php b/app/Support/ServiceFeeSettings.php
new file mode 100644
index 0000000..d6cf79f
--- /dev/null
+++ b/app/Support/ServiceFeeSettings.php
@@ -0,0 +1,71 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Setting;
+
+/**
+ * What it costs 64 Theatre to take money — the gateway's cut and the platform
+ * fee — expressed as rates the office enters, not numbers somebody asserts.
+ *
+ * WHY RATES AND NOT RECORDED COSTS. PayHero does not reliably report a
+ * per-transaction cost back to us: the callbacks observed on this account
+ * carry `cost: 0`, so a figure read from them would be confidently wrong.
+ * What IS known is the agreed rate, so the fee is derived from confirmed
+ * payments at that rate and labelled an estimate, which is honest. If PayHero
+ * ever starts returning a real cost, prefer it over this.
+ *
+ * Rates default to zero. A charge nobody has agreed must never appear by
+ * itself on a dashboard somebody makes decisions from.
+ */
+class ServiceFeeSettings
+{
+    public const KEY_PERCENT = 'fees.gateway_percent';
+
+    public const KEY_FLAT_CENTS = 'fees.gateway_flat_cents';
+
+    public const KEY_PLATFORM_MONTHLY_CENTS = 'fees.platform_monthly_cents';
+
+    public const KEY_WALLET_FLOOR_CENTS = 'fees.wallet_floor_cents';
+
+    /** Percentage of each collection taken by the gateway. */
+    public static function percent(): float
+    {
+        return (float) (Setting::get(self::KEY_PERCENT) ?? 0);
+    }
+
+    /** Flat charge per transaction, in cents. */
+    public static function flatCents(): int
+    {
+        return (int) (Setting::get(self::KEY_FLAT_CENTS) ?? 0);
+    }
+
+    /** Monthly platform/support fee, in cents. */
+    public static function platformMonthlyCents(): int
+    {
+        return (int) (Setting::get(self::KEY_PLATFORM_MONTHLY_CENTS) ?? 0);
+    }
+
+    /**
+     * Below this the service wallet is called low on the dashboard.
+     *
+     * PayHero spends the SERVICE wallet to send each prompt, and an empty one
+     * refuses every request while the credentials and channel still look
+     * perfect — so this is a warning worth having before a show, not after.
+     */
+    public static function walletFloorCents(): int
+    {
+        return (int) (Setting::get(self::KEY_WALLET_FLOOR_CENTS) ?? 20000);
+    }
+
+    /** Estimated fee on one collection, in cents. */
+    public static function feeOnCents(int $amountCents): int
+    {
+        return (int) round($amountCents * self::percent() / 100) + self::flatCents();
+    }
+
+    public static function anyRateSet(): bool
+    {
+        return self::percent() > 0 || self::flatCents() > 0 || self::platformMonthlyCents() > 0;
+    }
+}

+    public function test_every_value_on_the_page_round_trips(): void
+    {
+        $this->withWorkingGateway();
+
+        Livewire::actingAs($this->admin())
+            ->test(Settings::class)
+            ->fillForm([
+                'gateway' => 'payhero',
+                'online_enabled' => false,
+                'offline_enabled' => true,
+
+                'fee_percent' => 2.5,
+                'fee_flat' => 7,
+                'platform_monthly' => 4500,
+                'wallet_floor' => 300,
+
+                'referrals_enabled' => true,
+                'referrals_percent' => 12.5,
+                'referrals_hold_hours' => 24,
+                'referrals_per_order_cap' => 50,
+                'referrals_allow_with_promo' => true,
+            ])
+            ->call('save')
+            ->assertHasNoFormErrors();
+
+        // Read back through the classes the rest of the app uses, not the
+        // raw rows — a value stored under the wrong key would still be in
+        // the table and still be invisible to everything that matters.
+        $this->assertSame('payhero', PaymentSettings::gateway());
+        $this->assertFalse(PaymentSettings::onlineEnabled());
+        $this->assertTrue(PaymentSettings::offlineEnabled());
+
+        $this->assertSame(2.5, ServiceFeeSettings::percent());
+        // Entered in shillings, stored in cents.
+        $this->assertSame(700, ServiceFeeSettings::flatCents());
+        $this->assertSame(450000, ServiceFeeSettings::platformMonthlyCents());
+        $this->assertSame(30000, ServiceFeeSettings::walletFloorCents());
+
+        $this->assertTrue(ReferralSettings::enabled());
+        $this->assertSame(12.5, ReferralSettings::percent());
+        $this->assertSame(24, ReferralSettings::holdHours());
+        $this->assertSame(5000, ReferralSettings::perOrderCapCents());
+        $this->assertTrue(ReferralSettings::allowWithPromo());
+    }

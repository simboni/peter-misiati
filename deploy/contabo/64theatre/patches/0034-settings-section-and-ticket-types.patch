+++ b/app/Filament/Pages/Settings.php
@@ -0,0 +1,433 @@
+<?php
+
+namespace App\Filament\Pages;
+
+use App\Models\AuditLog;
+use App\Models\Setting;
+use App\Support\PayHeroWallet;
+use App\Support\PaymentSettings;
+use App\Support\ReferralSettings;
+use App\Support\ServiceFeeSettings;
+use BackedEnum;
+use Filament\Actions\Action;
+use Filament\Forms\Components\Select;
+use Filament\Forms\Components\TextInput;
+use Filament\Forms\Components\Toggle;
+use Filament\Notifications\Notification;
+use Filament\Pages\Page;
+use Filament\Schemas\Components\Actions;
+use Filament\Schemas\Components\EmbeddedSchema;
+use Filament\Schemas\Components\Form;
+use Filament\Schemas\Components\Section;
+use Filament\Schemas\Components\Tabs;
+use Filament\Schemas\Components\Tabs\Tab;
+use Filament\Schemas\Components\Text;
+use Filament\Schemas\Schema;
+use Filament\Support\Icons\Heroicon;
+
+/**
+ * Everything the theatre can change without a deploy, in one place.
+ *
+ * It used to be two pages in two different sidebar groups — payments and
+ * service fees under Sales, the referral programme under Marketing — and
+ * anything not on one of them was invisible. Somebody setting the place up
+ * had to be told where each switch lived, which is a poor substitute for a
+ * settings screen.
+ *
+ * WHAT IS HERE AND WHAT IS NOT IS THE WHOLE DESIGN.
+ *
+ * Switches live here. CREDENTIALS DO NOT, and that is deliberate and not
+ * negotiable: a form that could change where money settles would turn a
+ * stolen admin session into a theft. Gateway keys, the M-Pesa channel, the
+ * mail password and the SMS key stay in the server environment, and the last
+ * tab shows what is configured so you can see the state without being able to
+ * change it from a browser.
+ *
+ * Super admin only. Every save is written to the audit log with the previous
+ * values, because "it used to be 10%" is the question somebody always asks.
+ */
+class Settings extends Page
+{
+    protected static string|BackedEnum|null $navigationIcon = Heroicon::OutlinedCog6Tooth;
+
+    protected static string|\UnitEnum|null $navigationGroup = 'Settings';
+
+    protected static ?string $navigationLabel = 'All settings';
+
+    protected static ?int $navigationSort = 1;
+
+    protected static ?string $title = 'Settings';
+
+    protected static ?string $slug = 'settings';
+
+    /** @var array<string, mixed>|null */
+    public ?array $data = [];
+
+    public static function canAccess(): bool
+    {
+        return auth()->user()?->role === 'super_admin';
+    }
+
+    public function mount(): void
+    {
+        $this->form->fill(self::current());
+    }
+
+    /** Every value this page owns, read from where it actually lives. */
+    private static function current(): array
+    {
+        return [
+            'gateway' => PaymentSettings::gateway(),
+            'online_enabled' => PaymentSettings::onlineEnabled(),
+            'offline_enabled' => PaymentSettings::offlineEnabled(),
+
+            'fee_percent' => ServiceFeeSettings::percent(),
+            'fee_flat' => ServiceFeeSettings::flatCents() / 100,
+            'platform_monthly' => ServiceFeeSettings::platformMonthlyCents() / 100,
+            'wallet_floor' => ServiceFeeSettings::walletFloorCents() / 100,
+
+            'referrals_enabled' => ReferralSettings::enabled(),
+            'referrals_percent' => ReferralSettings::percent(),
+            'referrals_hold_hours' => ReferralSettings::holdHours(),
+            'referrals_per_order_cap' => ReferralSettings::perOrderCapCents() / 100,
+            'referrals_allow_with_promo' => ReferralSettings::allowWithPromo(),
+        ];
+    }
+
+    public function form(Schema $schema): Schema
+    {
+        return $schema
+            ->components([
+                Tabs::make('settings')->tabs([
+                    Tab::make('Taking money')
+                        ->icon(Heroicon::OutlinedCreditCard)
+                        ->schema($this->paymentFields()),
+
+                    Tab::make('What it costs us')
+                        ->icon(Heroicon::OutlinedReceiptPercent)
+                        ->schema($this->feeFields()),
+
+                    Tab::make('Selling on commission')
+                        ->icon(Heroicon::OutlinedMegaphone)
+                        ->schema($this->referralFields()),
+
+                    Tab::make('Server')
+                        ->icon(Heroicon::OutlinedServerStack)
+                        ->schema($this->serverFields()),
+                ]),
+            ])
+            ->statePath('data');
+    }
+
+    /** @return array<int, mixed> */
+    private function paymentFields(): array
+    {
+        return [
+            Section::make('Paying online')
+                ->description('How buyers pay on the website.')
+                ->schema([
+                    Toggle::make('online_enabled')
+                        ->label('Accept payments online')
+                        ->helperText('Off: the website still shows events, but checkout is refused and nobody can start a payment. Use it when a gateway is down, rather than letting buyers fail one by one.'),
+                    Select::make('gateway')
+                        ->label('Provider')
+                        ->options(PaymentSettings::selectableGateways())
+                        ->required()
+                        ->native(false)
+                        ->helperText('Credentials for each provider live in the server environment, not here.')
+                        // Refuses a provider that would fail on the first
+                        // checkout. Better to be told now than by a buyer.
+                        ->rule(fn (): \Closure => function (string $attribute, $value, \Closure $fail): void {
+                            if (! PaymentSettings::credentialsPresent($value)) {
+                                $fail('No credentials are configured for that provider. Set them in the server environment first, or nobody will be able to pay.');
+                            }
+                        }),
+                    Text::make(fn (): string => self::paymentStatusLine()),
+                ]),
+
+            Section::make('Paying by hand')
+                ->description('M-Pesa Pay Bill details shown on an unpaid order.')
+                ->schema([
+                    Toggle::make('offline_enabled')
+                        ->label('Show Pay Bill details to buyers')
+                        ->helperText(
+                            'Pay Bill '.config('services.offline_payment.paybill')
+                            .', account '.config('services.offline_payment.account')
+                            .'. These payments are NOT matched to an order automatically — the account number identifies the theatre, not the order — so somebody has to reconcile them by hand. Leave this off until you have a process for that.',
+                        ),
+                ]),
+        ];
+    }
+
+    /** @return array<int, mixed> */
+    private function feeFields(): array
+    {
+        return [
+            Section::make('What it costs us to take money')
+                ->description('Drives the Service fees panel on the dashboard.')
+                ->schema([
+                    TextInput::make('fee_percent')
+                        ->label('Gateway fee (% of each collection)')
+                        ->numeric()->minValue(0)->maxValue(100)->step('0.01')->default(0)
+                        ->helperText('The agreed rate. Fees are ESTIMATED from it, because PayHero reports cost: 0 on this account — a figure taken from the callbacks would be confidently wrong.'),
+                    TextInput::make('fee_flat')
+                        ->label('Gateway fee (flat, per transaction, KES)')
+                        ->numeric()->minValue(0)->default(0),
+                    TextInput::make('platform_monthly')
+                        ->label('Platform & support (per month, KES)')
+                        ->numeric()->minValue(0)->default(0),
+                    TextInput::make('wallet_floor')
+                        ->label('Warn when the service wallet falls below (KES)')
+                        ->numeric()->minValue(0)->default(200)
+                        ->helperText('PayHero spends a PREPAID service wallet to send each prompt, separate from the money collected. An empty one refuses every prompt while the credentials and channel still look perfect — so it is worth being warned before a show, not during one.'),
+                ]),
+        ];
+    }
+
+    /** @return array<int, mixed> */
+    private function referralFields(): array
+    {
+        return [
+            Section::make('The programme')
+                ->description('Members of the public selling tickets for a share of the takings.')
+                ->schema([
+                    Toggle::make('referrals_enabled')
+                        ->label('Run a referral programme')
+                        ->helperText('Off: the signup page at /sell-tickets is not reachable, existing links still take people to the site but earn nothing, and nothing new accrues. Commission already earned is untouched either way.'),
+                    TextInput::make('referrals_percent')
+                        ->label('House rate (% of each sale)')
+                        ->numeric()->minValue(0)->maxValue(100)->step('0.01')->default(0)
+                        ->helperText('What a seller earns unless they have their own negotiated rate. Applies to sales from now on — commission already earned keeps the rate it was earned at.'),
+                    Text::make(fn (): string => self::referralStatusLine()),
+                ]),
+
+            Section::make('When commission may be paid')
+                ->schema([
+                    TextInput::make('referrals_hold_hours')
+                        ->label('Hours after the performance before it may be paid')
+                        ->numeric()->minValue(0)->default(48)
+                        ->helperText('Measured from the SHOW, not the sale. A hold measured from the sale would mature on a production cancelled weeks later, and the theatre would have paid commission on tickets it then refunded.'),
+                ]),
+
+            Section::make('Limits')
+                ->schema([
+                    TextInput::make('referrals_per_order_cap')
+                        ->label('Most any single order may earn (KES)')
+                        ->numeric()->minValue(0)->default(0)
+                        ->helperText('0 means no cap. Without one, a single group booking at KES 12,000 becomes an unexpectedly large payment to a stranger.'),
+                    Toggle::make('referrals_allow_with_promo')
+                        ->label('Pay commission on discounted orders too')
+                        ->helperText('Off by default. A promo code and a commission on the same sale can take the margin below zero; off, the attribution is dropped rather than paid quietly.'),
+                    /*
+                     * No donations toggle. It could never have worked — the
+                     * donation checkout carries no referral at all — and a
+                     * switch that tells an operator donations are earning
+                     * while they are not is worse than no switch.
+                     */
+                    Text::make('Donations never earn commission. A gift to the theatre is a different proposition from a ticket sale, and the donation checkout does not carry a referral.'),
+                ]),
+        ];
+    }
+
+    /**
+     * Read-only. Everything on this tab lives in the server environment.
+     *
+     * It is here because "is email actually set up?" is a real question with a
+     * real answer, and the alternative is somebody guessing from whether a
+     * ticket arrived. None of it is editable from a browser on purpose: these
+     * are the values that decide where money and messages go.
+     *
+     * @return array<int, mixed>
+     */
+    private function serverFields(): array
+    {
+        return [
+            Section::make('What the server is configured with')
+                ->description('Read-only. These live in the server environment — a browser form that could change where money settles would make a stolen admin session into a theft.')
+                ->schema([
+                    Text::make(fn (): string => self::envLine()),
+                    Text::make(fn (): string => self::mailLine()),
+                    Text::make(fn (): string => self::smsLine()),
+                    Text::make(fn (): string => self::brandLine()),
+                ]),
+
+            Section::make('Scheduled work')
+                ->description('Jobs that run on a timer, not when somebody clicks.')
+                ->schema([
+                    Text::make('Releasing seats from abandoned checkouts runs every minute. Promoting referral commission to payable runs hourly. BOTH need a cron entry on the server — the container has no cron of its own. If seats are never coming back from abandoned checkouts, that is the one to check: deploy/contabo/64theatre/scheduler.sh --status'),
+                ]),
+        ];
+    }
+
+    private static function paymentStatusLine(): string
+    {
+        $gateway = PaymentSettings::gateway();
+        $name = PaymentSettings::selectableGateways()[$gateway] ?? $gateway;
+
+        if (! PaymentSettings::credentialsPresent($gateway)) {
+            return "⚠ {$name} is selected but its credentials are missing — checkout will fail.";
+        }
+
+        if (PaymentSettings::isSandbox($gateway)) {
+            return "⚠ {$name} is pointed at its TEST environment. Payments will look successful and no real money will move.";
+        }
+
+        return "✓ {$name} is configured and live.";
+    }
+
+    private static function referralStatusLine(): string
+    {
+        if (! ReferralSettings::enabled()) {
+            return '○ The programme is off. /sell-tickets is not reachable and no link earns.';
+        }
+
+        $rate = ReferralSettings::percent();
+
+        if ($rate <= 0) {
+            return '⚠ The programme is ON but the house rate is 0%. Sellers can sign up and nothing will ever be earned, unless each has their own rate set.';
+        }
+
+        return '✓ Live at '.self::trimPercent($rate).'%, held until '
+            .ReferralSettings::holdHours().' hours after each show.';
+    }
+
+    private static function envLine(): string
+    {
+        $env = app()->environment();
+        $url = config('app.url');
+
+        if ($env !== 'production') {
+            return "⚠ Running as {$env}, not production, at {$url}. Demo content may be re-seeded on every boot.";
+        }
+
+        return "✓ Production, at {$url}. Ticket QR codes and emailed links are built from that address, so it must match the public one exactly.";
+    }
+
+    private static function mailLine(): string
+    {
+        $mailer = config('mail.default');
+
+        if ($mailer === 'log') {
+            return '⚠ Email is set to "log" — ticket emails are written to the container log and delivered to NOBODY. Fine for a demo, silent failure once real tickets are sold.';
+        }
+
+        $from = config('mail.from.address');
+
+        return "✓ Email goes out through {$mailer} as {$from}. That address has to be one the provider has verified, or it rejects the message.";
+    }
+
+    private static function smsLine(): string
+    {
+        return config('services.notifications.sms_enabled')
+            ? '✓ SMS is on.'
+            : '○ SMS is off. Nothing is texted to buyers or sellers — email only.';
+    }
+
+    private static function brandLine(): string
+    {
+        $site = config('services.brand.website');
+
+        return $site
+            ? "✓ Tickets and emails link to {$site}."
+            : '○ No public website set, so tickets and emails carry no link back. Set BRAND_WEBSITE on the server.';
+    }
+
+    /** 10.00 → 10, 12.50 → 12.5. */
+    private static function trimPercent(float $value): string
+    {
+        return rtrim(rtrim(number_format($value, 2), '0'), '.');
+    }
+
+    public function save(): void
+    {
+        $data = $this->form->getState();
+        $before = self::current();
+
+        Setting::put(PaymentSettings::KEY_GATEWAY, $data['gateway']);
+        Setting::put(PaymentSettings::KEY_ONLINE_ENABLED, $data['online_enabled'] ? '1' : '0');
+        Setting::put(PaymentSettings::KEY_OFFLINE_ENABLED, $data['offline_enabled'] ? '1' : '0');
+
+        // Entered in shillings because that is what the agreement is written
+        // in; stored in cents because that is what every other amount in this
+        // app is, and one mixed unit is all it takes to be 100x out.
+        Setting::put(ServiceFeeSettings::KEY_PERCENT, (string) ((float) ($data['fee_percent'] ?? 0)));
+        Setting::put(ServiceFeeSettings::KEY_FLAT_CENTS, (string) (int) round(((float) ($data['fee_flat'] ?? 0)) * 100));
+        Setting::put(ServiceFeeSettings::KEY_PLATFORM_MONTHLY_CENTS, (string) (int) round(((float) ($data['platform_monthly'] ?? 0)) * 100));
+        Setting::put(ServiceFeeSettings::KEY_WALLET_FLOOR_CENTS, (string) (int) round(((float) ($data['wallet_floor'] ?? 0)) * 100));
+
+        Setting::put(ReferralSettings::KEY_ENABLED, $data['referrals_enabled'] ? '1' : '0');
+        Setting::put(ReferralSettings::KEY_PERCENT, (string) ((float) ($data['referrals_percent'] ?? 0)));
+        Setting::put(ReferralSettings::KEY_HOLD_HOURS, (string) (int) ($data['referrals_hold_hours'] ?? 48));
+        Setting::put(ReferralSettings::KEY_PER_ORDER_CAP, (string) (int) round(((float) ($data['referrals_per_order_cap'] ?? 0)) * 100));
+        Setting::put(ReferralSettings::KEY_ALLOW_WITH_PROMO, $data['referrals_allow_with_promo'] ? '1' : '0');
+
+        // The dashboard caches the wallet balance for five minutes; somebody
+        // who has just topped up should not have to wait it out.
+        PayHeroWallet::forget();
+
+        // Only what actually moved. A log entry listing eleven unchanged
+        // values is one nobody reads.
+        $after = self::current();
+        $changed = array_keys(array_filter(
+            $after,
+            fn ($value, $key) => ($before[$key] ?? null) != $value,
+            ARRAY_FILTER_USE_BOTH,
+        ));
+
+        if ($changed !== []) {
+            AuditLog::create([
+                'user_id' => auth()->id(),
+                'organiser_id' => auth()->user()?->organiser_id,
+                'action' => 'settings.changed',
+                'subject_type' => Setting::class,
+                'subject_id' => null,
+                'changes' => [
+                    'fields' => $changed,
+                    'from' => array_intersect_key($before, array_flip($changed)),
+                    'to' => array_intersect_key($after, array_flip($changed)),
+                ],
+            ]);
+        }
+
+        Notification::make()
+            ->title($changed === [] ? 'Nothing changed' : 'Settings saved')
+            ->body($changed === []
+                ? 'Everything was already set that way.'
+                : self::consequenceLine($after))
+            ->success()
+            ->send();
+    }
+
+    /** What the operator has just done, in a sentence about the world. */
+    private static function consequenceLine(array $now): string
+    {
+        $lines = [];
+
+        $lines[] = $now['online_enabled']
+            ? 'Online checkout is ON through '.(PaymentSettings::selectableGateways()[$now['gateway']] ?? $now['gateway']).'.'
+            : 'Online checkout is OFF — nobody can pay on the website.';
+
+        if ($now['referrals_enabled']) {
+            $lines[] = 'Referrals are live at '.self::trimPercent((float) $now['referrals_percent']).'%.';
+        }
+
+        return implode(' ', $lines);
+    }
+
+    public function content(Schema $schema): Schema
+    {
+        return $schema->components([
+            Form::make([EmbeddedSchema::make('form')])
+                ->id('form')
+                ->livewireSubmitHandler('save')
+                ->footer([
+                    Actions::make([
+                        Action::make('save')
+                            ->label('Save settings')
+                            ->submit('save')
+                            ->keyBindings(['mod+s']),
+                    ])->key('form-actions'),
+                ]),
+        ]);
+    }
+}

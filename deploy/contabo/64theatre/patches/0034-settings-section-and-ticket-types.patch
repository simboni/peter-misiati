-<?php
-
-namespace App\Filament\Pages;
-
-use App\Models\AuditLog;
-use App\Models\Setting;
-use App\Support\ReferralSettings;
-use BackedEnum;
-use Filament\Actions\Action;
-use Filament\Forms\Components\TextInput;
-use Filament\Forms\Components\Toggle;
-use Filament\Notifications\Notification;
-use Filament\Pages\Page;
-use Filament\Schemas\Components\Actions;
-use Filament\Schemas\Components\EmbeddedSchema;
-use Filament\Schemas\Components\Form;
-use Filament\Schemas\Components\Section;
-use Filament\Schemas\Components\Text;
-use Filament\Schemas\Schema;
-use Filament\Support\Icons\Heroicon;
-
-/**
- * The terms of the referral programme, in a place the office can change them.
- *
- * Everything starts off or at zero, and the switch at the top is the whole
- * point of this page: until somebody with the authority to promise money
- * turns it on, /sell-tickets does not exist and no link earns anything.
- *
- * Changing the rate affects FUTURE sales only. Every commission freezes the
- * rate it was earned at, so a change here cannot rewrite what somebody was
- * already told they would get.
- *
- * Super admin only, and every change is logged with what it was before.
- */
-class ReferralProgramme extends Page
-{
-    protected static string|BackedEnum|null $navigationIcon = Heroicon::OutlinedMegaphone;
-
-    protected static string|\UnitEnum|null $navigationGroup = 'Marketing';
-
-    protected static ?int $navigationSort = 22;
-
-    protected static ?string $title = 'Referral programme';
-
-    protected static ?string $slug = 'referral-programme';
-
-    /** @var array<string, mixed>|null */
-    public ?array $data = [];
-
-    public static function canAccess(): bool
-    {
-        return auth()->user()?->role === 'super_admin';
-    }
-
-    public function mount(): void
-    {
-        $this->form->fill([
-            'enabled' => ReferralSettings::enabled(),
-            'percent' => ReferralSettings::percent(),
-            'hold_hours' => ReferralSettings::holdHours(),
-            'per_order_cap' => ReferralSettings::perOrderCapCents() / 100,
-            'allow_with_promo' => ReferralSettings::allowWithPromo(),
-        ]);
-    }
-
-    public function form(Schema $schema): Schema
-    {
-        return $schema
-            ->components([
-                Section::make('The programme')
-                    ->description('Members of the public selling tickets for a share of the takings.')
-                    ->schema([
-                        Toggle::make('enabled')
-                            ->label('Run a referral programme')
-                            ->helperText('Off: the signup page at /sell-tickets is not reachable, existing links still take people to the site but earn nothing, and nothing new accrues. Commission already earned is untouched either way.'),
-                        TextInput::make('percent')
-                            ->label('House rate (% of each sale)')
-                            ->numeric()->minValue(0)->maxValue(100)->step('0.01')->default(0)
-                            ->helperText('What a seller earns unless they have their own negotiated rate. Applies to sales from now on — commission already earned keeps the rate it was earned at.'),
-                        Text::make(fn (): string => self::statusLine()),
-                    ]),
-
-                Section::make('When commission may be paid')
-                    ->schema([
-                        TextInput::make('hold_hours')
-                            ->label('Hours after the performance before it may be paid')
-                            ->numeric()->minValue(0)->default(48)
-                            ->helperText('Measured from the SHOW, not the sale. A hold measured from the sale would mature on a production cancelled weeks later, and the theatre would have paid commission on tickets it then refunded.'),
-                    ]),
-
-                Section::make('Limits')
-                    ->schema([
-                        TextInput::make('per_order_cap')
-                            ->label('Most any single order may earn (KES)')
-                            ->numeric()->minValue(0)->default(0)
-                            ->helperText('0 means no cap. Without one, a single group booking at KES 12,000 becomes an unexpectedly large payment to a stranger.'),
-                        Toggle::make('allow_with_promo')
-                            ->label('Pay commission on discounted orders too')
-                            ->helperText('Off by default. A promo code and a commission on the same sale can take the margin below zero; off, the attribution is dropped rather than paid quietly.'),
-                        /*
-                         * NOT OFFERED, deliberately.
-                         *
-                         * There was a toggle here. It could never have done
-                         * anything: Checkout::startDonation() takes no
-                         * referrer and never stamps one, and nothing else
-                         * creates a donation order — so the branch it
-                         * controls in accrue() is unreachable. A switch that
-                         * tells an operator donations are now earning, while
-                         * they are not, is worse than no switch.
-                         *
-                         * If the theatre ever wants it, it is a change to the
-                         * donation path first and a toggle second.
-                         */
-                        Text::make('Donations never earn commission. A gift to the theatre is a different proposition from a ticket sale, and the donation checkout does not carry a referral at all.'),
-                    ]),
-            ])
-            ->statePath('data');
-    }
-
-    /** A plain sentence about what is actually in force. */
-    private static function statusLine(): string
-    {
-        if (! ReferralSettings::enabled()) {
-            return '○ The programme is off. /sell-tickets is not reachable and no link earns.';
-        }
-
-        $rate = ReferralSettings::percent();
-
-        if ($rate <= 0) {
-            return '⚠ The programme is ON but the house rate is 0%. Sellers can sign up and nothing will ever be earned, unless each has their own rate set.';
-        }
-
-        return '✓ Live at '.rtrim(rtrim(number_format($rate, 2), '0'), '.').'%, held until '
-            .ReferralSettings::holdHours().' hours after each show.';
-    }
-
-    public function save(): void
-    {
-        $data = $this->form->getState();
-
-        $before = [
-            'enabled' => ReferralSettings::enabled(),
-            'percent' => ReferralSettings::percent(),
-            'hold_hours' => ReferralSettings::holdHours(),
-            'per_order_cap_cents' => ReferralSettings::perOrderCapCents(),
-            'allow_with_promo' => ReferralSettings::allowWithPromo(),
-        ];
-
-        Setting::put(ReferralSettings::KEY_ENABLED, $data['enabled'] ? '1' : '0');
-        Setting::put(ReferralSettings::KEY_PERCENT, (string) ((float) ($data['percent'] ?? 0)));
-        Setting::put(ReferralSettings::KEY_HOLD_HOURS, (string) (int) ($data['hold_hours'] ?? 48));
-        // Entered in shillings, stored in cents, like every other amount here.
-        Setting::put(ReferralSettings::KEY_PER_ORDER_CAP, (string) (int) round(((float) ($data['per_order_cap'] ?? 0)) * 100));
-        Setting::put(ReferralSettings::KEY_ALLOW_WITH_PROMO, $data['allow_with_promo'] ? '1' : '0');
-
-        AuditLog::create([
-            'user_id' => auth()->id(),
-            'organiser_id' => auth()->user()?->organiser_id,
-            'action' => 'settings.referral_programme_changed',
-            'subject_type' => Setting::class,
-            'subject_id' => null,
-            'changes' => ['from' => $before, 'to' => [
-                'enabled' => (bool) $data['enabled'],
-                'percent' => (float) ($data['percent'] ?? 0),
-                'hold_hours' => (int) ($data['hold_hours'] ?? 48),
-                'per_order_cap_cents' => (int) round(((float) ($data['per_order_cap'] ?? 0)) * 100),
-                'allow_with_promo' => (bool) $data['allow_with_promo'],
-            ]],
-        ]);
-
-        Notification::make()
-            ->title('Referral programme updated')
-            ->body($data['enabled']
-                ? 'Live. Sellers sign up at '.url('/sell-tickets').' and need approving before they earn.'
-                : 'Switched off. No link earns and the signup page is closed.')
-            ->success()
-            ->send();
-    }
-
-    public function content(Schema $schema): Schema
-    {
-        return $schema->components([
-            Form::make([EmbeddedSchema::make('form')])
-                ->id('form')
-                ->livewireSubmitHandler('save')
-                ->footer([
-                    Actions::make([
-                        Action::make('save')
-                            ->label('Save changes')
-                            ->submit('save')
-                            ->keyBindings(['mod+s']),
-                    ])->key('form-actions'),
-                ]),
-        ]);
-    }
-}
diff --git a/app/Filament/Pages/Settings.php b/app/Filament/Pages/Settings.php
new file mode 100644

+<?php
+
+namespace Tests\Feature;
+
+use App\Filament\Pages\Settings;
+use App\Models\Setting;
+use App\Models\User;
+use App\Support\PaymentSettings;
+use App\Support\ReferralSettings;
+use App\Support\ServiceFeeSettings;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+use Tests\TestCase;
+
+/**
+ * One settings screen, and everything on it actually saving.
+ *
+ * Settings pages fail quietly: a field that is not wired reads back its
+ * default, looks fine, and changes nothing — which is exactly how a
+ * "pay commission on donations" toggle survived that could never work. So
+ * every value here is set to something distinctive and read back through the
+ * class the rest of the app asks.
+ */
+class SettingsPageTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function admin(string $role = 'super_admin'): User
+    {
+        return User::factory()->create(['role' => $role]);
+    }
+
+    /**
+     * A provider with credentials present.
+     *
+     * The gateway field refuses a provider whose credentials are missing —
+     * better to be told here than by the first buyer — and nothing is
+     * configured in the test environment, so a settings save needs one.
+     */
+    private function withWorkingGateway(): void
+    {
+        config([
+            'services.payhero.username' => 'u',
+            'services.payhero.password' => 'p',
+            'services.payhero.channel_id' => '13962',

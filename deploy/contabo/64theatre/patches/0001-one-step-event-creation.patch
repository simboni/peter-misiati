 namespace App\Filament\Resources\Events\Pages;
 
 use App\Filament\Resources\Events\EventResource;
+use App\Filament\Resources\Events\Schemas\EventForm;
+use App\Models\Venue;
+use Filament\Forms\Components\DateTimePicker;
+use Filament\Forms\Components\Repeater;
+use Filament\Forms\Components\Select;
+use Filament\Forms\Components\TextInput;
+use Filament\Forms\Components\Toggle;
 use Filament\Resources\Pages\CreateRecord;
+use Filament\Schemas\Components\Wizard\Step;
 
+/**
+ * Putting a show on sale is one flow, not three screens.
+ *
+ * The database keeps prices on the performance — so a 3 PM matinee can be
+ * priced differently from the 7 PM show — but nobody wants to create an
+ * event, then hunt for Performances, then hunt for Ticket Types. This wizard
+ * collects all three in one pass:
+ *
+ *   1. Event details
+ *   2. Dates & venue     — one row per performance
+ *   3. Tickets & prices  — the price list, created for EVERY performance above
+ *
+ * Entering the price list once is the point: a matinee and an evening show
+ * almost always share prices. A single performance can still be re-priced
+ * afterwards from the Ticket Types screen.
+ */
 class CreateEvent extends CreateRecord
 {
+    use CreateRecord\Concerns\HasWizard;
+
     protected static string $resource = EventResource::class;
+
+    /** Lifted out of the form data before the Event row is written. */
+    protected array $performanceRows = [];
+
+    protected array $ticketTypeRows = [];
+
+    public function getSteps(): array
+    {
+        return [
+            Step::make('Event details')
+                ->description('What the show is')
+                ->schema(EventForm::components()),
+
+            Step::make('Dates & venue')
+                ->description('When and where it plays')
+                ->schema([
+                    Repeater::make('performances')
+                        ->label('Performances')
+                        ->helperText('One row per showing. "Sat 3 PM" and "Sat 7 PM" are two performances of the same event.')
+                        ->addActionLabel('Add another performance')
+                        ->defaultItems(1)
+                        ->minItems(1)
+                        ->schema([
+                            Select::make('venue_id')
+                                ->label('Venue')
+                                ->options(fn (): array => Venue::query()
+                                    ->orderBy('name')
+                                    ->pluck('name', 'id')
+                                    ->all())
+                                ->searchable()
+                                ->required(),
+                            DateTimePicker::make('starts_at')
+                                ->label('Starts at')
+                                ->seconds(false)
+                                ->required(),
+                            DateTimePicker::make('doors_open_at')
+                                ->label('Doors open')
+                                ->seconds(false)
+                                ->helperText('Optional.'),
+                        ])
+                        ->columns(3)
+                        ->columnSpanFull(),
+                ]),
+
+            Step::make('Tickets & prices')
+                ->description('What people pay')
+                ->schema([
+                    Repeater::make('ticket_types')
+                        ->label('Ticket categories')
+                        ->helperText('Created for every performance above. Adjust an individual performance later from Ticket Types.')
+                        ->addActionLabel('Add another category')
+                        ->defaultItems(1)
+                        ->minItems(1)
+                        ->schema([
+                            TextInput::make('name')
+                                ->label('Category')
+                                ->placeholder('Regular, VIP, Student…')
+                                ->datalist(['Regular', 'VIP', 'Student', 'Early Bird', 'Group', 'Comp'])
+                                ->required()
+                                ->maxLength(60),
+                            TextInput::make('price_kes')
+                                ->label('Price (KES)')
+                                ->numeric()
+                                ->minValue(0)
+                                ->required()
+                                ->helperText('In shillings — 1500 means KES 1,500. Use 0 for free or complimentary.'),
+                            TextInput::make('quantity_total')
+                                ->label('How many exist')
+                                ->numeric()
+                                ->minValue(1)
+                                ->required()
+                                ->helperText('One pool shared by online and gate sales, so overselling is impossible.'),
+                            TextInput::make('max_per_order')
+                                ->label('Max per order')
+                                ->numeric()
+                                ->minValue(1)
+                                ->helperText('Optional.'),
+                            Toggle::make('requires_id_at_gate')
+                                ->label('Requires ID at the gate')
+                                ->helperText('For student or concession prices.'),
+                        ])
+                        ->columns(2)
+                        ->columnSpanFull(),
+                ]),
+        ];
+    }
+
+    protected function mutateFormDataBeforeCreate(array $data): array
+    {
+        $this->performanceRows = $data['performances'] ?? [];
+        $this->ticketTypeRows = $data['ticket_types'] ?? [];
+
+        // Neither is a column on events — they become child rows in afterCreate().
+        unset($data['performances'], $data['ticket_types']);
+
+        return $data;
+    }
+
+    protected function afterCreate(): void
+    {
+        foreach ($this->performanceRows as $performanceRow) {
+            $performance = $this->record->performances()->create([
+                'venue_id' => $performanceRow['venue_id'],
+                'starts_at' => $performanceRow['starts_at'],
+                'doors_open_at' => $performanceRow['doors_open_at'] ?? null,
+                'status' => 'scheduled',
+            ]);
+
+            foreach ($this->ticketTypeRows as $ticketTypeRow) {
+                $performance->ticketTypes()->create([
+                    'name' => $ticketTypeRow['name'],
+                    // Stored as integer cents; the form collects shillings.
+                    'price_cents' => (int) round(((float) $ticketTypeRow['price_kes']) * 100),
+                    'quantity_total' => (int) $ticketTypeRow['quantity_total'],
+                    'quantity_sold' => 0,
+                    'max_per_order' => filled($ticketTypeRow['max_per_order'] ?? null)
+                        ? (int) $ticketTypeRow['max_per_order']
+                        : null,
+                    'requires_id_at_gate' => (bool) ($ticketTypeRow['requires_id_at_gate'] ?? false),
+                ]);
+            }
+        }
+    }
 }

@@ -0,0 +1,103 @@
+<?php
+
+namespace App\Filament\Resources\Performances\RelationManagers;
+
+use Filament\Actions\CreateAction;
+use Filament\Actions\DeleteAction;
+use Filament\Actions\EditAction;
+use Filament\Forms\Components\DateTimePicker;
+use Filament\Forms\Components\TextInput;
+use Filament\Forms\Components\Toggle;
+use Filament\Resources\RelationManagers\RelationManager;
+use Filament\Schemas\Schema;
+use Filament\Tables\Columns\IconColumn;
+use Filament\Tables\Columns\TextColumn;
+use Filament\Tables\Table;
+
+/**
+ * Prices belong to a performance, so they are edited from inside one.
+ *
+ * Money is stored as integer cents but entered and shown in shillings —
+ * typing 1500 here means KES 1,500, not fifteen shillings.
+ */
+class TicketTypesRelationManager extends RelationManager
+{
+    protected static string $relationship = 'ticketTypes';
+
+    protected static ?string $title = 'Tickets & prices';
+
+    public function form(Schema $schema): Schema
+    {
+        return $schema->components([
+            TextInput::make('name')
+                ->label('Category')
+                ->placeholder('Regular, VIP, Student…')
+                ->datalist(['Regular', 'VIP', 'Student', 'Early Bird', 'Group', 'Comp'])
+                ->required()
+                ->maxLength(60),
+            TextInput::make('price_cents')
+                ->label('Price (KES)')
+                ->numeric()
+                ->minValue(0)
+                ->required()
+                ->helperText('In shillings. Use 0 for free or complimentary.')
+                ->formatStateUsing(fn (?int $state): ?float => $state === null ? null : $state / 100)
+                ->dehydrateStateUsing(fn ($state): int => (int) round(((float) $state) * 100)),
+            TextInput::make('quantity_total')
+                ->label('How many exist')
+                ->numeric()
+                ->minValue(1)
+                ->required()
+                ->helperText('One pool shared by online and gate sales.'),
+            TextInput::make('max_per_order')
+                ->label('Max per order')
+                ->numeric()
+                ->minValue(1),
+            DateTimePicker::make('sales_start_at')
+                ->label('Sales open')
+                ->seconds(false),
+            DateTimePicker::make('sales_end_at')
+                ->label('Sales close')
+                ->seconds(false),
+            Toggle::make('requires_id_at_gate')
+                ->label('Requires ID at the gate'),
+        ]);
+    }
+
+    public function table(Table $table): Table
+    {
+        return $table
+            ->recordTitleAttribute('name')
+            ->columns([
+                TextColumn::make('name')
+                    ->label('Category'),
+                TextColumn::make('price_cents')
+                    ->label('Price')
+                    ->money('KES', divideBy: 100)
+                    ->sortable(),
+                TextColumn::make('quantity_total')
+                    ->label('Total')
+                    ->numeric(),
+                TextColumn::make('quantity_sold')
+                    ->label('Sold')
+                    ->numeric(),
+                // The number that actually gets asked about at the box office.
+                TextColumn::make('remaining')
+                    ->label('Remaining')
+                    ->state(fn ($record): int => $record->remaining())
+                    ->badge()
+                    ->color(fn (int $state): string => $state > 0 ? 'success' : 'danger'),
+                IconColumn::make('requires_id_at_gate')
+                    ->label('ID required')
+                    ->boolean(),
+            ])
+            ->headerActions([
+                CreateAction::make()
+                    ->label('Add category'),
+            ])
+            ->recordActions([
+                EditAction::make(),
+                DeleteAction::make(),
+            ]);
+    }
+}

 namespace App\Filament\Resources\Orders\Pages;
 
 use App\Filament\Resources\Orders\OrderResource;
+use App\Services\Refunds;
+use App\Support\Role;
+use Filament\Actions\Action;
 use Filament\Actions\EditAction;
+use Filament\Forms\Components\Textarea;
+use Filament\Notifications\Notification;
 use Filament\Resources\Pages\ViewRecord;
+use Filament\Support\Icons\Heroicon;
 
 class ViewOrder extends ViewRecord
 {
@@ -14,6 +20,76 @@ protected function getHeaderActions(): array
     {
         return [
             EditAction::make(),
+
+            /*
+             * Refunding is a real operation, not a status change. It kills the
+             * tickets, returns the seats to sale, posts the reversal to the
+             * ledger and records who decided — all of it, or none of it.
+             *
+             * Finance and administrators only: this hands money back.
+             */
+            Action::make('refund')
+                ->label('Refund')
+                ->icon(Heroicon::OutlinedArrowUturnLeft)
+                ->color('danger')
+                ->visible(fn (): bool => $this->getRecord()->status === 'paid'
+                    && in_array(auth()->user()?->role, [Role::SUPER_ADMIN, Role::FINANCE], true))
+                ->schema([
+                    Textarea::make('reason')
+                        ->label('Why?')
+                        ->required()
+                        ->maxLength(200)
+                        // A refund with no stated reason is unanswerable three
+                        // months later when somebody asks about the figure.
+                        ->helperText('Recorded against the order. "Show cancelled", "duplicate payment", "customer could not attend".'),
+                ])
+                ->requiresConfirmation()
+                ->modalHeading('Refund this order')
+                ->modalDescription('The tickets stop working, the seats go back on sale, and the reversal is posted to the ledger. The money itself you send by M-Pesa — this records it.')
+                ->action(function (array $data, Refunds $refunds): void {
+                    try {
+                        $order = $refunds->refund($this->getRecord(), $data['reason'], auth()->id());
+                    } catch (\Throwable $e) {
+                        Notification::make()->title('Not refunded')->body($e->getMessage())->danger()->send();
+
+                        return;
+                    }
+
+                    Notification::make()
+                        ->title('Refunded')
+                        ->body('KES '.number_format($order->total_cents / 100)
+                            .' reversed. Send the money by M-Pesa if you have not already.')
+                        ->success()
+                        ->send();
+                }),
+
+            /*
+             * Cancelling is the unpaid equivalent: a held booking the buyer
+             * walked away from. No money moved, so nothing is posted — the
+             * seats simply go back.
+             */
+            Action::make('cancelOrder')
+                ->label('Cancel')
+                ->icon(Heroicon::OutlinedXCircle)
+                ->color('gray')
+                ->visible(fn (): bool => in_array($this->getRecord()->status, ['pending', 'awaiting_payment'], true)
+                    && Role::canHandleMoney(auth()->user()?->role))
+                ->schema([
+                    Textarea::make('reason')->label('Why?')->required()->maxLength(200),
+                ])
+                ->requiresConfirmation()
+                ->modalDescription('Releases the seats back on sale. Nothing is posted to the ledger because no money was taken.')
+                ->action(function (array $data, Refunds $refunds): void {
+                    try {
+                        $refunds->cancel($this->getRecord(), $data['reason'], auth()->id());
+                    } catch (\Throwable $e) {
+                        Notification::make()->title('Not cancelled')->body($e->getMessage())->danger()->send();
+
+                        return;
+                    }
+
+                    Notification::make()->title('Cancelled')->body('The seats are back on sale.')->success()->send();
+                }),
         ];
     }
 }

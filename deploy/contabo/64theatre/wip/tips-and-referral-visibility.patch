+++ b/app/Models/CastMember.php
@@ -0,0 +1,82 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\HasMany;
+
+/**
+ * Somebody the audience watched, and may want to send money to.
+ *
+ * Not a User and not a Referrer: a cast member has no login and no code. They
+ * are a name on a list that the theatre keeps, and a payout number the theatre
+ * uses by hand.
+ */
+class CastMember extends Model
+{
+    protected $guarded = [];
+
+    protected function casts(): array
+    {
+        return [
+            'is_minor' => 'boolean',
+            'consent_at' => 'datetime',
+        ];
+    }
+
+    public function event(): BelongsTo
+    {
+        return $this->belongsTo(Event::class);
+    }
+
+    /** Tips are orders, so this is the money left for this person. */
+    public function tips(): HasMany
+    {
+        return $this->hasMany(Order::class);
+    }
+
+    /**
+     * THE SAFEGUARDING CHECK, in one place so no screen can forget it.
+     *
+     * Three conditions, and all of them have to hold before a name goes on a
+     * public page beside a button that sends money:
+     *
+     *   · active — the theatre has not hidden them
+     *   · consented — they agreed to be listed. A cast list typed in by a
+     *     stage manager is not consent.
+     *   · not a minor — never, whatever the consent record says. A child's
+     *     name next to "send money" is not something an adult's tick-box can
+     *     authorise. Tips meant for them go to the theatre to pass on.
+     */
+    public function isTippable(): bool
+    {
+        return $this->status === 'active'
+            && $this->consent_at !== null
+            && ! $this->is_minor;
+    }
+
+    /** Why this person is not on the public list, in words. */
+    public function whyNotTippable(): ?string
+    {
+        return match (true) {
+            $this->is_minor => 'Under 18 — never listed publicly. Tips meant for them come to the theatre to pass on.',
+            $this->consent_at === null => 'Has not agreed to be listed yet.',
+            $this->status !== 'active' => 'Hidden by the theatre.',
+            default => null,
+        };
+    }
+
+    /** What the audience should see: the character, then the person. */
+    public function displayName(): string
+    {
+        return $this->role_name
+            ? $this->role_name.' — '.$this->name
+            : $this->name;
+    }
+
+    public function tipsTotalCents(): int
+    {
+        return (int) $this->tips()->where('type', 'tip')->where('status', 'paid')->sum('total_cents');
+    }
+}

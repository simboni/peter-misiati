@@ -0,0 +1,28 @@
+<?php
+
+namespace App\Services;
+
+use BaconQrCode\Renderer\Image\SvgImageBackEnd;
+use BaconQrCode\Renderer\ImageRenderer;
+use BaconQrCode\Renderer\RendererStyle\RendererStyle;
+use BaconQrCode\Writer;
+
+/**
+ * A QR code for a plain URL.
+ *
+ * TicketQr exists already but it signs a ticket payload and takes a Ticket —
+ * it is about proving a ticket is real at a door. A tipping poster just needs
+ * somebody's phone to open a link, with nothing to verify, so reusing it would
+ * mean bending a security primitive into a convenience one.
+ */
+class LinkQr
+{
+    public function svg(string $url, int $size = 260): string
+    {
+        $writer = new Writer(new ImageRenderer(new RendererStyle($size), new SvgImageBackEnd));
+
+        // The XML declaration has to go: this is inlined into a page that
+        // already has one, and a second breaks the render.
+        return preg_replace('/^<\?xml[^>]*\?>\s*/', '', $writer->writeString($url));
+    }
+}

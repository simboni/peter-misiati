+++ b/app/Support/TipSettings.php
@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Setting;
+
+/**
+ * The rules for on-stage tipping.
+ *
+ * Off by default, like referrals and for the same reason: a feature that
+ * invites the public to send money to named individuals should start because
+ * somebody decided it should, not because a patch was applied.
+ */
+class TipSettings
+{
+    public const KEY_ENABLED = 'tips.enabled';
+
+    public const KEY_MIN_CENTS = 'tips.min_cents';
+
+    public const KEY_MAX_CENTS = 'tips.max_cents';
+
+    public const KEY_ALLOW_FREE_TEXT = 'tips.allow_free_text';
+
+    public static function enabled(): bool
+    {
+        return (string) (Setting::get(self::KEY_ENABLED) ?? '0') === '1';
+    }
+
+    /** Below this it costs more in gateway fees than it is worth. */
+    public static function minCents(): int
+    {
+        return max(5000, (int) (Setting::get(self::KEY_MIN_CENTS) ?? 5000));
+    }
+
+    /**
+     * A ceiling, because this page takes money from somebody who has just
+     * watched a show and is feeling generous. A mistyped amount should be
+     * refused rather than refunded.
+     */
+    public static function maxCents(): int
+    {
+        return (int) (Setting::get(self::KEY_MAX_CENTS) ?? 2000000); // KES 20,000
+    }
+
+    /**
+     * Whether somebody can type a name nobody has entered.
+     *
+     * ON by default, and this is the setting that makes the feature work on a
+     * first night. The cast list is often not in the system when the curtain
+     * comes down, and a tipping page that can only offer an empty list is a
+     * tipping page that collects nothing. What gets typed is kept as written —
+     * it is how the theatre learns who the audience actually noticed.
+     */
+    public static function allowFreeText(): bool
+    {
+        return (string) (Setting::get(self::KEY_ALLOW_FREE_TEXT) ?? '1') === '1';
+    }
+}

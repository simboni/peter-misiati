+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+use Illuminate\Support\Str;
+
+/**
+ * On-stage tipping — the audience sending money to a named performer.
+ *
+ * A tip is an ORDER with type='tip', like a donation is. Same gateway, same
+ * confirm path, same ledger. What makes it different is where the money is
+ * owed: a ticket is income, a tip is money the theatre is holding for somebody
+ * else, so it posts to `tips_payable` rather than `sales`. Counting tips as
+ * takings would overstate the theatre's income by the exact amount it has to
+ * hand over.
+ *
+ * SAFEGUARDING IS A SCHEMA CONCERN HERE, NOT A POLICY DOCUMENT.
+ *
+ * Putting a performer's name on a public payment page is a thing you need
+ * their agreement for, and some of this cast are children. So:
+ *
+ *   · `consent_at` — nobody is listed publicly until it is set. A cast list
+ *     typed in by a stage manager is not consent.
+ *   · `is_minor` — never listed publicly at all, whatever the consent says. A
+ *     child's name beside a "send money" button is not something an adult's
+ *     tick-box can authorise, and routing it through the theatre instead is
+ *     the one arrangement that does not need a lawyer to explain.
+ *
+ * Both are checked in one place, CastMember::isTippable(), so a new screen
+ * cannot forget them.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        // A public link per night needs a public id for the night. Performances
+        // were only ever reached through their event, so they never had one.
+        Schema::table('performances', function (Blueprint $table) {
+            $table->uuid('uuid')->nullable()->after('id');
+        });
+
+        DB::table('performances')->whereNull('uuid')->orderBy('id')
+            ->each(fn ($row) => DB::table('performances')
+                ->where('id', $row->id)
+                ->update(['uuid' => (string) Str::uuid()]));
+
+        Schema::table('performances', function (Blueprint $table) {
+            $table->unique('uuid');
+        });
+
+        Schema::create('cast_members', function (Blueprint $table) {
+            $table->id();
+            $table->uuid('uuid')->unique();
+            // The cast belongs to the PRODUCTION, not to one night. Re-typing
+            // it per performance is how the Thursday list ends up different
+            // from the Friday one.
+            $table->foreignId('event_id')->constrained()->cascadeOnDelete();
+            $table->string('name');
+            // "Mama Grace" — who the audience watched. They rarely know the
+            // performer's own name, and the tipping page is read by somebody
+            // who has just left the auditorium.
+            $table->string('role_name')->nullable();
+            $table->string('payout_phone')->nullable();
+            $table->string('mpesa_name')->nullable();
+            // See the safeguarding note above. Both are load-bearing.
+            $table->boolean('is_minor')->default(false);
+            $table->timestamp('consent_at')->nullable();
+            $table->string('status')->default('pending'); // pending|active|hidden
+            $table->unsignedSmallInteger('sort_order')->default(0);
+            $table->timestamps();
+            $table->index(['event_id', 'status']);
+        });
+
+        Schema::table('orders', function (Blueprint $table) {
+            // Null on a tip left for the company as a whole, or when the
+            // audience member typed a name nobody had entered — which is the
+            // common case on a first night and must not be refused.
+            $table->foreignId('cast_member_id')->nullable()->after('performance_id')->constrained();
+            // What they typed when there was no cast list, or nobody matched.
+            // Kept as written: it is how the theatre finds out who the
+            // audience actually noticed.
+            $table->string('tip_for_name')->nullable()->after('cast_member_id');
+            $table->index(['cast_member_id']);
+        });

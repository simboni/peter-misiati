diff --git a/app/Http/Controllers/TipController.php b/app/Http/Controllers/TipController.php
new file mode 100644
index 0000000..3c67fb2
--- /dev/null
+++ b/app/Http/Controllers/TipController.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\CastMember;
+use App\Models\Performance;
+use App\Payments\PaymentGateway;
+use App\Services\Tips;
+use App\Support\PaymentSettings;
+use App\Support\TipSettings;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+use Illuminate\View\View;
+
+/**
+ * Tipping a performer, from a QR code in the programme or on the wall.
+ *
+ * Reached by the performance's uuid — a capability URL, like the order page
+ * and the group roster. No login: this is read by somebody standing in a
+ * foyer with their coat on, and anything more than "tap, choose, pay" gets
+ * abandoned.
+ *
+ * 404 while tipping is switched off, for the same reason the seller signup
+ * does: a page that still took money for a programme nobody has agreed to run
+ * would be collecting it with nowhere defined for it to go.
+ */
+class TipController extends Controller
+{
+    /** Suggested amounts (KES), shown as one-tap chips. */
+    public const PRESETS = [100, 200, 500, 1000];
+
+    public function show(string $uuid, Tips $tips): View
+    {
+        abort_unless(TipSettings::enabled(), 404);
+
+        $performance = $this->find($uuid);
+
+        return view('tips.create', [
+            'performance' => $performance,
+            'cast' => $tips->tippableFor($performance),
+            'presets' => self::PRESETS,
+            'allowFreeText' => TipSettings::allowFreeText(),
+            'minKes' => (int) (TipSettings::minCents() / 100),
+            'maxKes' => (int) (TipSettings::maxCents() / 100),
+        ]);
+    }
+
+    public function store(Request $request, string $uuid, Tips $tips, PaymentGateway $gateway): RedirectResponse
+    {
+        abort_unless(TipSettings::enabled(), 404);
+
+        $performance = $this->find($uuid);
+
+        $validated = $request->validate([
+            'amount' => ['required', 'integer',
+                'min:'.(int) (TipSettings::minCents() / 100),
+                'max:'.(int) (TipSettings::maxCents() / 100)],
+            'phone' => ['required', 'regex:/^(?:\+?254|0)?(7|1)\d{8}$/'],
+            'cast_member_id' => ['nullable', 'integer'],
+            'for_name' => ['nullable', 'string', 'max:80'],
+            'message' => ['nullable', 'string', 'max:300'],
+            'name' => ['nullable', 'string', 'max:120'],
+        ], [], ['amount' => 'tip amount']);
+
+        if (! PaymentSettings::onlineEnabled()) {
+            return back()->withErrors([
+                'amount' => 'Payments are temporarily unavailable. Please try again shortly.',
+            ])->withInput();
+        }
+
+        // Looked up rather than trusted: Tips::start re-checks that this
+        // person may be tipped at all, which is where the under-18 rule bites.
+        $castMember = $validated['cast_member_id']
+            ? CastMember::find($validated['cast_member_id'])
+            : null;
+
+        $order = $tips->start(
+            performance: $performance,
+            amountCents: (int) $validated['amount'] * 100,
+            phone: $validated['phone'],
+            castMember: $castMember,
+            forName: $validated['for_name'] ?? null,
+            message: $validated['message'] ?? null,
+            name: $validated['name'] ?? null,
+        );
+
+        try {
+            $payment = $gateway->initiate($order, $validated['phone']);
+        } catch (\Throwable $e) {
+            Log::error('tip.initiate_failed', ['order' => $order->uuid, 'error' => $e->getMessage()]);
+
+            return redirect()->route('orders.show', $order->uuid)
+                ->with('payment_error', 'We could not start your payment. Please try again shortly.');
+        }
+
+        if ($url = $gateway->authorizationUrl($payment)) {
+            return redirect()->away($url);
+        }
+
+        return redirect()->route('orders.show', $order->uuid);
+    }
+
+    private function find(string $uuid): Performance
+    {
+        return Performance::where('uuid', $uuid)
+            ->with(['event', 'venue'])
+            ->firstOrFail();
+    }
+}
diff --git a/app/Models/CastMember.php b/app/Models/CastMember.php

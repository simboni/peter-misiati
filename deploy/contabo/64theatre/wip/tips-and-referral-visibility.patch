+++ b/app/Filament/Resources/Events/RelationManagers/CastRelationManager.php
@@ -0,0 +1,195 @@
+<?php
+
+namespace App\Filament\Resources\Events\RelationManagers;
+
+use App\Models\CastMember;
+use App\Support\Phone;
+use App\Support\TipSettings;
+use Filament\Actions\Action;
+use Filament\Actions\CreateAction;
+use Filament\Actions\DeleteAction;
+use Filament\Actions\EditAction;
+use Filament\Forms\Components\TextInput;
+use Filament\Forms\Components\Toggle;
+use Filament\Notifications\Notification;
+use Filament\Resources\RelationManagers\RelationManager;
+use Filament\Schemas\Components\Utilities\Get;
+use Filament\Schemas\Schema;
+use Filament\Tables\Columns\TextColumn;
+use Filament\Tables\Table;
+
+/**
+ * Who was on stage, and who the audience may send money to.
+ *
+ * Optional. A production with no cast entered still sells tickets and still
+ * takes tips — they go to the company and the theatre shares them out. This
+ * is the step that lets the audience name somebody instead.
+ *
+ * The cast belongs to the PRODUCTION, not to one night: re-typing it per
+ * performance is how the Thursday list ends up different from the Friday one.
+ */
+class CastRelationManager extends RelationManager
+{
+    protected static string $relationship = 'castMembers';
+
+    protected static ?string $title = 'Cast & tipping';
+
+    public function form(Schema $schema): Schema
+    {
+        return $schema->components([
+            TextInput::make('name')
+                ->label('Name')
+                ->required()
+                ->maxLength(120),
+            TextInput::make('role_name')
+                ->label('Character played')
+                ->maxLength(120)
+                ->helperText('What the audience will look for. They rarely know the performer\'s own name — they know "Mama Grace".'),
+
+            /*
+             * THE TWO SAFEGUARDING FIELDS.
+             *
+             * Both are checked in CastMember::isTippable(), which is the only
+             * thing the public list is built from, so no screen can forget
+             * one. They are explained here rather than in a policy document
+             * because the person typing the cast in is the person who knows
+             * the answers.
+             */
+            Toggle::make('is_minor')
+                ->label('Under 18')
+                ->live()
+                ->helperText('NEVER listed publicly, whatever else is set. A child\'s name beside a "send money" button is not something an adult\'s tick-box can authorise. Tips meant for them come to the theatre to pass on.'),
+
+            Toggle::make('has_consented')
+                ->label('Has agreed to be listed for tipping')
+                ->dehydrated(false)
+                ->visible(fn (Get $get): bool => ! $get('is_minor'))
+                ->helperText('A cast list typed in by a stage manager is not consent. Ask them.')
+                ->afterStateHydrated(fn (Toggle $component, ?CastMember $record) => $component->state(
+                    $record?->consent_at !== null,
+                )),
+
+            TextInput::make('payout_phone')
+                ->label('M-Pesa number for paying them')
+                ->maxLength(20)
+                ->visible(fn (Get $get): bool => ! $get('is_minor'))
+                ->helperText('Used by hand when the theatre pays tips out. Nothing here sends money.'),
+            TextInput::make('mpesa_name')
+                ->label('Name on that M-Pesa number')
+                ->maxLength(120)
+                ->visible(fn (Get $get): bool => ! $get('is_minor'))
+                ->helperText('Check it against the M-Pesa confirmation before sending.'),
+
+            TextInput::make('sort_order')
+                ->label('Order in the list')
+                ->numeric()
+                ->default(0)
+                ->helperText('Low numbers first. Leave at 0 to sort by name.'),
+        ])->columns(2);
+    }
+
+    public function table(Table $table): Table
+    {
+        return $table
+            ->recordTitleAttribute('name')
+            ->defaultSort('sort_order')
+            ->columns([
+                TextColumn::make('name')
+                    ->searchable()
+                    ->description(fn (CastMember $r): ?string => $r->role_name),
+                TextColumn::make('status')
+                    ->label('Listed publicly')
+                    ->badge()
+                    ->state(fn (CastMember $r): string => $r->isTippable() ? 'yes' : 'no')
+                    ->color(fn (string $state): string => $state === 'yes' ? 'success' : 'gray')
+                    // The reason, right beside the answer. "No" with no
+                    // explanation is the kind of thing somebody fixes by
+                    // guessing.
+                    ->description(fn (CastMember $r): ?string => $r->whyNotTippable()),
+                TextColumn::make('payout_phone')
+                    ->label('Pay to')
+                    ->placeholder('not set')
+                    ->formatStateUsing(fn (string $state): string => Phone::forHumans($state)),
+                TextColumn::make('tips_total')
+                    ->label('Tips received')
+                    ->alignEnd()
+                    ->state(fn (CastMember $r): string => 'KES '.number_format($r->tipsTotalCents() / 100)),
+            ])
+            ->headerActions([
+                CreateAction::make()
+                    ->label('Add cast member')
+                    ->mutateDataUsing(fn (array $data): array => self::normalise($data)),
+            ])
+            ->recordActions([
+                /*
+                 * One click, confirmed, because it is the switch that puts
+                 * somebody's name on a public payment page.
+                 */
+                Action::make('list')
+                    ->label('List publicly')
+                    ->icon('heroicon-o-check-circle')
+                    ->color('success')
+                    ->visible(fn (CastMember $r): bool => ! $r->is_minor && ! $r->isTippable())
+                    ->requiresConfirmation()
+                    ->modalHeading('List this person for tipping')
+                    ->modalDescription('Their name goes on the public tipping page for this production. Only do this if they have agreed to it.')
+                    ->action(function (CastMember $r): void {
+                        $r->update(['status' => 'active', 'consent_at' => $r->consent_at ?? now()]);
+                        Notification::make()->title($r->name.' is now listed')->success()->send();
+                    }),
+
+                Action::make('unlist')
+                    ->label('Hide')
+                    ->icon('heroicon-o-eye-slash')
+                    ->color('gray')
+                    ->visible(fn (CastMember $r): bool => $r->isTippable())
+                    ->requiresConfirmation()
+                    ->modalDescription('Takes them off the public tipping page. Tips already received are unaffected.')
+                    ->action(function (CastMember $r): void {
+                        $r->update(['status' => 'hidden']);
+                        Notification::make()->title($r->name.' is hidden')->success()->send();
+                    }),
+
+                EditAction::make()->mutateDataUsing(fn (array $data): array => self::normalise($data)),
+                DeleteAction::make()
+                    // A cast member with tips against them is referenced by
+                    // orders. Hiding is what "remove from the list" means.
+                    ->visible(fn (CastMember $r): bool => $r->tips()->doesntExist()),
+            ])
+            ->emptyStateHeading(TipSettings::enabled()
+                ? 'No cast entered'
+                : 'Tipping is switched off')
+            ->emptyStateDescription(TipSettings::enabled()
+                ? 'Optional. Without a cast list the tipping page still works — tips go to the company and the theatre shares them out.'
+                : 'Turn it on under Settings → All settings → Tipping, and this list becomes the public one.');
+    }
+
+    /**
+     * Consent is a timestamp, not a checkbox, because "when did they agree"
+     * is the question that gets asked and a boolean cannot answer it.
+     */
+    private static function normalise(array $data): array
+    {
+        $consented = (bool) ($data['has_consented'] ?? false);
+        unset($data['has_consented']);
+
+        $data['consent_at'] = $consented ? ($data['consent_at'] ?? now()) : null;
+        $data['status'] = $consented ? 'active' : 'pending';
+
+        if (filled($data['payout_phone'] ?? null)) {
+            $data['payout_phone'] = Phone::normalise($data['payout_phone']) ?? trim((string) $data['payout_phone']);
+        }
+
+        // A minor carries no payout number and is never listed. Blanking it
+        // here means the rule holds even if the fields were filled before the
+        // toggle was set.
+        if (! empty($data['is_minor'])) {
+            $data['payout_phone'] = null;
+            $data['mpesa_name'] = null;
+            $data['consent_at'] = null;
+            $data['status'] = 'pending';
+        }
+
+        return $data;
+    }
+}

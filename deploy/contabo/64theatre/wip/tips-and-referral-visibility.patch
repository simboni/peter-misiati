diff --git a/app/Services/Tips.php b/app/Services/Tips.php
new file mode 100644
index 0000000..53f5e99
--- /dev/null
+++ b/app/Services/Tips.php
@@ -0,0 +1,121 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\CastMember;
+use App\Models\Customer;
+use App\Models\Order;
+use App\Models\Organiser;
+use App\Models\Performance;
+use App\Support\Phone;
+use App\Support\TipSettings;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+/**
+ * Money left for a performer after the show.
+ *
+ * A tip is an order with type='tip' — same gateway, same confirm path, same
+ * ledger — so nothing here reimplements payments. What lives here is the part
+ * that is specific: who may be tipped, and what happens when the audience
+ * names somebody the theatre has not entered.
+ */
+class Tips
+{
+    /**
+     * The cast an audience member may actually choose from.
+     *
+     * Filtered through CastMember::isTippable(), which is the one place the
+     * consent and under-18 rules live. A screen that built its own list would
+     * eventually forget one of them.
+     *
+     * @return \Illuminate\Support\Collection<int, CastMember>
+     */
+    public function tippableFor(Performance $performance)
+    {
+        return CastMember::where('event_id', $performance->event_id)
+            ->orderBy('sort_order')
+            ->orderBy('name')
+            ->get()
+            ->filter(fn (CastMember $m): bool => $m->isTippable())
+            ->values();
+    }
+
+    /**
+     * Start a tip. Returns an unpaid order for the gateway to push against.
+     *
+     * @param  CastMember|null  $castMember  who it is for, if they are on the list
+     * @param  string|null  $forName  what was typed when they are not
+     */
+    public function start(
+        Performance $performance,
+        int $amountCents,
+        string $phone,
+        ?CastMember $castMember = null,
+        ?string $forName = null,
+        ?string $message = null,
+        ?string $name = null,
+    ): Order {
+        /*
+         * RE-CHECKED HERE, not trusted from the form.
+         *
+         * The public page only lists tippable people, but the id comes back in
+         * a POST, and a POST is whatever somebody sends. Without this, naming
+         * a child's record directly in the request would attach a public
+         * payment to them — which is the single thing the under-18 rule
+         * exists to prevent.
+         */
+        if ($castMember && ! $castMember->isTippable()) {
+            $forName = $forName ?: $castMember->role_name ?: $castMember->name;
+            $castMember = null;
+        }
+
+        // The cast member has to be in THIS production. Otherwise an id from
+        // another show would credit the wrong person's total.
+        if ($castMember && $castMember->event_id !== $performance->event_id) {
+            $castMember = null;
+        }
+
+        return DB::transaction(function () use (
+            $performance, $amountCents, $phone, $castMember, $forName, $message, $name
+        ) {
+            $customer = Customer::firstOrCreate(
+                ['phone' => Phone::normaliseOrKeep($phone)],
+                ['name' => $name],
+            );
+
+            return Order::create([
+                'uuid' => (string) Str::uuid(),
+                'type' => 'tip',
+                'organiser_id' => $performance->event?->organiser_id ?? Organiser::query()->value('id'),
+                'customer_id' => $customer->id,
+                // Which night, so the theatre can tell a Thursday tip from a
+                // Saturday one when the same actor played both.
+                'performance_id' => $performance->id,
+                'cast_member_id' => $castMember?->id,
+                // Kept as typed. It is how the theatre finds out who the
+                // audience actually noticed, including people not on any list.
+                'tip_for_name' => $castMember ? null : ($forName ?: null),
+                'subtotal_cents' => $amountCents,
+                'total_cents' => $amountCents,
+                'donor_message' => $message,
+                'channel' => 'online',
+                'status' => 'awaiting_payment',
+                'expires_at' => now()->addMinutes(Checkout::HOLD_MINUTES),
+            ]);
+        });
+    }
+
+    /** Bounds, so a mistyped amount is refused rather than refunded. */
+    public function withinLimits(int $amountCents): bool
+    {
+        return $amountCents >= TipSettings::minCents()
+            && $amountCents <= TipSettings::maxCents();
+    }
+
+    /** What the theatre still owes performers, in cents. */
+    public function owedCents(int $organiserId): int
+    {
+        return app(Ledger::class)->balance($organiserId, 'tips_payable') * -1;
+    }
+}

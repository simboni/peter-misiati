# 64theatre — Contabo deploy settings.
#
#   cp env.example .env && chmod 600 .env
#
# Generate APP_KEY before the first build (compose requires it even to build):
#   sed -i "s|^APP_KEY=.*|APP_KEY=base64:$(openssl rand -base64 32)|" .env

# Encrypts sessions and cookies. Keep it stable — changing it logs everyone out.
APP_KEY=

# The public URL, exactly as visitors reach it. Ticket QR codes and emailed
# links are generated from this, so it must match the Caddy hostname exactly —
# including https and no trailing slash.
#
# One subdomain per product: streaming and film are coming and will not be this
# application, so ticketing stays off the apex.
APP_URL=https://tickets.64theatre.art

# `staging` seeds a demo season on EVERY boot — deleted events reappear.
# `production` stops demo content; the admin user and organiser are still
# created, so you keep your login. Flip this when the real shows go in.
APP_ENV=staging

# Runs migrations (and the admin/organiser seed) on boot. Leave true.
SEED_ON_BOOT=true

# ---------------------------------------------------------------- payments ---
#
# `fake`     — checkout confirms instantly, no credentials (demos only).
# `kopokopo` — real M-Pesa through an aggregator. Sells today, before
#              Safaricom approves a paybill in 64 Theatre's own name.
# `pesapal`  — M-Pesa + cards, redirect flow.
# `daraja`   — direct Safaricom STK Push, once the shortcode exists.
PAYMENT_GATEWAY=fake

# Kopo Kopo. Production base is https://api.kopokopo.com — live keys against
# the sandbox URL fail authentication, and the error does not say why.
# KOPOKOPO_API_KEY signs incoming webhooks and is a DIFFERENT secret from the
# client secret; swapping them authenticates fine and then fails every
# callback.
#
# Webhook URL to register in the Kopo Kopo dashboard:
#   https://tickets.64theatre.art/webhooks/kopokopo
KOPOKOPO_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_API_KEY=
KOPOKOPO_TILL_NUMBER=

# Shown on the order page while payment is outstanding, for a buyer whose STK
# prompt never arrived. Published numbers, not secrets.
#
# NOT reconciled automatically: the account number identifies 64 Theatre to
# Kopo Kopo, not the order, so there is nowhere to put a reference and someone
# must match these by hand. Set false until you have a process for that.
OFFLINE_PAYMENT_ENABLED=true
OFFLINE_PAYMENT_PAYBILL=542542
OFFLINE_PAYMENT_ACCOUNT=064064
OFFLINE_PAYMENT_BANK=I&M Bank

# Only needed when PAYMENT_GATEWAY=daraja. Leave blank otherwise.
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=
# DARAJA_PASSKEY=

# ------------------------------------------------------------------- brand ---
#
# Printed on tickets and in emails. This is the PUBLIC SITE, not this app's own
# host — a ticket should send someone to 64theatre.art, not back to the box
# office. Leave blank until the public site exists; blank simply prints nothing.
BRAND_WEBSITE=
BRAND_INSTAGRAM=@64theatre

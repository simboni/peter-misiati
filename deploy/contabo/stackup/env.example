# StackUp secrets for the Contabo deploy.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate each password/secret with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# These are read ONCE when the database volume is first created. Changing a
# password here later does NOT change it in PostgreSQL — use ALTER ROLE.

# PostgreSQL superuser (container-internal only; never exposed to the network).
POSTGRES_SUPERUSER_PASSWORD=change-me

# Schema owner. Used only by the migration runner.
STACKUP_MIGRATOR_PASSWORD=change-me

# Runtime role. NOBYPASSRLS — this is the tenant-isolation boundary.
STACKUP_APP_PASSWORD=change-me

# Signs access/refresh tokens. If this changes, everyone is logged out.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Optional token lifetimes (seconds).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Optional — real AI Brain. Omit entirely to use the offline heuristic.
ANTHROPIC_API_KEY=
STACKUP_AI_MODEL=

# Outbound email — password resets, invites and notifications. Without these
# StackUp only writes emails to its log. Sent through Resend:
#   1. resend.com → Domains → add smp.co.ke, put its DNS records in the
#      smp.co.ke panel, press Verify (until it is verified Resend refuses to
#      send as that domain).
#   2. resend.com → API Keys → create one with "Sending access".
EMAIL_PROVIDER=http
EMAIL_RELAY_AUTH=Bearer re_paste_your_key_here
# Must be on the domain verified in Resend.
EMAIL_FROM=StackUp <no-reply@smp.co.ke>

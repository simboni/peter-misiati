# StackUp secrets for the Contabo deploy.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate each password/secret with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# These are read ONCE when the database volume is first created. Changing a
# password here later does NOT change it in PostgreSQL — use ALTER ROLE.

# PostgreSQL superuser (container-internal only; never exposed to the network).
POSTGRES_SUPERUSER_PASSWORD=change-me

# Schema owner. Used only by the migration runner.
STACKUP_MIGRATOR_PASSWORD=change-me

# Runtime role. NOBYPASSRLS — this is the tenant-isolation boundary.
STACKUP_APP_PASSWORD=change-me

# Signs access/refresh tokens. If this changes, everyone is logged out.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Optional token lifetimes (seconds).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Optional — real AI Brain. Omit entirely to use the offline heuristic.
ANTHROPIC_API_KEY=
STACKUP_AI_MODEL=

# Outbound email — password resets, invites and notifications — through
# Brevo (the SMP EVENTURES account; free plan 300 a day, shared with Fit
# Generations). Without these StackUp only writes emails to its log.
#   1. brevo.com → Senders, Domains & Dedicated IPs → Domains → add smp.co.ke,
#      put its DNS records in the smp.co.ke panel, Authenticate.
#   2. brevo.com → SMTP & API → API Keys → Generate (starts xkeysib-).
EMAIL_PROVIDER=http
BREVO_API_KEY=xkeysib-paste_your_key_here
# Shared between StackUp and the mailer adapter; any long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MAILER_TOKEN=change-me
# Must be on the domain authenticated in Brevo.
EMAIL_FROM=StackUp <no-reply@smp.co.ke>

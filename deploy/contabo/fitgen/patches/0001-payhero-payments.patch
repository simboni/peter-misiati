diff --git a/src/app/api/payhero/callback/[[...seg]]/route.ts b/src/app/api/payhero/callback/[[...seg]]/route.ts
new file mode 100644
index 0000000..702e771
--- /dev/null
+++ b/src/app/api/payhero/callback/[[...seg]]/route.ts
@@ -0,0 +1,57 @@
+import { settleByCheckout } from "@/lib/services/billing";
+
+export const dynamic = "force-dynamic";
+
+/** PayHero posts the result of an STK prompt here.
+ *
+ *  Same shape of defence as the Daraja callback: the URL carries a secret
+ *  path segment (/api/payhero/callback/<PAYHERO_CALLBACK_TOKEN>) and a request
+ *  that does not present it is refused. PayHero's request signing is optional
+ *  and absent from its published reference, so without the token this endpoint
+ *  would settle an invoice for anyone who guessed a CheckoutRequestID.
+ *
+ *  The body nests the interesting part under `response`, and reports M-Pesa's
+ *  numeric ResultCode where 0 means paid. Confirmed against a live payment
+ *  rather than assumed — the field names below are what PayHero actually sent.
+ */
+export async function POST(req: Request, ctx: { params: Promise<{ seg?: string[] }> }) {
+  const expected = process.env.PAYHERO_CALLBACK_TOKEN;
+  if (expected) {
+    const { seg } = await ctx.params;
+    if ((seg?.[0] ?? "") !== expected) {
+      return new Response("Not found", { status: 404 });
+    }
+  }
+
+  let body: unknown;
+  try {
+    body = await req.json();
+  } catch {
+    return Response.json({ status: "ignored" });
+  }
+
+  const r =
+    (body as { response?: Record<string, unknown> })?.response ??
+    (body as Record<string, unknown>);
+
+  const checkoutId = String(r?.CheckoutRequestID ?? r?.reference ?? "");
+  const resultCode = r?.ResultCode;
+  const status = String(r?.Status ?? "").toLowerCase();
+
+  // ResultCode is the authority when present: 0 is paid, anything else is not.
+  // Status is the fallback for a body that omits it.
+  const paid =
+    resultCode !== undefined && resultCode !== null && resultCode !== ""
+      ? Number(resultCode) === 0
+      : status === "success";
+
+  if (checkoutId && paid) {
+    const amount = Number(r?.Amount) || undefined;
+    const receipt = String(r?.MpesaReceiptNumber ?? "");
+    await settleByCheckout(checkoutId, amount, receipt || undefined);
+  }
+
+  // Always 200 once the token is good, even for an invoice we cannot place:
+  // anything else makes PayHero retry a delivery that will never succeed.
+  return Response.json({ status: "ok" });
+}

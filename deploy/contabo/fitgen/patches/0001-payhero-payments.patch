diff --git a/src/lib/services/payhero.ts b/src/lib/services/payhero.ts
new file mode 100644
index 0000000..2782c5f
--- /dev/null
+++ b/src/lib/services/payhero.ts
@@ -0,0 +1,132 @@
+import "server-only";
+
+/* ==========================================================================
+   PayHero — STK push that settles into a bank account.
+
+   WHY THIS EXISTS ALONGSIDE DARAJA. Daraja needs a Safaricom shortcode and
+   passkey in Fit Generations' own name, and that approval takes weeks.
+   PayHero raises the prompt against a bank paybill it already holds and
+   settles direct to the gym's account, so members can pay now. Nothing else
+   in the app changes: this returns the same StkResult, with PayHero's own
+   CheckoutRequestID, so setInvoiceCheckout / settleByCheckout reconcile
+   exactly as they do for Daraja.
+
+     PAYHERO_USERNAME, PAYHERO_PASSWORD   API credentials (NOT the dashboard
+                                          login) — PayHero dashboard → API
+     PAYHERO_CHANNEL_ID                   the payment channel money lands in;
+                                          use the BANK channel, or takings sit
+                                          in a PayHero wallet
+     PAYHERO_CALLBACK_TOKEN               secret path segment on the callback
+                                          URL — the same defence the Daraja
+                                          callback already uses
+     APP_URL                              public https base
+     PAYHERO_DISPLAY_NAME                 what the prompt shows the member
+
+   WHAT WILL SURPRISE YOU. The prompt carries the name registered against the
+   COLLECTING paybill, which belongs to the bank — not "Fit Generations". A
+   member seeing an unfamiliar company cancels, so the portal names it in
+   advance. See promptName().
+   ========================================================================== */
+
+import type { StkResult } from "./mpesa";
+
+export function payheroConfigured(): boolean {
+  return Boolean(
+    process.env.PAYHERO_USERNAME &&
+      process.env.PAYHERO_PASSWORD &&
+      // Without a channel the request is accepted and the money has nowhere
+      // to land, so this is as load-bearing as the credentials.
+      process.env.PAYHERO_CHANNEL_ID &&
+      process.env.APP_URL,
+  );
+}
+
+const baseUrl = () =>
+  (process.env.PAYHERO_BASE_URL || "https://backend.payhero.co.ke").replace(/\/+$/, "");
+
+/** The name the member will read on their handset, if we have been told it. */
+export function payheroPromptName(): string | null {
+  const n = (process.env.PAYHERO_DISPLAY_NAME || "").trim();
+  return n === "" ? null : n;
+}
+
+/** Callback URL PayHero posts the result to.
+ *
+ *  PayHero's request signing is optional and undocumented, so the secret path
+ *  segment is what stops a stranger marking an invoice paid by guessing a
+ *  CheckoutRequestID — the same reasoning as MPESA_CALLBACK_TOKEN. */
+export function payheroCallbackUrl(): string {
+  const base = `${process.env.APP_URL}/api/payhero/callback`;
+  const token = process.env.PAYHERO_CALLBACK_TOKEN;
+  return token ? `${base}/${encodeURIComponent(token)}` : base;
+}
+
+/** 2547XXXXXXXX / 2541XXXXXXXX — the only form PayHero accepts. */
+export function normalizePhone(raw: string): string {
+  const d = raw.replace(/\D/g, "");
+  if (d.startsWith("254")) return d;
+  if (d.startsWith("0")) return "254" + d.slice(1);
+  if (d.startsWith("7") || d.startsWith("1")) return "254" + d;
+  return d;
+}
+
+export async function stkPush(input: {
+  phone: string;
+  amount: number;
+  accountRef: string;
+  description: string;
+}): Promise<StkResult> {
+  if (!payheroConfigured()) return { ok: false, error: "PayHero not configured" };
+
+  const auth = Buffer.from(
+    `${process.env.PAYHERO_USERNAME}:${process.env.PAYHERO_PASSWORD}`,
+  ).toString("base64");
+
+  try {
+    // A slow gateway must not hold the member's click open indefinitely.
+    const res = await fetch(`${baseUrl()}/api/v2/payments`, {
+      method: "POST",
+      headers: { Authorization: `Basic ${auth}`, "Content-Type": "application/json" },
+      cache: "no-store",
+      signal: AbortSignal.timeout(20_000),
+      body: JSON.stringify({
+        amount: Math.max(1, Math.round(input.amount)),
+        phone_number: normalizePhone(input.phone),
+        channel_id: Number(process.env.PAYHERO_CHANNEL_ID),
+        provider: "m-pesa",
+        // Comes back on the callback. The invoice number is what the admin
+        // quotes, so it is the useful thing to carry.
+        external_reference: input.accountRef,
+        customer_name: input.description.slice(0, 60),
+        callback_url: payheroCallbackUrl(),
+      }),
+    });
+
+    const j = (await res.json().catch(() => null)) as
+      | { success?: boolean; CheckoutRequestID?: string; reference?: string; error_message?: string; message?: string }
+      | null;
+
+    // PayHero answers 200 with success:false for a refusal, so the status
+    // code alone is not an answer.
+    if (!res.ok || j?.success === false) {
+      const reason = j?.error_message ?? j?.message ?? `HTTP ${res.status}`;
+
+      // The one refusal an operator can fix, and the one that looks exactly
+      // like a flaky network: PayHero spends a prepaid SERVICE wallet to send
+      // each prompt, and an empty one refuses every request while the
+      // credentials and channel still look perfect.
+      if (/insufficient|balance|wallet|top ?up/i.test(reason)) {
+        return { ok: false, error: `PayHero service wallet is empty — top it up. (${reason})` };
+      }
+      return { ok: false, error: reason };
+    }
+
+    const checkoutId = j?.CheckoutRequestID ?? j?.reference;
+
+    return checkoutId
+      ? { ok: true, checkoutId }
+      : { ok: false, error: "PayHero accepted the request but returned no reference" };
+  } catch (e) {
+    return { ok: false, error: e instanceof Error ? e.message : String(e) };
+  }
+}

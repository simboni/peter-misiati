+import "server-only";
+
+/* ==========================================================================
+   Which provider collects the money.
+
+   The app used to call Daraja directly from the portal action, so switching
+   provider meant editing the checkout. Everything now asks here instead, and
+   the only thing that changes is an env var.
+
+     PAYMENTS_PROVIDER=payhero|daraja    pick one explicitly
+     unset                               whichever is configured, PayHero
+                                         first — it is the one that works
+                                         without a Safaricom shortcode
+
+   Both return the same StkResult carrying a CheckoutRequestID, and both
+   reconcile through settleByCheckout, so a switch needs no data migration
+   and leaves old invoices settleable by whichever provider raised them.
+   ========================================================================== */
+
+import * as daraja from "./mpesa";
+import * as payhero from "./payhero";
+import type { StkResult } from "./mpesa";
+
+export type Provider = "payhero" | "daraja";
+
+/** The provider that will actually be used, or null if none can run. */
+export function activeProvider(): Provider | null {
+  const forced = (process.env.PAYMENTS_PROVIDER || "").trim().toLowerCase();
+
+  if (forced === "payhero") return payhero.payheroConfigured() ? "payhero" : null;
+  if (forced === "daraja") return daraja.mpesaConfigured() ? "daraja" : null;
+
+  if (payhero.payheroConfigured()) return "payhero";
+  if (daraja.mpesaConfigured()) return "daraja";
+
+  return null;
+}
+
+/** Can a member pay right now? Replaces the direct mpesaConfigured() checks. */
+export function paymentsConfigured(): boolean {
+  return activeProvider() !== null;
+}
+
+/**
+ * The business name the member will see on the prompt, when it is not ours.
+ *
+ * Null for Daraja, where the gym's own shortcode means the prompt already
+ * says Fit Generations. Non-null for an aggregator, where it says somebody
+ * else and an unexplained company name is what makes a careful member cancel.
+ */
+export function promptName(): string | null {
+  return activeProvider() === "payhero" ? payhero.payheroPromptName() : null;
+}
+
+export async function stkPush(input: {
+  phone: string;
+  amount: number;
+  accountRef: string;
+  description: string;
+}): Promise<StkResult> {
+  switch (activeProvider()) {
+    case "payhero":
+      return payhero.stkPush(input);
+    case "daraja":
+      return daraja.stkPush(input);
+    default:
+      return { ok: false, error: "No payment provider is configured" };
+  }
+}
+
+export type { StkResult };

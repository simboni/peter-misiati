+++ b/src/app/api/portal/invoices/[id]/status/route.ts
@@ -0,0 +1,27 @@
+import { currentUser } from "@/lib/auth/current-user";
+import { getInvoice } from "@/lib/db/repo";
+
+export const dynamic = "force-dynamic";
+
+/** What the member's payment screen polls while a prompt is out.
+ *
+ *  Session-guarded and ownership-checked: an invoice id is short and
+ *  guessable, and without the owner check this would let any signed-in member
+ *  watch anybody's balance. A stranger's id answers 404, not 403 — there is no
+ *  reason to confirm that an invoice exists to someone who cannot see it.
+ */
+export async function GET(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  const session = await currentUser();
+  if (session?.role !== "member") {
+    return new Response("Not found", { status: 404 });
+  }
+
+  const { id } = await ctx.params;
+  const inv = getInvoice(id);
+
+  if (!inv || inv.memberId !== session.sub) {
+    return new Response("Not found", { status: 404 });
+  }
+
+  return Response.json({ status: inv.status, balance: inv.balance });
+}
diff --git a/src/components/portal/payment-stage.tsx b/src/components/portal/payment-stage.tsx
new file mode 100644
index 0000000..3439859
--- /dev/null
+++ b/src/components/portal/payment-stage.tsx
@@ -0,0 +1,175 @@
+"use client";
+
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { useRouter } from "next/navigation";
+
+/* ==========================================================================
+   The payment screen, ported from the 64 Theatre checkout and restyled.
+
+   Four states, few words: Check your phone → Still waiting → Paid, or
+   Payment not completed. The things that matter were learned the hard way
+   over there and are kept deliberately:
+
+   · A bar that FILLS, never a countdown. A number reaching zero invites
+     people to give up on prompts that routinely arrive late and succeed.
+   · The partner's name as a quiet badge. The prompt shows the collecting
+     paybill's registered name, not the gym's, and an unexplained company
+     name is what makes a careful member cancel.
+   · Softened at 20 seconds rather than declared broken — the honest state is
+     "still going", and saying so stops people paying twice.
+   · Polling backs off. Each poll is an upstream call, not just a row read.
+
+   Colours follow this platform, not the theatre: lime for progress and
+   success, ember for failure.
+   ========================================================================== */
+
+type State = "prompted" | "paid" | "failed";
+
+export function PaymentStage({
+  statusUrl,
+  amount,
+  partnerName,
+  initial = "prompted",
+  initialError,
+  retry,
+}: {
+  statusUrl: string;
+  amount: string;
+  partnerName?: string | null;
+  initial?: State;
+  initialError?: string | null;
+  /** The retry form, rendered by the server so the action stays server-side. */
+  retry: ReactNode;
+}) {
+  const router = useRouter();
+  const [state, setState] = useState<State>(initial);
+  const [head, setHead] = useState(initial === "failed" ? "Payment not completed" : "Check your phone");
+  const [sub, setSub] = useState(
+    initial === "failed"
+      ? initialError || "The prompt was cancelled or timed out."
+      : `Enter your M-Pesa PIN · ${amount}`,
+  );
+  const [showActions, setShowActions] = useState(initial === "failed");
+  const [progress, setProgress] = useState(0);
+  const started = useRef(Date.now());
+
+  // Filling bar over a 60s window.
+  useEffect(() => {
+    if (state !== "prompted") return;
+    let raf = 0;
+    const tick = () => {
+      const pct = Math.min(100, ((Date.now() - started.current) / 60_000) * 100);
+      setProgress(pct);
+      if (pct < 100) raf = requestAnimationFrame(tick);
+    };
+    raf = requestAnimationFrame(tick);
+    return () => cancelAnimationFrame(raf);
+  }, [state]);
+
+  // Soften, do not alarm.
+  useEffect(() => {
+    if (state !== "prompted") return;
+    const t = setTimeout(() => {
+      setHead("Still waiting");
+      setSub("Prompts can take a minute on a busy network.");
+      setShowActions(true);
+    }, 20_000);
+    return () => clearTimeout(t);
+  }, [state]);
+
+  // Poll, backing off.
+  useEffect(() => {
+    if (state !== "prompted") return;
+    let cancelled = false;
+    let wait = 2500;
+
+    const run = () => {
+      if (cancelled) return;
+      setTimeout(async () => {
+        if (cancelled) return;
+        try {
+          const r = await fetch(statusUrl, { headers: { Accept: "application/json" }, cache: "no-store" });
+          const d = (await r.json()) as { status?: string };
+          if (cancelled) return;
+          if (d.status === "paid") {
+            setState("paid");
+            setHead("Paid");
+            setSub("Activating your membership…");
+            setTimeout(() => router.refresh(), 900);
+            return;
+          }
+          wait = Math.min(wait + 900, 6000);
+        } catch {
+          wait = Math.min(wait + 1500, 8000);
+        }
+        run();
+      }, wait);
+    };
+
+    run();
+    return () => {
+      cancelled = true;
+    };
+  }, [state, statusUrl, router]);
+
+  const accent =
+    state === "failed"
+      ? { ring: "border-ember-500/50", bg: "bg-ember-500/10", icon: "text-ember-400" }
+      : state === "paid"
+        ? { ring: "border-lime-500/55", bg: "bg-lime-500/15", icon: "text-lime-400" }
+        : { ring: "border-lime-500/45", bg: "bg-lime-500/10", icon: "text-lime-400" };
+
+  return (
+    <div className="rounded-3xl border border-white/10 bg-ink-900 px-6 py-9 text-center">
+      <div className="relative mx-auto mb-6 h-[86px] w-[86px]">
+        {state === "prompted" && (
+          <>
+            <span className="absolute inset-0 animate-ping rounded-full border border-lime-500/40" />
+            <span className="absolute inset-0 rounded-full border border-lime-500/20" />
+          </>
+        )}
+        <span
+          className={`absolute inset-[13px] grid place-items-center rounded-full border ${accent.ring} ${accent.bg}`}
+        >
+          <svg viewBox="0 0 24 24" fill="none" strokeWidth={1.7} strokeLinecap="round" strokeLinejoin="round"
+               className={`h-7 w-7 ${accent.icon}`} stroke="currentColor" aria-hidden="true">
+            {state === "paid" ? (
+              <path d="M5 12.5l4.5 4.5L19 7.5" />
+            ) : state === "failed" ? (
+              <>
+                <circle cx="12" cy="12" r="9" />
+                <path d="M12 8v5" />
+                <path d="M12 16.5v.01" />
+              </>
+            ) : (
+              <>
+                <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
+                <path d="M10.5 18.5h3" />
+              </>
+            )}
+          </svg>
+        </span>
+      </div>
+
+      <h3 className="font-display text-xl text-white">{head}</h3>
+      <p className="mt-1.5 text-sm text-white/55">{sub}</p>
+
+      {partnerName && state === "prompted" && (
+        <span className="mt-4 inline-block rounded-full border border-white/12 bg-white/[0.04] px-3 py-1 text-[11px] uppercase tracking-[0.09em] text-white/45">
+          {partnerName}
+        </span>
+      )}
+
+      {state === "prompted" && (
+        <div className="mx-auto mt-6 h-[3px] max-w-[280px] overflow-hidden rounded-full bg-white/10">
+          <div
+            className="h-full rounded-full bg-gradient-to-r from-lime-600 to-lime-400 transition-[width] duration-200"
+            style={{ width: `${progress}%` }}
+          />
+        </div>
+      )}
+
+      {showActions && state !== "paid" && <div className="mt-6">{retry}</div>}
+    </div>
+  );
+}

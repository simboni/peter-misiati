+/**
+ * How the fourteen admin destinations are grouped in the sidebar.
+ *
+ * Kept SEPARATE from adminNav rather than nesting it, because adminNav is
+ * filtered by RBAC in app/admin/layout.tsx and mirrored by permissions.ts —
+ * nesting would mean changing both and every consumer. The sidebar groups
+ * whatever filtered list it is handed and drops groups that end up empty, so
+ * a receptionist who cannot see billing never sees an orphaned "Money"
+ * heading.
+ *
+ * Order within a group is deliberate: the thing used most often is first.
+ */
+export const adminNavGroups: { label: string; hrefs: string[] }[] = [
+  { label: "Overview", hrefs: ["/admin", "/admin/reports", "/admin/notifications"] },
+  { label: "People", hrefs: ["/admin/users", "/admin/attendance", "/admin/reservations"] },
+  { label: "Money", hrefs: ["/admin/billing", "/admin/membership", "/admin/store"] },
+  { label: "Training", hrefs: ["/admin/classes", "/admin/workout", "/admin/nutrition", "/admin/calculators"] },
+  { label: "System", hrefs: ["/admin/settings"] },
+];

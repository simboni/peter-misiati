diff --git a/src/lib/auth/current-member.ts b/src/lib/auth/current-member.ts
new file mode 100644
index 0000000..0ed933f
--- /dev/null
+++ b/src/lib/auth/current-member.ts
@@ -0,0 +1,34 @@
+import "server-only";
+import { getUser } from "@/lib/db/repo";
+import { currentUser } from "./current-user";
+import type { User } from "@/lib/db/schema";
+
+/**
+ * Who is signed in to the member portal — resolved all the way to the record,
+ * not just to the cookie.
+ *
+ * `currentUser()` reads the cookie and nothing else, and a cookie outlives the
+ * thing it points at. Delete a member from the office, or restore a database
+ * from before they joined, and their browser keeps presenting a perfectly
+ * valid, correctly signed session for an id that resolves to nobody.
+ *
+ * That gap is what trapped people on the portal. /portal asked for the RECORD,
+ * found none, and showed the signed-out "Members area" screen. /portal/login
+ * and /portal/signup asked the COOKIE, saw "member", and redirected back to
+ * /portal. So both buttons on that screen led straight back to it, the page
+ * appeared to load and never change, and the header offered no sign-out to
+ * break the loop. Only a private window worked, because it had no cookie.
+ *
+ * Every portal page now asks this one question, so none of them can disagree
+ * about whether somebody is signed in.
+ *
+ * `staleSession` means: there IS a session here, and it belongs to nobody. The
+ * portal uses it to say so and offer a way out, rather than silently showing
+ * a signed-out page to someone who believes they are signed in.
+ */
+export async function currentMember(): Promise<{ member: User | null; staleSession: boolean }> {
+  const session = await currentUser().catch(() => null);
+  if (session?.role !== "member") return { member: null, staleSession: false };
+  const member = getUser(session.sub) ?? null;
+  return { member, staleSession: member === null };
+}

diff --git a/src/lib/services/public-pricing.ts b/src/lib/services/public-pricing.ts
new file mode 100644
index 0000000..8e1ab27
--- /dev/null
+++ b/src/lib/services/public-pricing.ts
@@ -0,0 +1,168 @@
+import "server-only";
+import { listBillablePlans } from "@/lib/db/repo";
+import { planTiers, type PlanTier } from "@/lib/gym";
+import type { BillablePlan } from "@/lib/db/schema";
+
+/* ==========================================================================
+   What the website says a membership costs.
+
+   It now says what the gym will actually charge. Before this, /pricing and
+   the homepage rendered `planTiers` — a list in the source code — while
+   Membership Plans in the office edited `billablePlans`, which is what
+   assignPlan prices an invoice from. Nothing connected them. A price changed
+   in the office never reached the website, and the figure a member was billed
+   could differ from the figure that persuaded them to join. There was no
+   warning on either screen, because neither knew the other existed.
+
+   So: every number here comes from the catalog. The words around them —
+   headline, subtitle, perks, accent, which card is highlighted — are
+   editorial, have no admin screen, and stay in code.
+
+   Deactivating a plan in the office now also takes it off the website, which
+   is what "active" always looked like it meant.
+   ========================================================================== */
+
+export type PublicOption = { label: string; price: number; note?: string };
+export type PublicTier = Omit<PlanTier, "options" | "from"> & {
+  from: number;
+  options: PublicOption[];
+};
+
+/**
+ * The billing cycle each tier quotes its headline "from" price in.
+ *
+ * Stated rather than guessed, because the cheapest plan in a tier is not the
+ * one the headline means: Members starts "from KSh 3,000 / month", and the
+ * cheapest Members plan is a KSh 200 day pass. A tier not named here falls
+ * back to its cheapest plan, labelled with that plan's own cycle.
+ */
+const HEADLINE_CYCLE: Record<string, BillablePlan["billingCycle"]> = {
+  Members: "monthly",
+  Corporate: "monthly",
+  "Non-member": "daily",
+};
+
+const CYCLE_UNIT: Record<BillablePlan["billingCycle"], string> = {
+  daily: "/ session",
+  monthly: "/ month",
+  quarterly: "/ quarter",
+  "half-year": "/ half year",
+  yearly: "/ year",
+};
+
+const money = (n: number) => `KSh ${n.toLocaleString()}`;
+
+/** "Members — Monthly" → "Monthly". Falls back to the whole name. */
+const optionLabel = (p: BillablePlan) => p.name.split("—")[1]?.trim() || p.name;
+
+/**
+ * The note under an option. Derived, never written down: a hardcoded
+ * "Save KSh 1,000" stops being true the moment somebody edits a price, and
+ * an untrue saving on a pricing page is worse than no saving at all.
+ */
+function noteFor(p: BillablePlan, monthly: BillablePlan | undefined): string | undefined {
+  if (p.category === "corporate") return "per person / month";
+  if (p.durationDays <= 1) return "per session";
+  if (!monthly || p.id === monthly.id) return undefined;
+  const months = Math.round(p.durationDays / 30);
+  if (months < 2) return undefined;
+  const saving = monthly.price * months - p.price;
+  return saving > 0 ? `Save ${money(saving)}` : undefined;
+}
+
+/** The tiers the website shows, in the order the editorial list declares. */
+export function publicPricing(): PublicTier[] {
+  const active = listBillablePlans();
+  const tiers: PublicTier[] = [];
+
+  // Editorial order first, then any tier the gym has invented in the office
+  // since — otherwise a new tier is sold in the admin and invisible outside.
+  const names = [
+    ...planTiers.map((t) => t.label),
+    ...active.map((p) => p.tier).filter((t) => !planTiers.some((e) => e.label === t)),
+  ].filter((v, i, a) => a.indexOf(v) === i);
+
+  for (const name of names) {
+    // By duration only. Sorting ties by price as well would reorder the
+    // corporate options cheapest-first, so the card would read "above 20,
+    // 10–20, 5" — the catalog's own order is by team size, and a stable sort
+    // keeps it.
+    const plans = active
+      .filter((p) => p.tier === name)
+      .sort((a, b) => a.durationDays - b.durationDays);
+    // A tier with nothing active is a tier the gym has stopped selling.
+    if (plans.length === 0) continue;
+
+    const editorial = planTiers.find((t) => t.label === name);
+    const cycle = HEADLINE_CYCLE[name];
+    const headlinePlans = cycle ? plans.filter((p) => p.billingCycle === cycle) : [];
+    const cheapest = (headlinePlans.length ? headlinePlans : plans)
+      .reduce((lo, p) => (p.price < lo.price ? p : lo));
+    const monthly = plans.find((p) => p.billingCycle === "monthly");
+
+    tiers.push({
+      id: editorial?.id ?? name.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
+      label: name,
+      headline: editorial?.headline ?? `${name} Packages`,
+      subtitle: editorial?.subtitle ?? "",
+      accent: editorial?.accent ?? "lime",
+      featured: editorial?.featured,
+      perks: editorial?.perks ?? [
+        "Access to all equipment",
+        "Access to all instructors",
+        "Access to all facilities & classes",
+      ],
+      from: cheapest.price,
+      unit: CYCLE_UNIT[cheapest.billingCycle],
+      options: plans.map((p) => ({
+        label: optionLabel(p),
+        price: p.price,
+        note: noteFor(p, monthly),
+      })),
+    });
+  }
+
+  return tiers;
+}
+
+/**
+ * The registration fee to advertise — read off the plans that charge it, not
+ * from a constant. It is charged per plan, so the honest answer when they
+ * disagree is the lowest, said as "from"; and when nothing charges one, the
+ * right answer is to say nothing at all rather than advertise a fee the gym
+ * has stopped taking.
+ */
+export function publicRegistrationFee(): { amount: number; varies: boolean } | null {
+  const fees = [...new Set(listBillablePlans().map((p) => p.registrationFee).filter((f) => f > 0))];
+  if (fees.length === 0) return null;
+  return { amount: Math.min(...fees), varies: fees.length > 1 };
+}
+
+/**
+ * The handful of figures the prose quotes — the FAQ answers a joining fee, a
+ * drop-in rate and a corporate rate in sentences.
+ *
+ * They were written into the copy as "KSh 500", "KSh 200", "KSh 250" and
+ * "KSh 2,300". Prices on a pricing page that disagree with the cards above
+ * them are the same bug in a smaller box, so these come from the catalog too
+ * and each is null when nothing in the catalog backs it up.
+ */
+export function publicPriceFacts(): {
+  registration: number | null;
+  memberSession: number | null;
+  visitorSession: number | null;
+  corporateLowest: number | null;
+} {
+  const active = listBillablePlans();
+  const cheapest = (rows: BillablePlan[]) =>
+    rows.length ? rows.reduce((lo, p) => (p.price < lo.price ? p : lo)).price : null;
+  const session = (tier: string) =>
+    cheapest(active.filter((p) => p.tier === tier && p.durationDays <= 1));
+
+  return {
+    registration: publicRegistrationFee()?.amount ?? null,
+    memberSession: session("Members"),
+    visitorSession: session("Non-member"),
+    corporateLowest: cheapest(active.filter((p) => p.category === "corporate")),
+  };
+}

     secure: process.env.NODE_ENV === "production",
   });
 
+  // Clears THIS browser's cached renders. Unlike an admin changing a member's
+  // record — where the stale page is in somebody else's browser and out of
+  // reach — signing in and out happens in the same browser that then has to
+  // show the result, so this is the one place the cache can be reached.
+  revalidatePath("/", "layout");
+
   if (user.role === "member") {
     redirect(next.startsWith("/portal") ? next : "/portal");
   }
@@ -37,7 +45,18 @@ export async function login(_prev: LoginState, formData: FormData): Promise<Logi
 }
 
 export async function logout() {
+  // Who this is has to be read BEFORE the cookie goes, or afterwards there is
+  // no way to tell a member from a staff member. Signing out of the portal
+  // used to drop members on /login — the STAFF sign-in — which looks exactly
+  // like being bounced back to a sign-in page that will not let you through.
+  const wasMember = (await currentUser())?.role === "member";
+
   const jar = await cookies();
   jar.delete(SESSION_COOKIE);
-  redirect("/login");
+
+  // Same reasoning as sign-in: this browser is about to be shown pages it
+  // cached while somebody was signed in.
+  revalidatePath("/", "layout");
+
+  redirect(wasMember ? "/portal/login" : "/login");
 }

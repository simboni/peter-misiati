@@ -44,3 +40,47 @@ MPESA_CONSUMER_SECRET=
 MPESA_SHORTCODE=
 MPESA_PASSKEY=
 MPESA_CALLBACK_TOKEN=
+
+# --- Email -------------------------------------------------------------------
+# Two ways to send; SMTP wins when both are set.
+#
+# SMTP sends through a real mailbox, so mail leaves as info@yourdomain and a
+# member hitting reply reaches a person. That is the reason to prefer it.
+# The trade is volume: mailbox plans cap daily sends, and a month-end run of
+# invoices to every member can reach the cap — at which point the rest fail
+# silently. Watch the logs the first time a full run goes out.
+#
+# SMTP_USER is the FULL address. A bare "info" authenticates against nothing
+# and the server refuses to relay, which presents as "receiving works but
+# sending does not".
+# Hostinger: smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS).
+SMTP_HOST=
+SMTP_PORT=587
+SMTP_USER=
+SMTP_PASS=
+SMTP_SECURE=
+MAIL_FROM="Fit Generations Gym <info@fitgenerationsgym.com>"
+
+# Resend — HTTP API, no mailbox. Used only when SMTP is unset.
+RESEND_API_KEY=
+
+# --- PayHero (recommended) ---------------------------------------------------
+# STK push that settles straight into the gym's bank account. The member still
+# approves an M-Pesa prompt — "bank" is where the money lands, not how they pay.
+# A bank paybill cannot raise a prompt by itself; that is the gap PayHero fills,
+# and it needs no Safaricom shortcode approval.
+#
+# Leave PAYMENTS_PROVIDER blank to use whichever is configured (PayHero first).
+# USERNAME/PASSWORD are API credentials from the dashboard, NOT the login.
+# CHANNEL_ID is under Payment Channels — use the BANK channel.
+# CALLBACK_TOKEN is a secret path segment; without it anyone who guesses a
+# CheckoutRequestID can mark an invoice paid. Generate: openssl rand -hex 16
+# DISPLAY_NAME is the name shown on the member's prompt — it is the collecting
+# paybill's, not the gym's, so the portal says it in advance.
+PAYMENTS_PROVIDER=
+PAYHERO_BASE_URL=https://backend.payhero.co.ke
+PAYHERO_USERNAME=
+PAYHERO_PASSWORD=
+PAYHERO_CHANNEL_ID=
+PAYHERO_CALLBACK_TOKEN=
+PAYHERO_DISPLAY_NAME=

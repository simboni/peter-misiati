diff --git a/src/lib/services/expenses.ts b/src/lib/services/expenses.ts
new file mode 100644
index 0000000..c4530b7
--- /dev/null
+++ b/src/lib/services/expenses.ts
@@ -0,0 +1,159 @@
+import "server-only";
+import { getDB, saveDB, uid } from "@/lib/db/store";
+import { GYM_ID, type Expense, type PayMethod } from "@/lib/db/schema";
+
+/* ==========================================================================
+   What the gym spends.
+
+   Expenses existed before this only as a side effect: settling a service
+   charge wrote one, and nothing else ever did. So the income-vs-expense chart
+   on the dashboard was drawing the cost of collecting money and calling it
+   the cost of running a gym — rent, salaries and electricity were nowhere.
+
+   Two kinds of row live here and they are NOT equal:
+
+   · Hand-entered — the gym's own record. Editable, deletable.
+   · Automatic (serviceChargeId set) — owned by the service charge that
+     created it. Shown, counted, but not editable here; undoing the charge is
+     what takes it back. Letting someone delete one by hand would leave a
+     charge marked paid with nothing behind it.
+   ========================================================================== */
+
+const todayISO = () => new Date().toISOString().slice(0, 10);
+const monthOf = (date: string) => date.slice(0, 7);
+
+export const isAutomatic = (e: Expense) => Boolean(e.serviceChargeId);
+
+/** Newest first — the order anyone scanning a spend list expects. */
+export function listExpenses(): Expense[] {
+  return [...getDB().expenses].sort((a, b) => {
+    const ad = a.date ?? `${a.month}-01`;
+    const bd = b.date ?? `${b.month}-01`;
+    return bd.localeCompare(ad);
+  });
+}
+
+export function getExpense(id: string): Expense | undefined {
+  return getDB().expenses.find((e) => e.id === id);
+}
+
+/** Every month that has any money in or out, newest first. Drives the period
+    picker, so it never offers a month with nothing in it. */
+export function expenseMonths(): string[] {
+  const db = getDB();
+  const set = new Set<string>();
+  for (const e of db.expenses) set.add(e.month);
+  for (const p of db.payments) if (p.status !== "Reversed") set.add(p.date.slice(0, 7));
+  return [...set].sort().reverse();
+}
+
+export async function createExpense(input: {
+  date: string;
+  amount: number;
+  category: string;
+  note?: string;
+  payee?: string;
+  method?: PayMethod;
+  recordedBy?: string;
+}): Promise<void> {
+  const date = input.date || todayISO();
+  await saveDB((db) => {
+    db.expenses.push({
+      id: uid("EXP"),
+      gymId: GYM_ID,
+      // Derived from the date rather than asked for separately: two fields
+      // that must agree are two fields that will eventually disagree.
+      month: monthOf(date),
+      date,
+      amount: Math.max(0, Math.round(input.amount)),
+      category: input.category || "Other",
+      note: input.note?.trim() || undefined,
+      payee: input.payee?.trim() || undefined,
+      method: input.method,
+      recordedBy: input.recordedBy?.trim() || undefined,
+      createdAt: todayISO(),
+    });
+  });
+}
+
+export async function updateExpense(
+  id: string,
+  patch: { date?: string; amount?: number; category?: string; note?: string; payee?: string; method?: PayMethod },
+): Promise<void> {
+  await saveDB((db) => {
+    const e = db.expenses.find((x) => x.id === id);
+    if (!e || isAutomatic(e)) return; // an automatic row is the charge's, not ours
+    if (patch.date) { e.date = patch.date; e.month = monthOf(patch.date); }
+    if (patch.amount !== undefined) e.amount = Math.max(0, Math.round(patch.amount));
+    if (patch.category) e.category = patch.category;
+    e.note = patch.note?.trim() || undefined;
+    e.payee = patch.payee?.trim() || undefined;
+    e.method = patch.method;
+  });
+}
+
+export async function deleteExpense(id: string): Promise<void> {
+  await saveDB((db) => {
+    const i = db.expenses.findIndex((x) => x.id === id);
+    if (i < 0 || isAutomatic(db.expenses[i])) return;
+    db.expenses.splice(i, 1);
+  });
+}
+
+/* ----------------------------- the numbers ------------------------------ */
+
+export type MoneyPeriod = {
+  /** YYYY-MM, or "all". */
+  month: string;
+  income: number;
+  expense: number;
+  net: number;
+  byCategory: { category: string; amount: number }[];
+};
+
+/** Money in and out for one month, or for everything when given "all".
+ *
+ *  Income is the payment ledger with reversed rows excluded — the same
+ *  filtered list the billing screens total, so two figures on two screens
+ *  cannot disagree. */
+export function moneyFor(month: string): MoneyPeriod {
+  const db = getDB();
+  const inMonth = (d: string) => month === "all" || d.slice(0, 7) === month;
+
+  const income = db.payments
+    .filter((p) => p.status !== "Reversed" && inMonth(p.date))
+    .reduce((s, p) => s + p.amount, 0);
+
+  const rows = db.expenses.filter((e) => month === "all" || e.month === month);
+  const expense = rows.reduce((s, e) => s + e.amount, 0);
+
+  const byCat = new Map<string, number>();
+  for (const e of rows) byCat.set(e.category, (byCat.get(e.category) ?? 0) + e.amount);
+
+  return {
+    month,
+    income,
+    expense,
+    net: income - expense,
+    byCategory: [...byCat.entries()]
+      .map(([category, amount]) => ({ category, amount }))
+      .sort((a, b) => b.amount - a.amount),
+  };
+}
+
+/** The last `count` months of money in and out, oldest first — the bar chart.
+    Anchored on the newest month that has anything in it rather than on today,
+    so a quiet month does not push the whole chart off the end. */
+export function moneyTrend(count = 7): { month: string; income: number; expense: number }[] {
+  const months = expenseMonths();
+  const anchor = months[0] ?? new Date().toISOString().slice(0, 7);
+  const [y, m] = anchor.split("-").map(Number);
+  const out: { month: string; income: number; expense: number }[] = [];
+  for (let i = count - 1; i >= 0; i--) {
+    const d = new Date(Date.UTC(y, m - 1 - i, 1));
+    const key = d.toISOString().slice(0, 7);
+    const { income, expense } = moneyFor(key);
+    out.push({ month: key, income, expense });
+  }
+  return out;
+}

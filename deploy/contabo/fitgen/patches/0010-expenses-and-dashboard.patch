new file mode 100644
index 0000000..d0485ec
--- /dev/null
+++ b/src/components/admin/period-picker.tsx
@@ -0,0 +1,69 @@
+"use client";
+
+import { useRouter, useSearchParams } from "next/navigation";
+import { useTransition } from "react";
+import { Ico } from "@/components/admin/admin-icons";
+
+/* ==========================================================================
+   A period control that actually changes the figures.
+
+   What stood here before was a `<span>` styled to look like a dropdown, on
+   four dashboard cards. It had a chevron and everything, and nothing behind
+   it — so the numbers it appeared to govern were always all-time, and the
+   screen quietly lied about what it was showing.
+
+   The choice lives in the URL rather than in component state, so the server
+   recomputes, a reload keeps the period, and the view can be sent to someone
+   else as a link. Other query parameters are preserved: the dashboard and the
+   expenses screen both hang other things off the URL.
+   ========================================================================== */
+
+const label = (m: string) =>
+  m === "all"
+    ? "All time"
+    : new Date(`${m}-01T00:00:00Z`).toLocaleDateString("en-GB", {
+        month: "long",
+        year: "numeric",
+        timeZone: "UTC",
+      });
+
+export function PeriodPicker({
+  months,
+  value,
+  basePath,
+  param = "month",
+}: {
+  /** Months that have something in them, newest first. */
+  months: string[];
+  value: string;
+  basePath: string;
+  param?: string;
+}) {
+  const router = useRouter();
+  const search = useSearchParams();
+  const [pending, start] = useTransition();
+
+  const go = (next: string) => {
+    const q = new URLSearchParams(search.toString());
+    q.set(param, next);
+    start(() => router.push(`${basePath}?${q.toString()}`));
+  };
+
+  return (
+    <label className="relative inline-flex items-center">
+      <span className="sr-only">Period</span>
+      <select
+        value={value}
+        onChange={(e) => go(e.target.value)}
+        disabled={pending}
+        className="appearance-none rounded-lg border border-zinc-200 bg-white py-2 pl-3 pr-8 text-sm font-medium text-zinc-700 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-100 disabled:opacity-60"
+      >
+        {months.map((m) => (
+          <option key={m} value={m}>{label(m)}</option>
+        ))}
+        <option value="all">All time</option>
+      </select>
+      <Ico name="chevronDown" className="pointer-events-none absolute right-2.5 h-3.5 w-3.5 text-zinc-400" />
+    </label>
+  );
+}

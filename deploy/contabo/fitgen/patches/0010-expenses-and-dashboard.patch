+import Link from "next/link";
+import { notFound, redirect } from "next/navigation";
+import { getExpense, isAutomatic } from "@/lib/services/expenses";
+import { updateExpenseAction, deleteExpenseAction } from "@/lib/admin/module-actions";
+import { PageHeading, Card, money } from "@/components/admin/ui";
+import { SubmitButton } from "@/components/admin/submit-button";
+import { ConfirmSubmit } from "@/components/admin/confirm-submit";
+import { EXPENSE_CATEGORIES, type PayMethod } from "@/lib/db/schema";
+
+export const dynamic = "force-dynamic";
+
+const field = "w-full rounded-lg border border-zinc-200 px-3 py-2 text-sm text-zinc-800 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-100";
+const METHODS: PayMethod[] = ["Cash", "Mpesa", "Bank Transfer", "Cheque", "Card"];
+
+export default async function EditExpensePage({
+  params, searchParams,
+}: {
+  params: Promise<{ id: string }>;
+  searchParams: Promise<{ month?: string }>;
+}) {
+  const { id } = await params;
+  const { month = "" } = await searchParams;
+  const e = getExpense(id);
+  if (!e) notFound();
+  // An automatic row belongs to the service charge that booked it. Editing it
+  // here would leave a charge marked paid against a figure that no longer
+  // matches, so there is nothing to edit — send them to where it came from.
+  if (isAutomatic(e)) redirect("/admin/billing");
+
+  const back = month ? `/admin/expenses?month=${month}` : "/admin/expenses";
+
+  return (
+    <>
+      <PageHeading
+        title="Edit expense"
+        subtitle={`${money(e.amount)} · ${e.category}`}
+        action={<Link href={back} className="text-sm font-semibold text-zinc-500 hover:text-ember-600">← Back to expenses</Link>}
+      />
+
+      <Card className="max-w-2xl">
+        <form action={updateExpenseAction} className="grid gap-4 sm:grid-cols-2">
+          <input type="hidden" name="id" value={e.id} />
+          <input type="hidden" name="month" value={month} />
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Date</span>
+            <input name="date" type="date" defaultValue={e.date ?? `${e.month}-01`} className={field} />
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Amount (KSh)</span>
+            <input name="amount" type="number" min="0" step="1" defaultValue={e.amount} required className={field} />
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Category</span>
+            <select name="category" defaultValue={e.category} className={field}>
+              {[...new Set([...EXPENSE_CATEGORIES, e.category])].map((c) => <option key={c}>{c}</option>)}
+            </select>
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Paid to</span>
+            <input name="payee" defaultValue={e.payee ?? ""} className={field} />
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Paid by</span>
+            <select name="method" defaultValue={e.method ?? "Cash"} className={field}>
+              {METHODS.map((m) => <option key={m}>{m}</option>)}
+            </select>
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Note</span>
+            <input name="note" defaultValue={e.note ?? ""} className={field} />
+          </label>
+          <div className="sm:col-span-2">
+            <SubmitButton className="rounded-lg bg-ember-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-ember-600">
+              Save changes
+            </SubmitButton>
+          </div>
+        </form>
+
+        <div className="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-100 pt-5">
+          <p className="text-xs text-zinc-400">
+            {e.recordedBy ? `Recorded by ${e.recordedBy}` : "Recorded"}{e.createdAt ? ` on ${e.createdAt}` : ""}.
+          </p>
+          <form action={deleteExpenseAction}>
+            <input type="hidden" name="id" value={e.id} />
+            <input type="hidden" name="month" value={month} />
+            <ConfirmSubmit
+              confirm={`Delete this ${money(e.amount)} expense? This cannot be undone.`}
+              className="rounded-lg border border-ember-200 px-4 py-2 text-sm font-semibold text-ember-600 hover:bg-ember-50"
+            >
+              Delete
+            </ConfirmSubmit>
+          </form>
+        </div>
+      </Card>
+    </>
+  );
+}

@@ -0,0 +1,196 @@
+import Link from "next/link";
+import { listExpenses, expenseMonths, moneyFor, isAutomatic } from "@/lib/services/expenses";
+import { createExpenseAction } from "@/lib/admin/module-actions";
+import { PageHeading, Card, StatCard, money } from "@/components/admin/ui";
+import { SubmitButton } from "@/components/admin/submit-button";
+import { TableFilter } from "@/components/admin/table-filter";
+import { PeriodPicker } from "@/components/admin/period-picker";
+import { Ico } from "@/components/admin/admin-icons";
+import { EXPENSE_CATEGORIES, type PayMethod } from "@/lib/db/schema";
+
+export const dynamic = "force-dynamic";
+
+const field = "w-full rounded-lg border border-zinc-200 px-3 py-2 text-sm text-zinc-800 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-100";
+const METHODS: PayMethod[] = ["Cash", "Mpesa", "Bank Transfer", "Cheque", "Card"];
+const today = () => new Date().toISOString().slice(0, 10);
+
+const monthLabel = (m: string) =>
+  m === "all"
+    ? "All time"
+    : new Date(`${m}-01T00:00:00Z`).toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
+
+export default async function ExpensesPage({
+  searchParams,
+}: {
+  searchParams: Promise<{ month?: string }>;
+}) {
+  const months = expenseMonths();
+  const { month: asked } = await searchParams;
+  // Default to the newest month that has anything in it, not to today: a gym
+  // opening this on the 1st should not be shown an empty screen.
+  const month = asked && (asked === "all" || months.includes(asked)) ? asked : months[0] ?? "all";
+
+  const period = moneyFor(month);
+  const rows = listExpenses().filter((e) => month === "all" || e.month === month);
+  const biggest = period.byCategory[0];
+
+  return (
+    <>
+      <PageHeading
+        title="Expenses"
+        subtitle="What the gym spends — rent, wages, power, repairs and the cost of collecting money"
+        action={<PeriodPicker months={months} value={month} basePath="/admin/expenses" />}
+      />
+
+      <div className="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+        <StatCard label={`Money in · ${monthLabel(month)}`} value={money(period.income)} icon="payment" tone="lime" />
+        <StatCard label="Money out" value={money(period.expense)} icon="reports" tone="ember" />
+        <StatCard
+          label={period.net >= 0 ? "Left over" : "Short by"}
+          value={money(Math.abs(period.net))}
+          icon={period.net >= 0 ? "check" : "clock"}
+          tone={period.net >= 0 ? "sky" : "amber"}
+        />
+        <StatCard label="Biggest cost" value={biggest ? biggest.category : "—"} icon="card" tone="amber" />
+      </div>
+
+      <details className="mb-6 rounded-2xl border border-zinc-200 bg-white shadow-sm">
+        <summary className="flex cursor-pointer items-center gap-2 px-5 py-4 text-sm font-semibold text-zinc-700">
+          <Ico name="plus" className="h-4 w-4 text-ember-500" /> Record an expense
+        </summary>
+        <form action={createExpenseAction} className="grid gap-4 border-t border-zinc-100 p-5 sm:grid-cols-2 lg:grid-cols-3">
+          <input type="hidden" name="month" value={month} />
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Date</span>
+            <input name="date" type="date" defaultValue={today()} className={field} />
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Amount (KSh)</span>
+            <input name="amount" type="number" min="0" step="1" required className={field} />
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Category</span>
+            <select name="category" className={field}>
+              {EXPENSE_CATEGORIES.map((c) => <option key={c}>{c}</option>)}
+            </select>
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Paid to</span>
+            <input name="payee" placeholder="Landlord, KPLC, supplier…" className={field} />
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Paid by</span>
+            <select name="method" className={field}>{METHODS.map((m) => <option key={m}>{m}</option>)}</select>
+          </label>
+          <label className="block">
+            <span className="mb-1.5 block text-sm font-medium text-zinc-600">Note</span>
+            <input name="note" placeholder="What it was for" className={field} />
+          </label>
+          <div className="flex items-end sm:col-span-2 lg:col-span-3">
+            <SubmitButton className="rounded-lg bg-ember-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-ember-600">
+              Record expense
+            </SubmitButton>
+          </div>
+        </form>
+      </details>
+
+      <div className="grid gap-6 lg:grid-cols-[1fr_320px]">
+        <Card title={`Expenses · ${monthLabel(month)}`}>
+          <TableFilter
+            placeholder="Search by category, payee or note…"
+            filters={[{ key: "cat", label: "categories", options: [...new Set(rows.map((r) => r.category))].sort() }]}
+            pageSize={15}
+          >
+            <div className="overflow-x-auto">
+              <table className="w-full text-sm">
+                <thead>
+                  <tr className="border-b border-zinc-100 text-left text-xs uppercase tracking-wide text-zinc-400">
+                    <th className="py-2.5 pr-3 font-semibold">Date</th>
+                    <th className="py-2.5 pr-3 font-semibold">Category</th>
+                    <th className="py-2.5 pr-3 font-semibold">Paid to</th>
+                    <th className="py-2.5 pr-3 text-right font-semibold">Amount</th>
+                    <th className="py-2.5 pl-3" />
+                  </tr>
+                </thead>
+                <tbody className="divide-y divide-zinc-50">
+                  {rows.map((e) => {
+                    const auto = isAutomatic(e);
+                    return (
+                      <tr
+                        key={e.id}
+                        data-row
+                        data-search={`${e.category} ${e.payee ?? ""} ${e.note ?? ""} ${e.amount}`}
+                        data-f-cat={e.category}
+                      >
+                        <td className="py-2.5 pr-3 text-zinc-500">{e.date ?? e.month}</td>
+                        <td className="py-2.5 pr-3">
+                          <span className="font-medium text-zinc-800">{e.category}</span>
+                          {auto && (
+                            <span className="ml-2 rounded-full bg-zinc-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-zinc-500">
+                              Automatic
+                            </span>
+                          )}
+                          {e.note && <p className="text-xs text-zinc-400">{e.note}</p>}
+                        </td>
+                        <td className="py-2.5 pr-3 text-zinc-500">
+                          {e.payee ?? "—"}
+                          {e.method && <span className="block text-xs text-zinc-400">{e.method}</span>}
+                        </td>
+                        <td className="py-2.5 pr-3 text-right font-semibold text-zinc-800">{money(e.amount)}</td>
+                        <td className="py-2.5 pl-3 text-right">
+                          {auto ? (
+                            <Link href="/admin/billing" className="text-xs font-semibold text-zinc-400 hover:text-ember-600">
+                              Service fees →
+                            </Link>
+                          ) : (
+                            <Link href={`/admin/expenses/${e.id}?month=${month}`} className="text-xs font-semibold text-ember-600 hover:underline">
+                              Edit
+                            </Link>
+                          )}
+                        </td>
+                      </tr>
+                    );
+                  })}
+                </tbody>
+              </table>
+              <p data-empty className={`py-10 text-center text-sm text-zinc-400 ${rows.length ? "hidden" : ""}`}>
+                Nothing recorded for {monthLabel(month)} yet.
+              </p>
+            </div>
+          </TableFilter>
+        </Card>
+
+        <Card title="Where it went">
+          {period.byCategory.length === 0 ? (
+            <p className="py-6 text-center text-sm text-zinc-400">No spending recorded.</p>
+          ) : (
+            <ul className="space-y-3">
+              {period.byCategory.map((c) => {
+                const pct = period.expense > 0 ? Math.round((c.amount / period.expense) * 100) : 0;
+                return (
+                  <li key={c.category}>
+                    <div className="flex items-baseline justify-between text-sm">
+                      <span className="text-zinc-700">{c.category}</span>
+                      <span className="font-semibold text-zinc-800">{money(c.amount)}</span>
+                    </div>
+                    <div className="mt-1 h-1.5 overflow-hidden rounded-full bg-zinc-100">
+                      <div className="h-full rounded-full bg-ember-500" style={{ width: `${pct}%` }} />
+                    </div>
+                    <span className="text-xs text-zinc-400">{pct}% of spending</span>
+                  </li>
+                );
+              })}
+            </ul>
+          )}
+          <p className="mt-5 border-t border-zinc-100 pt-4 text-xs text-zinc-400">
+            {/* Explicit, because the space after </b> is swallowed here and
+                the sentence renders as "Automaticare". */}
+            Rows marked <b>Automatic</b>{" "}are service charges the system booked when they were
+            settled. They are counted here but belong to the charge — undo it under Payments
+            &amp; Billing to take one back.
+          </p>
+        </Card>
+      </div>
+    </>
+  );
+}

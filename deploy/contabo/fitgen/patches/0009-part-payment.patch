diff --git a/src/components/portal/pay-amount.tsx b/src/components/portal/pay-amount.tsx
new file mode 100644
index 0000000..a6c42a6
--- /dev/null
+++ b/src/components/portal/pay-amount.tsx
@@ -0,0 +1,117 @@
+"use client";
+
+import { useState } from "react";
+import { SubmitButton } from "@/components/admin/submit-button";
+
+/* ==========================================================================
+   Pay the lot, or pay some of it.
+
+   Two things this screen has to be honest about, because getting either wrong
+   is how a member ends up standing at the door arguing:
+
+   · Membership starts when the invoice is CLEAR, not when the first
+     instalment lands. So the running total and the words both say what is
+     still owed, before the money leaves their phone — not after.
+   · The figure typed here is a request, not an instruction. The server
+     re-decides it; min/max below are there to stop an honest mistake, not to
+     enforce anything.
+
+   Paying in full stays the default and the prominent button: part payment is
+   for people who would otherwise close the tab, not the path of least
+   resistance for people who can pay today.
+   ========================================================================== */
+
+const money = (n: number) => `KSh ${n.toLocaleString()}`;
+
+export function PayAmount({
+  action,
+  invoiceId,
+  balance,
+  allowPart,
+  min,
+}: {
+  /** The server action. Passed in so the action itself stays server-side. */
+  action: (formData: FormData) => void | Promise<void>;
+  invoiceId: string;
+  balance: number;
+  allowPart: boolean;
+  /** Smallest instalment the gym accepts. */
+  min: number;
+}) {
+  const [mode, setMode] = useState<"full" | "part">("full");
+  const [amount, setAmount] = useState(() => String(Math.min(Math.max(min, Math.round(balance / 2)), balance)));
+
+  const asked = mode === "full" ? balance : Math.floor(Number(amount));
+  const valid = Number.isFinite(asked) && asked >= (mode === "full" ? 1 : min) && asked <= balance;
+  const after = valid ? balance - asked : balance;
+
+  return (
+    <form action={action}>
+      <input type="hidden" name="invoiceId" value={invoiceId} />
+      <input type="hidden" name="mode" value={mode} />
+
+      <h3 className="font-display text-lg text-white">Pay {money(balance)}</h3>
+      <p className="mt-1 text-sm text-white/55">
+        Pay with M-Pesa. Your membership activates the moment the invoice is cleared.
+      </p>
+
+      {allowPart && (
+        <>
+          <div className="mt-5 grid grid-cols-2 gap-2 rounded-2xl border border-white/10 bg-ink-900 p-1.5">
+            <Choice on={mode === "full"} onClick={() => setMode("full")} label="Pay in full" sub={money(balance)} />
+            <Choice on={mode === "part"} onClick={() => setMode("part")} label="Pay part of it" sub={`From ${money(min)}`} />
+          </div>
+
+          {mode === "part" && (
+            <label className="mt-4 block">
+              <span className="mb-1.5 block text-xs font-semibold uppercase tracking-[0.08em] text-white/45">
+                How much are you sending now?
+              </span>
+              <div className="flex items-center gap-2 rounded-xl border border-white/12 bg-ink-900 px-3 focus-within:border-lime-500/50">
+                <span className="text-sm text-white/40">KSh</span>
+                <input
+                  name="amount"
+                  type="number"
+                  inputMode="numeric"
+                  min={min}
+                  max={balance}
+                  step={1}
+                  value={amount}
+                  onChange={(e) => setAmount(e.target.value)}
+                  className="w-full bg-transparent py-3 text-base font-semibold text-white outline-none"
+                />
+              </div>
+              <span className={`mt-2 block text-xs ${valid ? "text-white/45" : "text-ember-400"}`}>
+                {valid
+                  ? after > 0
+                    ? `${money(after)} left after this — your membership starts once that is paid too.`
+                    : "That clears the invoice — your membership activates straight away."
+                  : `Enter between ${money(min)} and ${money(balance)}.`}
+              </span>
+            </label>
+          )}
+        </>
+      )}
+
+      <SubmitButton className="btn-sheen mt-5 w-full rounded-full bg-lime-500 py-3 text-sm font-semibold uppercase tracking-wide text-ink-900 hover:bg-lime-400">
+        {mode === "full" || !valid ? "Pay with M-Pesa" : `Send ${money(asked)} prompt`}
+      </SubmitButton>
+    </form>
+  );
+}
+
+function Choice({ on, onClick, label, sub }: { on: boolean; onClick: () => void; label: string; sub: string }) {
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      aria-pressed={on}
+      className={`rounded-xl px-3 py-2.5 text-left transition-colors ${
+        on ? "bg-lime-500/15 ring-1 ring-lime-500/45" : "hover:bg-white/5"
+      }`}
+    >
+      <span className={`block text-sm font-semibold ${on ? "text-lime-300" : "text-white/70"}`}>{label}</span>
+      <span className="block text-xs text-white/40">{sub}</span>
+    </button>
+  );
+}

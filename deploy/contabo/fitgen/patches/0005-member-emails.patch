diff --git a/src/lib/services/notify.ts b/src/lib/services/notify.ts
new file mode 100644
index 0000000..6f58721
--- /dev/null
+++ b/src/lib/services/notify.ts
@@ -0,0 +1,129 @@
+import "server-only";
+
+/* ==========================================================================
+   Member emails — the outbox. Templates live in ./email-templates.
+
+   THE OUTBOX PATTERN, AND WHY. Every state change in this app happens inside
+   saveDB(mutator), which is synchronous and unlocked. Sending from in there
+   would mean an SMTP timeout could abort a recorded payment, and a retry would
+   spend the member's patience twice. So the mutation only writes a reminder
+   row with status "queued"; sending happens here, after the transaction has
+   committed. A failed send leaves the row queued and the next tick picks it
+   up. Nothing is lost, and nothing goes twice — dedupeKey already guarantees
+   one row per event.
+
+   It also fixes something dishonest. These rows were written
+   `channel: "in-app", status: "sent"` — marked sent when nothing had been
+   sent, which is what /admin/notifications has reported all along. Now "sent"
+   means a mail server accepted it.
+   ========================================================================== */
+
+import { getDB, saveDB } from "@/lib/db/store";
+import { emailConfigured, sendEmail } from "./messaging";
+import { composeEmail, type EmailFacts } from "./email-templates";
+import { gym } from "@/lib/gym";
+import type { DB, Reminder } from "@/lib/db/schema";
+
+const todayISO = () => new Date().toISOString().slice(0, 10);
+const linkBase = () => (process.env.APP_URL || `https://${gym.domain}`).replace(/\/$/, "");
+
+/** Most one drain will send. Brevo's free tier allows 300 a day and a mailbox
+    plan rather fewer, so a first tick across a full member list must not spend
+    the quota in one go — the remainder stays queued for the next run instead
+    of failing in a heap. */
+const BATCH = 40;
+
+// One drain at a time. Two concurrent runs would both read the same queued
+// rows before either marked them sent, and members would get two of
+// everything. Single container, so an in-process flag is enough.
+const g = globalThis as unknown as { __fgdraining?: boolean };
+
+/** How a staged reminder should be recorded: queued for email when a mailer
+    exists, otherwise an in-app notice that is genuinely already delivered. */
+export function emailChannel(): { channel: Reminder["channel"]; status: Reminder["status"] } {
+  return emailConfigured() ? { channel: "email", status: "queued" } : { channel: "in-app", status: "sent" };
+}
+
+/** Gather the facts for one row from whatever it still points at. */
+function factsFor(db: DB, r: Reminder, firstName: string): EmailFacts {
+  const inv = r.invoiceId ? db.invoices.find((i) => i.id === r.invoiceId) : undefined;
+  const mem = r.membershipId ? db.memberships.find((m) => m.id === r.membershipId) : undefined;
+
+  return {
+    firstName,
+    invoiceNumber: inv?.number,
+    total: inv?.total,
+    amountPaid: inv?.amountPaid,
+    balance: inv?.balance,
+    dueDate: inv?.dueDate,
+    planName: mem?.planName,
+    startDate: mem?.startDate,
+    endDate: mem?.endDate,
+    payUrl: inv?.publicToken ? `${linkBase()}/i/${inv.publicToken}` : undefined,
+    portalUrl: `${linkBase()}/portal`,
+    title: r.title,
+    detail: r.detail,
+  };
+}
+
+/**
+ * Send every queued email reminder. Safe to call after any mutation and from
+ * the tick; returns zero quickly when there is nothing to do.
+ */
+export async function drainReminderEmails(): Promise<{ sent: number; failed: number; skipped: number }> {
+  const idle = { sent: 0, failed: 0, skipped: 0 };
+  if (!emailConfigured() || g.__fgdraining) return idle;
+
+  const db: DB = getDB();
+  const queued = db.reminders.filter((r) => r.channel === "email" && r.status === "queued").slice(0, BATCH);
+  if (queued.length === 0) return idle;
+
+  g.__fgdraining = true;
+  const sentIds: string[] = [];
+  const noAddress: string[] = [];
+  let failed = 0;
+
+  try {
+    for (const r of queued) {
+      const user = db.users.find((u) => u.id === r.memberId);
+
+      // No address to send to. Left queued it would be retried on every tick
+      // for ever, so it reverts to an in-app notice — which is the truth.
+      if (!user?.email) {
+        noAddress.push(r.id);
+        continue;
+      }
+
+      const msg = composeEmail(r.type, factsFor(db, r, user.name.split(" ")[0] ?? ""));
+      const res = await sendEmail(user.email, msg.subject, msg.text, msg.html);
+      if (res.ok) sentIds.push(r.id);
+      else failed++;
+    }
+
+    if (sentIds.length || noAddress.length) {
+      const sent = new Set(sentIds);
+      const orphan = new Set(noAddress);
+      const on = todayISO();
+      await saveDB((d) => {
+        for (const r of d.reminders) {
+          if (sent.has(r.id)) {
+            r.status = "sent";
+            r.sentAt = on;
+          } else if (orphan.has(r.id)) {
+            r.channel = "in-app";
+            r.status = "sent";
+            r.sentAt = on;
+          }
+        }
+      });
+    }
+  } finally {
+    g.__fgdraining = false;
+  }
+
+  // Worth a log line: a provider at its daily cap and a wrong password both
+  // surface only here.
+  if (failed) console.error(`[notify] ${failed} reminder email(s) failed — left queued for the next tick`);
+
+  return { sent: sentIds.length, failed, skipped: noAddress.length };
+}

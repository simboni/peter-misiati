diff --git a/src/lib/services/email-templates.ts b/src/lib/services/email-templates.ts
new file mode 100644
index 0000000..4dd8b60
--- /dev/null
+++ b/src/lib/services/email-templates.ts
@@ -0,0 +1,214 @@
+/* ==========================================================================
+   Member email templates — pure functions, no store and no "server-only".
+
+   Separate from notify.ts on purpose: these are the part worth looking at and
+   worth testing, and neither is possible if rendering one needs a database and
+   an SMTP server. Give composeEmail a reminder type and the facts, get back a
+   subject and both bodies.
+
+   HTML EMAIL IS NOT HTML. Gmail strips <style> blocks, Outlook ignores flexbox
+   and most clients drop background images, so everything here is inline styles
+   on tables. Dark by design, matching the portal, with a plain-text twin that
+   carries the same facts for clients that refuse HTML outright.
+   ========================================================================== */
+
+import { gym } from "@/lib/gym";
+import type { ReminderType } from "@/lib/db/schema";
+
+const money = (n: number) => `KSh ${n.toLocaleString()}`;
+
+const INK = "#0b0b0b", CARD = "#12100f", LINE = "#262626";
+const LIME = "#a3e635", EMBER = "#ef4444", AMBER = "#f59e0b";
+const BODY = "#c9c9c9", MUTED = "#8a8a8a";
+
+/** Everything a message needs. Any field may be missing — a reminder row can
+    outlive the invoice it referred to, and a blank row beats a crash. */
+export type EmailFacts = {
+  firstName?: string;
+  invoiceNumber?: string;
+  total?: number;
+  amountPaid?: number;
+  balance?: number;
+  dueDate?: string;
+  planName?: string;
+  startDate?: string;
+  endDate?: string;
+  /** Public invoice link, `${APP_URL}/i/${publicToken}`. */
+  payUrl?: string;
+  /** Portal base, `${APP_URL}/portal`. */
+  portalUrl?: string;
+  /** Used only by the fallback, for a type with no template of its own. */
+  title?: string;
+  detail?: string;
+};
+
+type Block = {
+  accent: string;
+  heading: string;
+  lead: string;
+  rows: [string, string][];
+  cta?: { label: string; href: string };
+};
+
+const esc = (s: string) =>
+  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+export function renderHtml(b: Block): string {
+  const rows = b.rows
+    .map(
+      ([k, v]) =>
+        `<tr><td style="padding:7px 0;font-size:13px;color:${MUTED};">${esc(k)}</td>` +
+        `<td style="padding:7px 0;font-size:13px;color:#ffffff;text-align:right;font-weight:bold;">${esc(v)}</td></tr>`,
+    )
+    .join("");
+
+  const cta = b.cta
+    ? `<tr><td style="padding:18px 28px 6px;">
+      <a href="${esc(b.cta.href)}" style="display:inline-block;background:${b.accent};color:${INK};text-decoration:none;font-weight:bold;font-size:14px;padding:13px 24px;border-radius:999px;">${esc(b.cta.label)}</a>
+    </td></tr>
+    <tr><td style="padding:10px 28px 4px;">
+      <p style="margin:0;font-size:12px;line-height:1.6;color:${MUTED};">Or paste this into your browser:<br><a href="${esc(b.cta.href)}" style="color:${b.accent};word-break:break-all;">${esc(b.cta.href)}</a></p>
+    </td></tr>`
+    : "";
+
+  return `<!doctype html><html><body style="margin:0;background:${INK};padding:24px;font-family:Arial,Helvetica,sans-serif;">
+  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;margin:0 auto;background:${CARD};border:1px solid ${LINE};border-radius:16px;overflow:hidden;">
+    <tr><td style="height:4px;background:linear-gradient(90deg,${b.accent},${EMBER});"></td></tr>
+    <tr><td style="padding:28px 28px 6px;">
+      <div style="font-size:13px;font-weight:bold;letter-spacing:2px;color:${b.accent};text-transform:uppercase;">${esc(gym.name)}</div>
+      <h1 style="margin:14px 0 0;font-size:22px;color:#ffffff;">${esc(b.heading)}</h1>
+      <p style="margin:10px 0 0;font-size:14px;line-height:1.6;color:${BODY};">${esc(b.lead)}</p>
+    </td></tr>
+    ${rows ? `<tr><td style="padding:14px 28px 4px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid ${LINE};">${rows}</table></td></tr>` : ""}
+    ${cta}
+    <tr><td style="padding:18px 28px 26px;border-top:1px solid ${LINE};">
+      <p style="margin:0;font-size:12px;line-height:1.6;color:#7a7a7a;">${esc(gym.name)} · ${esc(gym.contact.phones[0])}<br>${esc(gym.contact.addressLines[0])}, ${esc(gym.contact.addressLines[2])}</p>
+    </td></tr>
+  </table>
+</body></html>`;
+}
+
+export function renderText(b: Block): string {
+  return [
+    b.heading,
+    "",
+    b.lead,
+    "",
+    ...b.rows.map(([k, v]) => `${k}: ${v}`),
+    ...(b.cta ? ["", b.cta.label + ":", b.cta.href] : []),
+    "",
+    `— ${gym.name}, ${gym.contact.phones[0]}`,
+  ].join("\n");
+}
+
+/** Subject + both bodies for one notification. */
+export function composeEmail(
+  type: ReminderType,
+  f: EmailFacts,
+): { subject: string; text: string; html: string } {
+  const dash = "—";
+  let subject: string;
+  let b: Block;
+
+  switch (type) {
+    case "invoice":
+      subject = `Invoice ${f.invoiceNumber ?? ""} · ${money(f.total ?? 0)}`.replace("  ", " ");
+      b = {
+        accent: LIME,
+        heading: "Your invoice is ready",
+        lead: `Pay by M-Pesa to activate your ${f.planName ?? "membership"}.`,
+        rows: [
+          ["Invoice", f.invoiceNumber ?? dash],
+          ["Amount", money(f.total ?? 0)],
+          ["Due", f.dueDate ?? dash],
+        ],
+        ...(f.payUrl ? { cta: { label: "Pay now", href: f.payUrl } } : {}),
+      };
+      break;
+
+    case "receipt": {
+      const owing = (f.balance ?? 0) > 0;
+      subject = `Payment received · ${f.invoiceNumber ?? gym.shortName}`;
+      b = {
+        accent: LIME,
+        heading: "Payment received",
+        lead: owing
+          ? "Thank you. A balance remains on this invoice."
+          : "Thank you — this invoice is settled in full.",
+        rows: [
+          ["Invoice", f.invoiceNumber ?? dash],
+          ["Paid", money(f.amountPaid ?? 0)],
+          ["Balance", money(f.balance ?? 0)],
+        ],
+        ...(owing && f.payUrl ? { cta: { label: "Pay the balance", href: f.payUrl } } : {}),
+      };
+      break;
+    }
+
+    case "welcome":
+      subject = `You're active · ${f.planName ?? gym.shortName}`;
+      b = {
+        accent: LIME,
+        heading: "Your membership is active",
+        lead: `Welcome${f.firstName ? ", " + f.firstName : ""}. Just give your name at the front desk.`,
+        rows: [
+          ["Plan", f.planName ?? dash],
+          ["Starts", f.startDate ?? dash],
+          ["Runs until", f.endDate ?? dash],
+        ],
+        ...(f.portalUrl ? { cta: { label: "Open your portal", href: f.portalUrl } } : {}),
+      };
+      break;
+
+    case "expiring":
+      subject = `${f.planName ?? "Your membership"} expires ${f.endDate ?? "soon"}`;
+      b = {
+        accent: AMBER,
+        heading: "Time to renew",
+        lead: "Renew before the end date and your access carries on uninterrupted.",
+        rows: [
+          ["Plan", f.planName ?? dash],
+          ["Expires", f.endDate ?? dash],
+        ],
+        ...(f.portalUrl ? { cta: { label: "Renew", href: f.portalUrl + "/plans" } } : {}),
+      };
+      break;
+
+    case "expired":
+      subject = `${f.planName ?? "Your membership"} has expired`;
+      b = {
+        accent: EMBER,
+        heading: "Your membership has expired",
+        lead: "Renew to pick up where you left off — your history and plans are still here.",
+        rows: [
+          ["Plan", f.planName ?? dash],
+          ["Expired", f.endDate ?? dash],
+        ],
+        ...(f.portalUrl ? { cta: { label: "Renew", href: f.portalUrl + "/plans" } } : {}),
+      };
+      break;
+
+    case "overdue":
+      subject = `Invoice ${f.invoiceNumber ?? ""} is past due`.replace("  ", " ");
+      b = {
+        accent: EMBER,
+        heading: "Invoice past due",
+        lead: "Settle this to keep your membership active. Already paid? Reply and we will check.",
+        rows: [
+          ["Invoice", f.invoiceNumber ?? dash],
+          ["Outstanding", money(f.balance ?? 0)],
+          ["Was due", f.dueDate ?? dash],
+        ],
+        ...(f.payUrl ? { cta: { label: "Pay now", href: f.payUrl } } : {}),
+      };
+      break;
+
+    default:
+      // A reminder type with no template of its own still has to produce a
+      // sensible email rather than an empty one.
+      subject = f.title ?? gym.name;
+      b = { accent: LIME, heading: f.title ?? gym.name, lead: f.detail ?? "", rows: [] };
+  }
+
+  return { subject, text: renderText(b), html: renderHtml(b) };
+}

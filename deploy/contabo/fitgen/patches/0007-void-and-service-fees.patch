+  revalidatePath("/admin/reports");
+}
+
+export async function payServiceChargeAction(formData: FormData) {
+  await payServiceCharge(String(formData.get("chargeId") || ""), {
+    method: String(formData.get("method") || "Mpesa") as PayMethod,
+    reference: String(formData.get("reference") || ""),
+  });
+  revalidatePath("/admin/billing");
+  revalidatePath("/admin/reports");
+  redirect("/admin/billing");
+}
+
+/** Undo a mark-as-paid entered in error. */
+export async function unpayServiceChargeAction(formData: FormData) {
+  await unpayServiceCharge(String(formData.get("chargeId") || ""));
+  revalidatePath("/admin/billing");
+  revalidatePath("/admin/reports");
+  redirect("/admin/billing");
+}
+
+/** Reverse a payment taken in error. The row stays, marked Reversed, and the
+    invoice re-opens — see reversePayment for what happens to the membership. */
+export async function reversePaymentAction(formData: FormData) {
+  const paymentId = String(formData.get("paymentId") || "");
+  const invoiceId = String(formData.get("invoiceId") || "");
+  const memberId = String(formData.get("memberId") || "");
+  await reversePayment(paymentId, String(formData.get("reason") || ""));
+  revalidateAdmin();
+  if (memberId) revalidatePath(`/admin/members/${memberId}`);
+  redirect(invoiceId ? `/admin/billing/${invoiceId}` : "/admin/billing");
+}

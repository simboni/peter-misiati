diff --git a/src/lib/services/service-fees.ts b/src/lib/services/service-fees.ts
new file mode 100644
index 0000000..300997d
--- /dev/null
+++ b/src/lib/services/service-fees.ts
@@ -0,0 +1,190 @@
+import "server-only";
+
+/* ==========================================================================
+   What the gym owes to run the gym — the gateway's cut and the platform fee.
+
+   This is the one place in the system where the supplier bills the client, so
+   it is built to be checked rather than trusted:
+
+     · DERIVED, NEVER TYPED IN. An unpaid period is recomputed from the payment
+       ledger every time this runs. Nobody can nudge the figure, and reversing
+       a member's payment shrinks the fee automatically — which is the correct
+       behaviour and also the easiest one to get wrong by storing a total.
+     · THE RATES LIVE IN SETTINGS, on a screen the gym can open, not in code or
+       an env var they cannot see.
+     · EVERY ROW SHOWS ITS ARITHMETIC. `basis`, `baseAmount` and `count` are
+       stored so the admin can read "1.5% of KSh 48,000 over 12 payments"
+       rather than being handed a number.
+     · A PAID PERIOD IS FROZEN. Recomputation skips it. A bill that has been
+       settled must never move afterwards, even if a later correction changes
+       the month it came from — that is a credit note conversation, not a
+       silent edit.
+
+   Charges accrue against the month a payment was RECEIVED, so a reversal in
+   November does not quietly alter an October bill that is already paid.
+   ========================================================================== */
+
+import { getDB, saveDB, uid } from "@/lib/db/store";
+import { getSettings } from "./settings";
+import { GYM_ID, type DB, type PayMethod, type ServiceCharge, type ServiceChargeKind } from "@/lib/db/schema";
+
+const todayISO = () => new Date().toISOString().slice(0, 10);
+const thisMonth = () => todayISO().slice(0, 7);
+const money = (n: number) => `KSh ${Math.round(n).toLocaleString()}`;
+const pct = (n: number) => `${n}%`;
+
+/** Gateway fees apply only to money that actually moved through the gateway.
+    Cash handed over at the desk costs PayHero nothing and must not be billed. */
+const GATEWAY_METHODS: PayMethod[] = ["Mpesa", "Card"];
+
+export type ServiceChargeView = ServiceCharge & { label: string };
+
+const LABELS: Record<ServiceChargeKind, string> = {
+  gateway: "Payment gateway (PayHero)",
+  platform: "Platform & support",
+};
+
+export function listServiceCharges(): ServiceChargeView[] {
+  return (getDB().serviceCharges ?? [])
+    .slice()
+    .sort((a, b) => (b.period + b.kind).localeCompare(a.period + a.kind))
+    .map((c) => ({ ...c, label: LABELS[c.kind] }));
+}
+
+export function serviceChargeTotals() {
+  const all = getDB().serviceCharges ?? [];
+  return {
+    due: all.filter((c) => c.status === "due").reduce((s, c) => s + c.amount, 0),
+    paid: all.filter((c) => c.status === "paid").reduce((s, c) => s + c.amount, 0),
+  };
+}
+
+/** The months that have live payments, plus the current one so a new month
+    shows a zero-ish platform fee rather than nothing at all. */
+function periodsToCompute(db: DB): string[] {
+  const months = new Set<string>([thisMonth()]);
+  for (const p of db.payments) if (p.status !== "Reversed") months.add(p.date.slice(0, 7));
+  return [...months];
+}
+
+/**
+ * Recompute every unpaid period from the ledger. Idempotent: run it on every
+ * tick, after a payment, after a reversal, or from the admin button.
+ */
+export async function accrueServiceCharges(): Promise<{ periods: number; due: number }> {
+  const s = getSettings();
+  let due = 0;
+  let periods = 0;
+
+  await saveDB((db) => {
+    if (!Array.isArray(db.serviceCharges)) db.serviceCharges = [];
+    const on = todayISO();
+
+    for (const period of periodsToCompute(db)) {
+      periods++;
+      const live = db.payments.filter((p) => p.status !== "Reversed" && p.date.startsWith(period));
+      const gatewayPays = live.filter((p) => GATEWAY_METHODS.includes(p.method));
+
+      const collected = live.reduce((t, p) => t + p.amount, 0);
+      const throughGateway = gatewayPays.reduce((t, p) => t + p.amount, 0);
+
+      const rows: { kind: ServiceChargeKind; amount: number; basis: string; base: number; count: number }[] = [
+        {
+          kind: "gateway",
+          amount: (throughGateway * s.gatewayFeePercent) / 100 + gatewayPays.length * s.gatewayFeeFlat,
+          base: throughGateway,
+          count: gatewayPays.length,
+          basis:
+            `${pct(s.gatewayFeePercent)} of ${money(throughGateway)}` +
+            (s.gatewayFeeFlat > 0 ? ` + ${money(s.gatewayFeeFlat)} × ${gatewayPays.length}` : "") +
+            ` · M-Pesa and card only`,
+        },
+        {
+          kind: "platform",
+          amount: (collected * s.platformFeePercent) / 100 + s.platformFeeMonthly,
+          base: collected,
+          count: live.length,
+          basis:
+            (s.platformFeePercent > 0 ? `${pct(s.platformFeePercent)} of ${money(collected)}` : "") +
+            (s.platformFeePercent > 0 && s.platformFeeMonthly > 0 ? " + " : "") +
+            (s.platformFeeMonthly > 0 ? `${money(s.platformFeeMonthly)} monthly` : "") || "No platform fee set",
+        },
+      ];
+
+      for (const r of rows) {
+        const existing = db.serviceCharges.find((c) => c.period === period && c.kind === r.kind);
+
+        // Settled bills are history. Leave them exactly as they were agreed.
+        if (existing?.status === "paid") continue;
+
+        const amount = Math.round(r.amount);
+
+        // Nothing owed and nothing recorded — do not create an empty row.
+        if (!existing && amount <= 0) continue;
+
+        if (existing) {
+          existing.amount = amount;
+          existing.basis = r.basis;
+          existing.baseAmount = r.base;
+          existing.count = r.count;
+          existing.computedAt = on;
+        } else {
+          db.serviceCharges.push({
+            id: uid("SVC"), gymId: GYM_ID, period, kind: r.kind, basis: r.basis,
+            baseAmount: r.base, count: r.count, amount, status: "due", computedAt: on,
+          });
+        }
+        if (amount > 0) due += amount;
+      }
+    }
+  });
+
+  return { periods, due };
+}
+
+/**
+ * Mark a service charge settled, and book it as an expense so the gym's own
+ * profit figures include what it costs to collect money. Freezes the row
+ * against further recomputation.
+ */
+export async function payServiceCharge(
+  id: string,
+  input: { method: PayMethod; reference?: string },
+): Promise<void> {
+  await saveDB((db) => {
+    const c = (db.serviceCharges ?? []).find((x) => x.id === id);
+    if (!c || c.status === "paid") return;
+
+    c.status = "paid";
+    c.paidAt = todayISO();
+    c.paidMethod = input.method;
+    if (input.reference?.trim()) c.paidRef = input.reference.trim();
+
+    // Booked against the month the charge belongs to, not the month it was
+    // settled, so a late payment does not distort the next month's margin.
+    db.expenses.push({
+      id: uid("EXP"),
+      month: c.period,
+      amount: c.amount,
+      category: c.kind === "gateway" ? "Gateway fees" : "Platform & support",
+    });
+  });
+}
+
+/** Undo a mark-as-paid entered by mistake. The expense row goes with it, and
+    the period becomes recomputable again. */
+export async function unpayServiceCharge(id: string): Promise<void> {
+  await saveDB((db) => {
+    const c = (db.serviceCharges ?? []).find((x) => x.id === id);
+    if (!c || c.status !== "paid") return;
+
+    const category = c.kind === "gateway" ? "Gateway fees" : "Platform & support";
+    const i = db.expenses.findIndex((e) => e.month === c.period && e.amount === c.amount && e.category === category);
+    if (i >= 0) db.expenses.splice(i, 1);
+
+    c.status = "due";
+    c.paidAt = undefined;
+    c.paidMethod = undefined;
+    c.paidRef = undefined;
+  });
+}
